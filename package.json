{
  "name": "the-sixtieth-signal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "browser-sync start --config bs-config.cjs",
    "dev:netlify": "netlify dev",
    "dev:gateway": "browser-sync start --config bs-gateway-config.cjs",
    "deploy": "netlify deploy --prod",
    "audio:prepare": "node scripts/prepare-audiobook.mjs",
    "audio:signals": "node scripts/prepare-signal-layer.mjs",
    "audio:route:chapter1": "node scripts/extract-dialogue-routing.mjs --chapter=1",
    "audio:route": "node scripts/extract-dialogue-routing.mjs --all",
    "audio:review": "browser-sync start --config bs-routing-config.cjs",
    "audio:validate-routing": "node scripts/validate-routing-decisions.mjs",
    "audio:build-fullcast-plan": "node scripts/build-fullcast-render-plan.mjs",
    "audio:auditions": "node scripts/generate-cast-auditions.mjs",
    "audio:auditions:dry-run": "node scripts/generate-cast-auditions.mjs --dry-run",
    "audio:test-routing": "node --test tests/routing-validator.test.mjs",
    "audio:audit-readiness": "node scripts/audit-audio-readiness.mjs --report-only",
    "audio:audit-completion": "node scripts/audit-audiobook-completion.mjs",
    "podcast:validate": "node scripts/validate-podcast-season.mjs",
    "audio:plan": "node scripts/generate-elevenlabs.mjs --dry-run"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4"
  }
}
