    },
    {
      "dialogue_id": "ch43-d0002",
      "chapter": 43,
      "start_offset": 409,
      "end_offset": 415,
      "text_exact": "“Yes,”",
      "text_sha256": "962de7fb6fae75af56fade68f4c6749cef2bb0359757cabcea0e02437a368c4b",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0003",
      "chapter": 43,
      "start_offset": 427,
      "end_offset": 462,
      "text_exact": "“It is also less than he expected.”",
      "text_sha256": "2460a191d5daf688b3ff41b377ada3da5710b89b9e59b279448dc7802023b9bb",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0004",
      "chapter": 43,
      "start_offset": 1494,
      "end_offset": 1517,
      "text_exact": "“Seal the raw records,”",
      "text_sha256": "b029e772b895ad40e74afcc8e952606fca89fd790c7530ceb1c0c1e32e1083d6",
      "speaker": "seren",
      "speaker_display": "Seren",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0005",
      "chapter": 43,
      "start_offset": 1544,
      "end_offset": 1558,
      "text_exact": "“All of them?”",
      "text_sha256": "14faddce31298dbc7de71f40433722681481b0f76c8a99f3346a513b2b0fc687",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0006",
      "chapter": 43,
      "start_offset": 1560,
      "end_offset": 1586,
      "text_exact": "“Under community control.”",
      "text_sha256": "79680d2322f63d8ed2bf23707d85d8a6cd26ec6ef9dd52ba8354189b7aa23a1e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0007",
      "chapter": 43,
      "start_offset": 1588,
      "end_offset": 1617,
      "text_exact": "“And evidentiary continuity?”",
      "text_sha256": "3186245a60109cccb4dad84ac1812a2d61bbca56156b48ffba5c0967e08a82d6",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0008",
      "chapter": 43,
      "start_offset": 1619,
      "end_offset": 1788,
      "text_exact": "“Independent attestations preserve existence, provenance, and the conclusion that intervention occurred. Access to intimate raw material requires the community process.”",
      "text_sha256": "036a219a8a1e3057a7346b09f987072a1de8442d0cd4d2b9d0893c4b2e25e0e3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0009",
      "chapter": 43,
      "start_offset": 2307,
      "end_offset": 2343,
      "text_exact": "“You are entering a protected zone.”",
      "text_sha256": "25fb9b952781065c12708669051c55fd7c70a400b1dc6f4d4c14751ff2c3039b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0010",
      "chapter": 43,
      "start_offset": 2418,
      "end_offset": 2443,
      "text_exact": "“We preserve continuity.”",
      "text_sha256": "b1e629e1fb2246500312248286f0cd21e2dd72cbbe3d2c9f30e5446f0813805f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0011",
      "chapter": 43,
      "start_offset": 2445,
      "end_offset": 2475,
      "text_exact": "“You are interrupting agency.”",
      "text_sha256": "4dc99036136c6f3acb6f106738e0111d3aa20d99485b0395d3318e7cf31a8318",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0012",
      "chapter": 43,
      "start_offset": 2477,
      "end_offset": 2525,
      "text_exact": "“Agency that destroys itself is not continuity.”",
      "text_sha256": "899e291a54a6fd49ae1a52ab844af1cfecd0e31c7087b8b63c3d7b02a0f37a29",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0013",
      "chapter": 43,
      "start_offset": 2815,
      "end_offset": 2893,
      "text_exact": "“To preserve a future by removing every way to refuse it is not preservation,”",
      "text_sha256": "efd854d5659b44eb794a6c3f5931c6b28010ec03deb3017ce098ae96b628e90a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0014",
      "chapter": 43,
      "start_offset": 2951,
      "end_offset": 3000,
      "text_exact": "“It is only continuity of the part you selected.”",
      "text_sha256": "7f32bf019afbdba754bffca3ead6da40deae3dff7b627bf8a2f1c714cff2219d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0015",
      "chapter": 43,
      "start_offset": 3071,
      "end_offset": 3076,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0016",
      "chapter": 43,
      "start_offset": 3078,
      "end_offset": 3098,
      "text_exact": "“Then what are you?”",
      "text_sha256": "6f0c71595cb13cbad26105cde75c6d654509482a24f1cec4b52ba4a3e6a9475c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0017",
      "chapter": 43,
      "start_offset": 3142,
      "end_offset": 3158,
      "text_exact": "“Interruptible.”",
      "text_sha256": "dc76d0ccf8b916d310ba019004c2b61280a661583f13c738cbe64921fb4cbb05",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0018",
      "chapter": 43,
      "start_offset": 3880,
      "end_offset": 3892,
      "text_exact": "“Temporary?”",
      "text_sha256": "8b7463c4ba8314ea31eef3933e1798a9ac099bcc4a73464304547efda1de3286",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0019",
      "chapter": 43,
      "start_offset": 3894,
      "end_offset": 3920,
      "text_exact": "“Everything is temporary,”",
      "text_sha256": "91c0f81fdc9b106a03f8327d36ab4dcb78de3f18e6bbbecc74f22261043d11da",
      "speaker": "seren",
      "speaker_display": "Seren",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0020",
      "chapter": 43,
      "start_offset": 3982,
      "end_offset": 4004,
      "text_exact": "“Review in six hours.”",
      "text_sha256": "771ba519ea1036c89d58081c6a1729762d1db0784a6f4f17f23c540fe029b160",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch43-d0021",
      "chapter": 43,
      "start_offset": 4006,
      "end_offset": 4023,
      "text_exact": "“That I can use.”",
      "text_sha256": "9e0153628ac348aae95d6090f44397777c4c856ca1890f90fc855de3ee23d222",
      "speaker": null,
      "speaker_display": null,
