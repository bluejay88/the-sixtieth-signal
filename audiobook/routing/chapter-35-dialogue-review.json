    {
      "dialogue_id": "ch35-d0004",
      "chapter": 35,
      "start_offset": 1638,
      "end_offset": 1699,
      "text_exact": "“Does the archive prove ancient gods were extraterrestrials?”",
      "text_sha256": "d02672acdef77f33b799018e6eb52e059ad5524412ac8123f261b2d5971a55fb",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0005",
      "chapter": 35,
      "start_offset": 1701,
      "end_offset": 1706,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0006",
      "chapter": 35,
      "start_offset": 1744,
      "end_offset": 1795,
      "text_exact": "“Does it prove directed modification of human DNA?”",
      "text_sha256": "2d39f65f26eb8eb192101a841ae37147f1fca7ceecbc7c17c4407a4bcde9f553",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0007",
      "chapter": 35,
      "start_offset": 1797,
      "end_offset": 1802,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0008",
      "chapter": 35,
      "start_offset": 1848,
      "end_offset": 1944,
      "text_exact": "“Does it prove a nonhuman technological intelligence operated on Earth before recorded history?”",
      "text_sha256": "4785a2b683efb7a86b9166fec028d9ab84d1aecab735a13078ec96f3e43c3710",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0009",
      "chapter": 35,
      "start_offset": 1961,
      "end_offset": 1971,
      "text_exact": "“Not yet.”",
      "text_sha256": "8ffbf8ce4f38ff3baf5e52c13f3f67a554052a62d17fadc66fc50de86d9f82df",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0010",
      "chapter": 35,
      "start_offset": 2934,
      "end_offset": 2977,
      "text_exact": "“Could be engineered terrestrial material.”",
      "text_sha256": "19e15409ff48bf63eb7e8ed0ac56e308abcca5ea5f0a23fb3e7b0715d54d7f62",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0011",
      "chapter": 35,
      "start_offset": 2979,
      "end_offset": 2985,
      "text_exact": "“Yes,”",
      "text_sha256": "962de7fb6fae75af56fade68f4c6749cef2bb0359757cabcea0e02437a368c4b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0012",
      "chapter": 35,
      "start_offset": 3013,
      "end_offset": 3036,
      "text_exact": "“Modern contamination?”",
      "text_sha256": "38fd071dd9c1675cea1710795d23eaab8107a89859673112e7a2bf0460a1270d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0013",
      "chapter": 35,
      "start_offset": 3038,
      "end_offset": 3071,
      "text_exact": "“Very difficult, not impossible.”",
      "text_sha256": "34a9ddfc64351335b92f8104b51b36f1e1ccb92f3d447aa7a1cee0ac0cc8293b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0014",
      "chapter": 35,
      "start_offset": 3073,
      "end_offset": 3095,
      "text_exact": "“Ancient engineering?”",
      "text_sha256": "2ac0b163d43a46fc8751aa5bcf88983ed831717d7deea701a3c4d4cae89427f7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0015",
      "chapter": 35,
      "start_offset": 3097,
      "end_offset": 3135,
      "text_exact": "“Also difficult, also not impossible.”",
      "text_sha256": "a7073a5fc9b36f2cefa0c1486e95bade76df820986a582fe1fc2ec8ba8271db7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0016",
      "chapter": 35,
      "start_offset": 3137,
      "end_offset": 3148,
      "text_exact": "“Nonhuman?”",
      "text_sha256": "92a6d9c15424f732246d410d78999d66dac0e6f6668e801df76233b2a5983daa",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0017",
      "chapter": 35,
      "start_offset": 3174,
      "end_offset": 3209,
      "text_exact": "“That word is doing too much work.”",
      "text_sha256": "b2bcdf8d7ed2bcbfa00aaa6247a570c4ada358a9bfa3414f67c984798cecd687",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0018",
      "chapter": 35,
      "start_offset": 3736,
      "end_offset": 3759,
      "text_exact": "“Do not call him that.”",
      "text_sha256": "d1abd47ca804ef22dd3827a9738e1f14debb3dec478e13de613ab0e9f1d2c24f",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0019",
      "chapter": 35,
      "start_offset": 3772,
      "end_offset": 3802,
      "text_exact": "“I don’t control the species.”",
      "text_sha256": "68065750b50f46c5e009d68883ed69f514712e055d5fb93984822c59ab9eb264",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0020",
      "chapter": 35,
      "start_offset": 3804,
      "end_offset": 3828,
      "text_exact": "“You have a microphone.”",
      "text_sha256": "41c8984fe0d5814f1ad951a0bf35556b355df4c83dee8cde79fdba729f4a7df7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0021",
      "chapter": 35,
      "start_offset": 3830,
      "end_offset": 3863,
      "text_exact": "“So do six billion other people.”",
      "text_sha256": "6f8f900a2f6d2125fbad5551fcfe878be9ba131d0428af2a473acc0e2d840675",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0022",
      "chapter": 35,
      "start_offset": 3865,
      "end_offset": 3886,
      "text_exact": "“Exactly my concern.”",
      "text_sha256": "36dda40bd8763ab3df282c8fef515adc9bf082109428adb147e8e331ab28c572",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0023",
      "chapter": 35,
      "start_offset": 4862,
      "end_offset": 4920,
      "text_exact": "“They managed to stand behind you from across the street.”",
      "text_sha256": "8c71aa4e75466e60d09678a8dd622b9946d90f0765ae25b5896811a4d486aaed",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0024",
      "chapter": 35,
      "start_offset": 4922,
      "end_offset": 4940,
      "text_exact": "“Academic talent.”",
      "text_sha256": "29eaab4d54acbf7a02c3a88ca8e6f9c6cfab8dcf7191a4790d3bfb00b92b2578",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0025",
      "chapter": 35,
      "start_offset": 5594,
      "end_offset": 5616,
      "text_exact": "“That is not helpful.”",
      "text_sha256": "9781e0efd96b91dc82308393487a252ce72718ec74ccd02cf19543338d2cd711",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0026",
      "chapter": 35,
      "start_offset": 5618,
      "end_offset": 5644,
      "text_exact": "“It is extremely helpful.”",
      "text_sha256": "c5c5d4e071de7b3181b64fefbace5f34adbcbaa8f3f49f2f7b29354f699c2d1c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0027",
      "chapter": 35,
      "start_offset": 5646,
      "end_offset": 5667,
      "text_exact": "“Should I step back?”",
      "text_sha256": "43c7ed30d84b4a32aeacd2760336ad0084f1f3bf2c18801ff8986e1a2dcb3fbb",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0028",
      "chapter": 35,
      "start_offset": 5669,
      "end_offset": 5681,
      "text_exact": "“From what?”",
      "text_sha256": "1f2f9c6e16b2b294461251939a37d92f6b5a0967496706d50caa52cf6a02d229",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0029",
      "chapter": 35,
      "start_offset": 5683,
      "end_offset": 5704,
      "text_exact": "“The interpretation.”",
      "text_sha256": "1c74a28de1c81ce5d5832f21a3804cdb7040abb66f9fc3e9b6dda24b0990f747",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0030",
      "chapter": 35,
      "start_offset": 5706,
      "end_offset": 5719,
      "text_exact": "“Some of it.”",
      "text_sha256": "3c00bfe951d41ce3528a9917a19acc1caf29f4a3db6efb8ca3e2fd2e3836e137",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0031",
      "chapter": 35,
      "start_offset": 5755,
      "end_offset": 5839,
      "text_exact": "“You should not be primary validator of claims whose methodology you helped design.”",
      "text_sha256": "03d99e2ee69a9ed0d73dd3a65dc80cbb29f1a4b7fc4af444dc631badef1e5de3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0032",
      "chapter": 35,
      "start_offset": 5841,
      "end_offset": 5850,
      "text_exact": "“I know.”",
      "text_sha256": "540cab585b96a8e3879a7e48586ea900f82bb5fcca7667332c2d7cca3f3fde2a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0033",
      "chapter": 35,
      "start_offset": 5852,
      "end_offset": 5883,
      "text_exact": "“So appoint independent teams.”",
      "text_sha256": "50cd9da0120d773b1f436a9e7040be996ab1099825b3553f860a857326e29217",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0034",
      "chapter": 35,
      "start_offset": 5885,
      "end_offset": 5895,
      "text_exact": "“We have.”",
      "text_sha256": "3966d7ecffdb80c412ce7ddee7b550198ad3c3655edcdaf5f146fdb8483d1ccb",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0035",
      "chapter": 35,
      "start_offset": 5897,
      "end_offset": 5924,
      "text_exact": "“Then what are you asking?”",
      "text_sha256": "39ca6edf698179a078b67c76c35fc4ab051a2a71896c8d733a75d9d9bd04b59a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0036",
      "chapter": 35,
      "start_offset": 5938,
      "end_offset": 5965,
      "text_exact": "“Whether I am compromised.”",
      "text_sha256": "19f44ae36b9a35ea518d1b7f69046c6be78afe7637df11dac074873954c4c283",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0037",
      "chapter": 35,
      "start_offset": 5967,
      "end_offset": 5987,
      "text_exact": "“Of course you are.”",
      "text_sha256": "6d97b517fd4b317735ed2a07d732c91bfdb33bf5b01739d4e77fb84a6ea351f9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0038",
      "chapter": 35,
      "start_offset": 6013,
      "end_offset": 6064,
      "text_exact": "“Everyone keeps saying that like it is comforting.”",
      "text_sha256": "7adb19759424d1fdb89f641915b6d808643b5f5d6b382b7fe91210e4c038a444",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0039",
      "chapter": 35,
      "start_offset": 6066,
      "end_offset": 6081,
      "text_exact": "“It should be.”",
      "text_sha256": "bf57ff17a1b178a9d5c7943abbdeac47a3f28ec9af1d4aabe082fb139603f6ad",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0040",
      "chapter": 35,
      "start_offset": 6083,
      "end_offset": 6089,
      "text_exact": "“Why?”",
      "text_sha256": "6dc7823405b2c9acf1f403a64d9e17ac6bd8d83d609524bdfd391bdafd006205",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0041",
      "chapter": 35,
      "start_offset": 6091,
      "end_offset": 6128,
      "text_exact": "“Because compromised is not useless.”",
      "text_sha256": "f16e6272a81cfb355a92baefa614522b07e820230a5ba6b8c3ab6aa8c00fc2b5",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0042",
      "chapter": 35,
      "start_offset": 6156,
      "end_offset": 6254,
      "text_exact": "“You have relationships now. Stakes. History. That means you need structure around your judgment.”",
      "text_sha256": "d9b5f97790af19ad9ecc499cd9a1ec8276d6f245a1c22bd1f04a03712855c157",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0043",
      "chapter": 35,
      "start_offset": 6320,
      "end_offset": 6340,
      "text_exact": "“Do you believe me?”",
      "text_sha256": "b28936e4f1639e7f8f69a6de6ecfb190daf024d9481b66f4f065ecf3ac399cf3",
      "speaker": "vaziri",
      "speaker_display": "Vaziri",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0044",
      "chapter": 35,
      "start_offset": 6357,
      "end_offset": 6370,
      "text_exact": "“About what?”",
      "text_sha256": "fe0ae7473c3041946213b7fbdfa53d8dffb8e69a21715e9c1db2216131b4059e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0045",
      "chapter": 35,
      "start_offset": 6372,
      "end_offset": 6386,
      "text_exact": "“The archive.”",
      "text_sha256": "62c255080c6cb9d26e642cee687bc9f838197bf6f7a0e2a5fbf1f30e274c50b5",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0046",
      "chapter": 35,
      "start_offset": 6401,
      "end_offset": 6407,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0047",
      "chapter": 35,
      "start_offset": 6446,
      "end_offset": 6470,
      "text_exact": "“Then your job changed.”",
      "text_sha256": "b7e614d9dfee2334558d9ee75b037106721e8254a89f5b5b1469e645823dd0c4",
      "speaker": "vaziri",
      "speaker_display": "Vaziri",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0048",
      "chapter": 35,
      "start_offset": 6472,
      "end_offset": 6482,
      "text_exact": "“To what?”",
      "text_sha256": "5037e7ae58752217854d2ec0cda30dba54d95b17c537c5e0f11dbbb0593cb6a9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0049",
      "chapter": 35,
      "start_offset": 6484,
      "end_offset": 6572,
      "text_exact": "“From preventing belief without evidence to preventing belief from outrunning evidence.”",
      "text_sha256": "e28cb9b0e3d68d72ac2a879985a2c60e11ee1b8e3c7e08688dc779b10fd68aa5",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0050",
      "chapter": 35,
      "start_offset": 6927,
      "end_offset": 6950,
      "text_exact": "“Were the gods aliens?”",
      "text_sha256": "7df59cf09f89b197316c4ed2c75c5d6e4e4b3dcf909f414ba5ac3045692f5371",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0051",
      "chapter": 35,
      "start_offset": 6969,
      "end_offset": 7046,
      "text_exact": "“That sentence contains two undefined terms and one unsupported equivalence.”",
      "text_sha256": "66ceeec45674ec7a1b550673c0456aef8252c374e1452565c4a17cf9288ec0a6",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0052",
      "chapter": 35,
      "start_offset": 7625,
      "end_offset": 7630,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0053",
      "chapter": 35,
      "start_offset": 7645,
      "end_offset": 7677,
      "text_exact": "“But you still needed evidence.”",
      "text_sha256": "61b39eb101b778f8cb837657405a371ee66b291206296d0121b06e7d93c0f916",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0054",
      "chapter": 35,
      "start_offset": 7955,
      "end_offset": 7967,
      "text_exact": "“Should we?”",
      "text_sha256": "32df08bb9a0cc93f25cbb15758f1cc77309386af60258f8141635b3918a0cadf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0055",
      "chapter": 35,
      "start_offset": 8183,
      "end_offset": 8198,
      "text_exact": "“I don’t know,”",
      "text_sha256": "68fc7090404929b138622e882fbb029bb8c6f8e7832774dff9fe14a09af30a05",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0056",
      "chapter": 35,
      "start_offset": 8242,
      "end_offset": 8272,
      "text_exact": "“You’re the one who built it.”",
      "text_sha256": "f95c0de967e9f71569cde2dbe3a5fcb235b4794ba79ef3ed5bfe08a6a34c06f0",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0057",
      "chapter": 35,
      "start_offset": 8298,
      "end_offset": 8339,
      "text_exact": "“That sentence is becoming less helpful.”",
      "text_sha256": "c2c30046e32aab7e3273a5b8d91f7f3202b8f210a5fd07059a07204befee8206",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0058",
      "chapter": 35,
      "start_offset": 8900,
      "end_offset": 8947,
      "text_exact": "“My parents already disagree about everything.”",
      "text_sha256": "0bdf0089bb06fb1ca92c955a04c42101312b63e609783709e3cd02e2ffab9baf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0059",
      "chapter": 35,
      "start_offset": 8985,
      "end_offset": 9049,
      "text_exact": "“People keep acting like we all believed the same thing before.”",
      "text_sha256": "8330fc1132b361be53a6a42b75f714f68512f1def897dec119e189e326485679",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0060",
      "chapter": 35,
      "start_offset": 9640,
      "end_offset": 9702,
      "text_exact": "“That is the first time your medium has improved the project.”",
      "text_sha256": "c5d34a39798bd99c1ef1addaf3e2257f0cc2cbdd393e74aab058be996bb09e53",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0061",
      "chapter": 35,
      "start_offset": 9704,
      "end_offset": 9712,
      "text_exact": "“Cruel.”",
      "text_sha256": "af1031a03321a62ec90c5ceee81bb4f385d899ced211f69d96dbeef317078a26",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0062",
      "chapter": 35,
      "start_offset": 9714,
      "end_offset": 9725,
      "text_exact": "“Accurate.”",
      "text_sha256": "922f549dbb3332c96c7664a350e31baa932f09133351af20b21566d59cb1853f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0063",
      "chapter": 35,
      "start_offset": 9795,
      "end_offset": 9814,
      "text_exact": "“One shared truth.”",
      "text_sha256": "b261e6e26dbfc0da3d1f5518bcd40b7766d3c90cab6ba36e0261658b9baee9e8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0064",
      "chapter": 35,
      "start_offset": 9838,
      "end_offset": 9933,
      "text_exact": "“No. One truth. Singular. The fantasy that one institution gets to declare what reality means.”",
      "text_sha256": "6fb907da5bae6399d115cab8f29bb74c1de296b950b99cde07593b7079126d9a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0065",
      "chapter": 35,
      "start_offset": 10379,
      "end_offset": 10397,
      "text_exact": "“Why stewardship?”",
      "text_sha256": "978b4271c696033fa63b4b008b034ace24a986c9c13852495e2c1638830800db",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0066",
      "chapter": 35,
      "start_offset": 10411,
      "end_offset": 10473,
      "text_exact": "“Because extinction does not care about democratic symbolism.”",
      "text_sha256": "3a3f57765b64ba9ec881e82196248f261093abd05323a55e3fe6e51ae7a447ab",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0067",
      "chapter": 35,
      "start_offset": 10475,
      "end_offset": 10498,
      "text_exact": "“Democratic symbolism.”",
      "text_sha256": "49b037d9e15e295c1f60e45b5c57d60bc45f5c6668c8758047c7975d319c84f9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0068",
      "chapter": 35,
      "start_offset": 10500,
      "end_offset": 10515,
      "text_exact": "“You heard me.”",
      "text_sha256": "999ad2b04abec15380797875ff4503f304a56cec0c26994530383e1f14e31297",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0069",
      "chapter": 35,
      "start_offset": 10517,
      "end_offset": 10558,
      "text_exact": "“What if the steward becomes the threat?”",
      "text_sha256": "1393658924bcb835601debfab20ddd461acc7d4c1e598d40aa4862a6593c3897",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0070",
      "chapter": 35,
      "start_offset": 10560,
      "end_offset": 10592,
      "text_exact": "“Then build removal conditions.”",
      "text_sha256": "db40157871848747274a720b0440f68941c1ba04db67bbabc4fae3eb49292326",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0071",
      "chapter": 35,
      "start_offset": 10615,
      "end_offset": 10658,
      "text_exact": "“You just reinvented the witness protocol.”",
      "text_sha256": "c7784c306a9fcd4c2f3b3c7ca7674b46985541ac57d5d9062a3e9eec43d47859",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0072",
      "chapter": 35,
      "start_offset": 10921,
      "end_offset": 10947,
      "text_exact": "“Longevity is not wisdom.”",
      "text_sha256": "77bc9f14034992d52d3c1908f7d75afa735bd03e53b9fba0966c21d02ac7c1b8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0073",
      "chapter": 35,
      "start_offset": 10949,
      "end_offset": 10971,
      "text_exact": "“Then why trust them?”",
      "text_sha256": "7a64399a3e8c30315e1cefffcb70cbcc88a31462d4a833e266db0fae31580050",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0074",
      "chapter": 35,
      "start_offset": 10973,
      "end_offset": 11037,
      "text_exact": "“I trust evidence that they have survived problems we have not.”",
      "text_sha256": "1557bd62926abcac310421760d0a85a63b845dd18f9d4c8b3358e345db56672d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0075",
      "chapter": 35,
      "start_offset": 11061,
      "end_offset": 11081,
      "text_exact": "“That is expertise.”",
      "text_sha256": "22c92b1dbe404f5ae1f41f59e1c48108b305b3c26d70de747dc191a67f134e81",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0076",
      "chapter": 35,
      "start_offset": 11083,
      "end_offset": 11089,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch35-d0077",
      "chapter": 35,
      "start_offset": 11091,
      "end_offset": 11109,
      "text_exact": "“Not sovereignty.”",
      "text_sha256": "b2b49fc2cf27790b077a263037cbb51fe115726664660a0d76f547c22f01dc01",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    }
  ]
}
