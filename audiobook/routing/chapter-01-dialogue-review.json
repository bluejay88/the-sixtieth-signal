      "end_offset": 10933,
      "text_exact": "“Maybe.”",
      "text_sha256": "7d9b35cf3ea6b7f208e574f5f51b917aef0265b4639e8f111dd29d3bbf8fe1ab",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0045",
      "chapter": 1,
      "start_offset": 10935,
      "end_offset": 10963,
      "text_exact": "“And you are upset because?”",
      "text_sha256": "43e632c167c4a684f73169e69a8587213e4b16cff00fd613c572b8d19236c65f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0046",
      "chapter": 1,
      "start_offset": 10965,
      "end_offset": 11000,
      "text_exact": "“Because the wrong part is useful.”",
      "text_sha256": "5bcda0e085151fe124fccc7e0c815b3312df966b420ca44ee90bde870b573b13",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0047",
      "chapter": 1,
      "start_offset": 11045,
      "end_offset": 11062,
      "text_exact": "“The worst kind.”",
      "text_sha256": "c00ece7d3b8e14f18cfaa9e624d5eb77c739df09f6550b7b1a92dc54d978d9a3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0048",
      "chapter": 1,
      "start_offset": 11098,
      "end_offset": 11154,
      "text_exact": "“It is connecting food risk to something in Antarctica.”",
      "text_sha256": "96f96925b34cb5815395cbda9bf950afc28f0dea016d9d43c0bab9d429463dac",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0049",
      "chapter": 1,
      "start_offset": 11183,
      "end_offset": 11195,
      "text_exact": "“Should it?”",
      "text_sha256": "3abf0258b85ae007104a90a1b04c61b0789d0de7f32f6ded462b0e0712c0dcb5",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0050",
      "chapter": 1,
      "start_offset": 11197,
      "end_offset": 11213,
      "text_exact": "“Not like this.”",
      "text_sha256": "fb724c27cbc48aa88550d8f46aee841b9f6c2e69a7a25e2897e8598ac4ac7daa",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0051",
      "chapter": 1,
      "start_offset": 11215,
      "end_offset": 11235,
      "text_exact": "“Then find out why.”",
      "text_sha256": "d98b43f9a0b319ba7faefdcd03a40086f298881959be827a57377a40fd9b8dc9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0052",
      "chapter": 1,
      "start_offset": 11237,
      "end_offset": 11256,
      "text_exact": "“That is the plan.”",
      "text_sha256": "06dd74ed23cc41ac7d39a557ed80e44585c436dcbafaf4408435c8815cab0c32",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0053",
      "chapter": 1,
      "start_offset": 11258,
      "end_offset": 11328,
      "text_exact": "“No. Your plan is to stay in that room until the computer apologizes.”",
      "text_sha256": "735cbfd8902d7b3fea927314c0490b351ffb1fac57e1967e7582d50a6da33560",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0054",
      "chapter": 1,
      "start_offset": 11372,
      "end_offset": 11391,
      "text_exact": "“Go see the thing,”",
      "text_sha256": "554e15a6b98441ba1eb41f1a8b21cac23b3cfb676f91f24074dfb045509ffd37",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0055",
      "chapter": 1,
      "start_offset": 11403,
      "end_offset": 11430,
      "text_exact": "“There may not be a thing.”",
      "text_sha256": "d6f701c6cf4e2eaf552ac0a779b87869ce919b5e31c4576baf51eb593e048210",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0056",
      "chapter": 1,
      "start_offset": 11432,
      "end_offset": 11458,
      "text_exact": "“Then go see the nothing.”",
      "text_sha256": "eb66432cdcec788a62340a0edea5f5f8875848745b97e61edaf0e14ca12971ce",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0057",
      "chapter": 1,
      "start_offset": 12188,
      "end_offset": 12204,
      "text_exact": "“Where are you?”",
      "text_sha256": "6cd82b176cb35ce11e2a7376a018076f089075c66e79649d5f5fcf15a9e0fb28",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0058",
      "chapter": 1,
      "start_offset": 12206,
      "end_offset": 12218,
      "text_exact": "“Cafeteria.”",
      "text_sha256": "cbda37d96b7dade7f434bd20423554d78c47a89f8a4cef4f2e8ce5ee646c393b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0059",
      "chapter": 1,
      "start_offset": 12220,
      "end_offset": 12235,
      "text_exact": "“At this hour?”",
      "text_sha256": "4d1242479b9cd8f70af52de5e134d282412bb58710995bf7fb0319b295d915fc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0060",
      "chapter": 1,
      "start_offset": 12237,
      "end_offset": 12392,
      "text_exact": "“There is a twenty-four-hour cafeteria because governments discovered people make worse decisions hungry and then ignored the discovery for everyone else.”",
      "text_sha256": "225ec8daab8ee23e1ba822b34ece1d69bcb73562e33b068c6bef31733c3483a6",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0061",
      "chapter": 1,
      "start_offset": 12411,
      "end_offset": 12430,
      "text_exact": "“What do you want?”",
      "text_sha256": "5af79f76f6b5043e967383b4ebbc976dcb4f8f9efcb66196e8fca17f326061c7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0062",
      "chapter": 1,
      "start_offset": 12432,
      "end_offset": 12438,
      "text_exact": "“You.”",
      "text_sha256": "bcc5b03fe66d205a0a3332a9c2159e7d3737fcc34f96685fbe4fde220a745f7f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0063",
      "chapter": 1,
      "start_offset": 12440,
      "end_offset": 12458,
      "text_exact": "“That is ominous.”",
      "text_sha256": "e1e2ce8032eda48b0725124167bffad7749f6d75a6459945c22c63335867dab8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0064",
      "chapter": 1,
      "start_offset": 12460,
      "end_offset": 12556,
      "text_exact": "“I want to know whether you are going to put the Antarctic variable in the official model card.”",
      "text_sha256": "4e1f65c62d4879a09886988953bd38b54690ef1eed658fed31330dfe03c7d9ea",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0065",
      "chapter": 1,
      "start_offset": 12641,
      "end_offset": 12701,
      "text_exact": "“If I include it now, the meeting becomes about Antarctica.”",
      "text_sha256": "62d85a2d17b7a88580e00b4dcc724cb221040f2a8c5f60a3a7015cec08fd1db7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0066",
      "chapter": 1,
      "start_offset": 12703,
      "end_offset": 12709,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0067",
      "chapter": 1,
      "start_offset": 12711,
      "end_offset": 12754,
      "text_exact": "“If I exclude it, the forecast gets worse.”",
      "text_sha256": "a398c3716614d9b0b0b78a8e5043c82b7a4e535d97f746be354c7ab0e0bcfaae",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0068",
      "chapter": 1,
      "start_offset": 12756,
      "end_offset": 12762,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0069",
      "chapter": 1,
      "start_offset": 12839,
      "end_offset": 12878,
      "text_exact": "“You know what the minister will hear,”",
      "text_sha256": "1314a29038a56b9e8618008113a2993c9d1721b05ac103786dfa0bc0ad034733",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0070",
      "chapter": 1,
      "start_offset": 12890,
      "end_offset": 12917,
      "text_exact": "“Anomalous polar variable.”",
      "text_sha256": "a524e3913786015d36a20f74ea1d84283306a6da0fd2dee7a813d42da4ba6a09",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0071",
      "chapter": 1,
      "start_offset": 12919,
      "end_offset": 12970,
      "text_exact": "“No. He’ll hear rogue AI found secret ice problem.”",
      "text_sha256": "4c0ecb5a282ef4cce8dd2b3e4d320c578e8a767bf575aa310f477e04d4f269f4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0072",
      "chapter": 1,
      "start_offset": 12972,
      "end_offset": 13000,
      "text_exact": "“That is not what happened.”",
      "text_sha256": "105dddd5e42d5158cd54086f0e7ed150c9813c208c1a172d7343f04ffe4f17cc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0073",
      "chapter": 1,
      "start_offset": 13002,
      "end_offset": 13031,
      "text_exact": "“I know. That will not help.”",
      "text_sha256": "51d694d79fc908003fce96d3cc11d2314b178b0063fc3f9aa0eea9b8a8a3f80f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0074",
      "chapter": 1,
      "start_offset": 13074,
      "end_offset": 13094,
      "text_exact": "“What would you do?”",
      "text_sha256": "94cb8ef22069da473e6a1d0cd9ac9f5b507d145e7a1adb7aa28929758347a662",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0075",
      "chapter": 1,
      "start_offset": 13096,
      "end_offset": 13152,
      "text_exact": "“Document it. Bury the drama. Preserve the audit trail.”",
      "text_sha256": "837bc791468f51a66faa10161bd7211f613ed478b87db35853aedbc1163ad22f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0076",
      "chapter": 1,
      "start_offset": 13154,
      "end_offset": 13182,
      "text_exact": "“That sounds contradictory.”",
      "text_sha256": "9ece4427c3f8a4578903ee6dd8f6e5467eaa9ac776766bd882b532551566094b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0077",
      "chapter": 1,
      "start_offset": 13184,
      "end_offset": 13206,
      "text_exact": "“It is civil service.”",
      "text_sha256": "2581ef4b822e251108209aadec92c33c18977542e167d6df01a8141d0249b391",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0078",
      "chapter": 1,
      "start_offset": 13232,
      "end_offset": 13246,
      "text_exact": "“And Cassian?”",
      "text_sha256": "e9f16cc6148963d2055fabaab4c634a2084dea522d9e90aefecfaf49bc1934e6",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0079",
      "chapter": 1,
      "start_offset": 13248,
      "end_offset": 13254,
      "text_exact": "“Yes?”",
      "text_sha256": "b5a7a95de61928f0246521fc78ade2df50359b90d028ea4a65207ca5167f3d9a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0080",
      "chapter": 1,
      "start_offset": 13256,
      "end_offset": 13323,
      "text_exact": "“Do not clean the weirdness out because you are embarrassed by it.”",
      "text_sha256": "a16fc58a90c81a339efd85cfd64f257ec0b16c69f95fdf7cc832edfe723ce35e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0081",
      "chapter": 1,
      "start_offset": 13380,
      "end_offset": 13490,
      "text_exact": "“I have watched analysts massage inconvenient variables until the model looked sensible enough for a meeting.”",
      "text_sha256": "154edf3e45c38c173cfa4d9fb9b9f0bf485200245e1cc9625c2a184687eebec5",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0082",
      "chapter": 1,
      "start_offset": 13492,
      "end_offset": 13510,
      "text_exact": "“I don’t do that.”",
      "text_sha256": "08f5427fd704779581102f9c4d24cf3dbaa9ce332fa291d01aa34a2563b3a64d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0083",
      "chapter": 1,
      "start_offset": 13512,
      "end_offset": 13528,
      "text_exact": "“You are human.”",
      "text_sha256": "f5554c9181db1f4d34b62cdb86ce7d2d7f8fe0950347f4b6d65ddd38f95b9caa",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0084",
      "chapter": 1,
      "start_offset": 13530,
      "end_offset": 13550,
      "text_exact": "“That is offensive.”",
      "text_sha256": "e68d14e390f5481069a9f9f895855ec333c41dbb56e8cd66f527979d69070fc7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0085",
      "chapter": 1,
      "start_offset": 13552,
      "end_offset": 13574,
      "text_exact": "“It is also my point.”",
      "text_sha256": "49cd209b433dcd05715664daeb29ac27bc6ffe9f46fdaf653d3909117a6eebfe",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0086",
      "chapter": 1,
      "start_offset": 13808,
      "end_offset": 13815,
      "text_exact": "“Good.”",
      "text_sha256": "da1b98ef03728a55d7b450595409dbd3c2ad61106ccc1bd6e2bc0e2a1c59839a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch01-d0087",
      "chapter": 1,
      "start_offset": 13817,
      "end_offset": 13854,
      "text_exact": "“That sentence will cause questions.”",
      "text_sha256": "da5b4571cd2c8306edda2dab8416007f9aa4b836c0663e14a88aa911fc21b288",
      "speaker": null,
      "speaker_display": null,
