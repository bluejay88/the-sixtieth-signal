      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch50-d0013",
      "chapter": 50,
      "start_offset": 2817,
      "end_offset": 2822,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch50-d0014",
      "chapter": 50,
      "start_offset": 2824,
      "end_offset": 2879,
      "text_exact": "“Then stop being interesting near recording equipment.”",
      "text_sha256": "34ed534ecbafc77052a4e9e6c26ba64fb9109c3d74abc8ebdedbab05909a54a7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch50-d0015",
      "chapter": 50,
      "start_offset": 2901,
      "end_offset": 3113,
      "text_exact": "“If the signal contains information from a state that did not yet exist when the old residual was recorded, then either our chronology is wrong, our provenance is wrong, or our causal assumptions are incomplete.”",
      "text_sha256": "a2b1675e119c88516414428d8bbdb9796558766b174a3cec6f0e697ab1e8c8bb",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch50-d0016",
      "chapter": 50,
      "start_offset": 3115,
      "end_offset": 3148,
      "text_exact": "“That is offensively reasonable,”",
      "text_sha256": "93fbca08354d22e89b0d67846d4f276d29946a553f651c69f5bef6b5c88aece1",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch50-d0017",
      "chapter": 50,
      "start_offset": 3161,
      "end_offset": 3175,
      "text_exact": "“It's my job.”",
      "text_sha256": "4b34f42a00c4149ffaa4a3857e850df26453c87ae1b2ac800fcee553675218d6",
      "speaker": "loam",
      "speaker_display": "LOAM",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
