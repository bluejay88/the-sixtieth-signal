      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch50-d0012",
      "chapter": 50,
      "start_offset": 2775,
      "end_offset": 2815,
      "text_exact": "“That reaction is going in the episode.”",
      "text_sha256": "67c86b057e2326b58b2508b4679bdb75f18bf4be52db066c1036225b005e4e03",
      "speaker": "nico",
      "speaker_display": "Nico",
