{
  "schema_version": 1,
  "chapter": 24,
  "chapter_title": "PRESERVE ORDER",
  "chapter_sha256": "6862ec7db7c0635401b8b36c299a58e1a2d941f89fedb18c5c6412853063de0d",
  "policy": "No unresolved dialogue may fall back to narrator. render_allowed remains false until human approval.",
  "counts": {
    "dialogue_spans": 41,
    "explicit_named": 10,
    "unresolved": 31,
    "approved": 0
  },
  "spans": [
    {
      "dialogue_id": "ch24-d0001",
      "chapter": 24,
      "start_offset": 228,
      "end_offset": 264,
      "text_exact": "“That is annoyingly villain-shaped.”",
      "text_sha256": "963ba926ce97555a7fcbe25fc87a5af5a022adef999cf51590403c6262de2c67",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0002",
      "chapter": 24,
      "start_offset": 266,
      "end_offset": 300,
      "text_exact": "“It is annoyingly English-shaped,”",
      "text_sha256": "42c658c29e7c635174475dabbcc9cee5ab6d9222abbd95516c76716a32c18830",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0003",
      "chapter": 24,
      "start_offset": 417,
      "end_offset": 443,
      "text_exact": "“I prefer preserve order.”",
      "text_sha256": "f81faf4197587333dee5931605866cc8a8a7afdbb4e55ae1c977966cca338632",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0004",
      "chapter": 24,
      "start_offset": 445,
      "end_offset": 464,
      "text_exact": "“Of course you do,”",
      "text_sha256": "72360257dc14258ae41cc12190f4049f0622222e3923dff36bfffc53cb3b43ad",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0005",
      "chapter": 24,
      "start_offset": 490,
      "end_offset": 531,
      "text_exact": "“Do you have a methodological objection?”",
      "text_sha256": "5ff482000718469f903204959b8b45cacd4fc67ee055a4ca266933920329684b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0006",
      "chapter": 24,
      "start_offset": 533,
      "end_offset": 563,
      "text_exact": "“No. A personality-based one.”",
      "text_sha256": "3563ccb1867716f9cdccc77abd89d9c6936583e55c4f7eb4e182651b6ca0abab",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0007",
      "chapter": 24,
      "start_offset": 603,
      "end_offset": 714,
      "text_exact": "“Words are not decorations. 'Order' tells the reader the state is legitimate before we know what the state is.”",
      "text_sha256": "d042523f6b040c3f5debbe77fd8cf7a891c11e2428edcc3ef739257248d97334",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0008",
      "chapter": 24,
      "start_offset": 740,
      "end_offset": 817,
      "text_exact": "“And 'authorized configuration' tells them the same thing with worse rhythm.”",
      "text_sha256": "d74d2e365218f068a8ca3ca4a4164e04fbe7ef3bc1a20016edd01d65b37d33c7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0009",
      "chapter": 24,
      "start_offset": 819,
      "end_offset": 829,
      "text_exact": "“Correct.”",
      "text_sha256": "30f0060e15b500fe828e6c2105fd52a09a342369833561001c283e8246ed08c4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0010",
      "chapter": 24,
      "start_offset": 831,
      "end_offset": 836,
      "text_exact": "“So?”",
      "text_sha256": "2b2c36a401f4dc9902a66106ea44c0c59efc68d884f830308b77182e188f5261",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0011",
      "chapter": 24,
      "start_offset": 838,
      "end_offset": 883,
      "text_exact": "“So we keep all three until context selects.”",
      "text_sha256": "cf5d7b5da8275fe6db1fdbf38bfd63a5273da5250f06daac4e54456ab6c88f7f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0012",
      "chapter": 24,
      "start_offset": 1414,
      "end_offset": 1421,
      "text_exact": "“What?”",
      "text_sha256": "bf9ee250242dc9be6ae8a64cb636db6ea70186d990757358b8947787279f47cc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0013",
      "chapter": 24,
      "start_offset": 1423,
      "end_offset": 1430,
      "text_exact": "“Food.”",
      "text_sha256": "dd9092343d5e92f12071e5ac62caa541f18819ff8eaed204af71aa1f3a9e8276",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0014",
      "chapter": 24,
      "start_offset": 1717,
      "end_offset": 1772,
      "text_exact": "“You have fourteen minutes before the allocation call.”",
      "text_sha256": "067e1f7e493f4a885dcb6144d077d76d7bcd3c58b02c5f24d7e0f483b51aa28c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0015",
      "chapter": 24,
      "start_offset": 1789,
      "end_offset": 1804,
      "text_exact": "“Why fourteen?”",
      "text_sha256": "054b04b3884f1c7ecac536b24e09c269bccf0124def08bde4d8cee1eec76fcd9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0016",
      "chapter": 24,
      "start_offset": 1806,
      "end_offset": 1880,
      "text_exact": "“Because the ministers already spent twenty arguing over who gets blamed.”",
      "text_sha256": "515a2a9d22a8714b4d028fbc8ec93a21df9550aadcfc81cf26c61eee82185c78",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0017",
      "chapter": 24,
      "start_offset": 1893,
      "end_offset": 1906,
      "text_exact": "“Comforting.”",
      "text_sha256": "203120f0ba947d54e9dd93654b90f8ef238c5a5eca63954f4a432f1fc02a26f3",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0018",
      "chapter": 24,
      "start_offset": 1953,
      "end_offset": 1968,
      "text_exact": "“What is that?”",
      "text_sha256": "f4d2b4624b4a491f69ea7f741ab7c0ded4437cf65cd3d7a37f09308265b088c0",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0019",
      "chapter": 24,
      "start_offset": 1970,
      "end_offset": 2006,
      "text_exact": "“Possible alien constitutional law.”",
      "text_sha256": "70fe0855a7b24c96693ff0758073dc909b8029a068246809188b341488c26043",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0020",
      "chapter": 24,
      "start_offset": 2008,
      "end_offset": 2029,
      "text_exact": "“Fine. Hunger first.”",
      "text_sha256": "e1241736dfe2c1c17758dfc82eb94ea450bac4d258f88530b7f6c4cf3cd350d8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0021",
      "chapter": 24,
      "start_offset": 2426,
      "end_offset": 2464,
      "text_exact": "“The model says diversion is optimal.”",
      "text_sha256": "2b8364d6dac77bffccf2fa9e27cd59c50cae227583427460c9552640cadc3f61",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0022",
      "chapter": 24,
      "start_offset": 2507,
      "end_offset": 2563,
      "text_exact": "“The model says it minimizes the defined loss function.”",
      "text_sha256": "e40657df090249821e1fe2793e31a711b517824146a63035d69a3a5d65fb8b94",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0023",
      "chapter": 24,
      "start_offset": 2565,
      "end_offset": 2576,
      "text_exact": "“Which is?”",
      "text_sha256": "9afe57ea630503d6247a63c7a6c7e5e5121f8746751bfa6bd5f23ca4266bbe1e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0024",
      "chapter": 24,
      "start_offset": 2578,
      "end_offset": 2644,
      "text_exact": "“Severe health outcome, household food access, and spoilage risk.”",
      "text_sha256": "75e88e45acccc44376101b233c23178bdf4c9f99cc3aa61dd6d54a293d04efe0",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0025",
      "chapter": 24,
      "start_offset": 2646,
      "end_offset": 2659,
      "text_exact": "“So optimal.”",
      "text_sha256": "dd1a8f34642fed17b2b6a855d7db9a0d94d8d0744828d2f27144f8471b90e219",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0026",
      "chapter": 24,
      "start_offset": 2661,
      "end_offset": 2666,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0027",
      "chapter": 24,
      "start_offset": 2726,
      "end_offset": 2930,
      "text_exact": "“It does not include school attendance effects. It does not include the local kitchen network Mira flagged this morning. And this rail corridor has a labor dispute the model is treating as a fixed delay.”",
      "text_sha256": "9b5a1860fb5bf270d87e508fdf6e74c86138d8d2d696e161967654307db1d7b4",
      "speaker": "mira",
      "speaker_display": "Mira",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0028",
      "chapter": 24,
      "start_offset": 2943,
      "end_offset": 3111,
      "text_exact": "“Not fixed. Union agreed to emergency movement if the government puts the fuel guarantee in writing. Also, your backup rail route drinks from the same diesel terminal.”",
      "text_sha256": "c7f9763a4a10e379dd2d1acebafcce4cddeb768fda97ccf03b93921d0471289d",
      "speaker": "mira",
      "speaker_display": "Mira",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0029",
      "chapter": 24,
      "start_offset": 3137,
      "end_offset": 3231,
      "text_exact": "“A backup that shares the failure isn't a backup. It's a second receipt for the same problem.”",
      "text_sha256": "23a23087018b9557fb4892e71a91bb42f6cd1d0295b4ceab9f086d83c0458464",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0030",
      "chapter": 24,
      "start_offset": 3604,
      "end_offset": 3626,
      "text_exact": "“You made your point.”",
      "text_sha256": "2d8fa86b1b42cb8e52ee404507351c0575604f7a72b95ab7ffb84136f7422b73",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0031",
      "chapter": 24,
      "start_offset": 3628,
      "end_offset": 3651,
      "text_exact": "“I was not making one.”",
      "text_sha256": "aa7adf5950955ca15cd662c17d528ddd46013fa851d003d64e7bc9c763a4ced7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0032",
      "chapter": 24,
      "start_offset": 3653,
      "end_offset": 3677,
      "text_exact": "“That is why it worked.”",
      "text_sha256": "54338f92b0a0313648282e4499d5872c92a4e3df972cf981c70bd678f488fb0b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0033",
      "chapter": 24,
      "start_offset": 3720,
      "end_offset": 3741,
      "text_exact": "“Authorized by whom?”",
      "text_sha256": "0e2f0f69c8f34d5eb408ae8b3cee01c7f21c5d7d0d1eb473aec9e48dd71cbfde",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0034",
      "chapter": 24,
      "start_offset": 3823,
      "end_offset": 3906,
      "text_exact": "“That is the question we keep avoiding because the archive makes it sound ancient.”",
      "text_sha256": "872d9d167daaae02843d90af0b8b9db7f4177d2065561d6dc29758e818399298",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0035",
      "chapter": 24,
      "start_offset": 3922,
      "end_offset": 4085,
      "text_exact": "“The food model had authority to recommend. The ministers had authority to allocate. The union had authority over labor. Mira had information neither of them had.”",
      "text_sha256": "dc85d1a6276177451cf6b7d62faa7c06b7dc5e191647190fd3558a9e80460555",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0036",
      "chapter": 24,
      "start_offset": 4098,
      "end_offset": 4163,
      "text_exact": "“And the school kids had the authority to be hungry, apparently.”",
      "text_sha256": "8de1addef8a60b93547106d589ea7cefc664e627d1cda31c89c742d85e299a41",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0037",
      "chapter": 24,
      "start_offset": 4165,
      "end_offset": 4181,
      "text_exact": "“Not authority,”",
      "text_sha256": "9134ddac6813bdd532a3547e4af8a761fd4ed701dc6e8e31e30e2803fa523ac9",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0038",
      "chapter": 24,
      "start_offset": 4195,
      "end_offset": 4209,
      "text_exact": "“Consequence.”",
      "text_sha256": "63952e898dd9ee499d363d2e967349048de312a547475a9e57f48e1f9df77900",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0039",
      "chapter": 24,
      "start_offset": 4341,
      "end_offset": 4369,
      "text_exact": "“That is not a translation.”",
      "text_sha256": "15256a2ffec09c6654949e13a2813c46278f06856164275b97b589ae417ff446",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0040",
      "chapter": 24,
      "start_offset": 4376,
      "end_offset": 4389,
      "text_exact": "“What is it?”",
      "text_sha256": "c8b89bfbb71a4de5704727d71604b81e1cb44e37603b1107efbaac94b626d245",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch24-d0041",
      "chapter": 24,
      "start_offset": 4417,
      "end_offset": 4428,
      "text_exact": "“Label it.”",
      "text_sha256": "5578596d981cbb7c79f461d039961710c88db762553d85a1b6e5e9cb96b5a8b0",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    }
  ]
}
