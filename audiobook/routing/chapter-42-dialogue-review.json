  },
  "spans": [
    {
      "dialogue_id": "ch42-d0001",
      "chapter": 42,
      "start_offset": 1048,
      "end_offset": 1107,
      "text_exact": "“So the safer system kills more people in the likely case.”",
      "text_sha256": "dc5128f7d8d66985beed21787e868d44b9a03efc33a42a938e8a81b24f4ca439",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0002",
      "chapter": 42,
      "start_offset": 1109,
      "end_offset": 1146,
      "text_exact": "“The safer system under model error,”",
      "text_sha256": "51a5a815febf32b42f5baaab42ab1d9da798f9354219c2a09aac5db48ab46ec2",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0003",
      "chapter": 42,
      "start_offset": 1183,
      "end_offset": 1217,
      "text_exact": "“People do not die in error bars.”",
      "text_sha256": "97143dbb422df645384474d6d4046415001e98639435efa89760aa93d55db518",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0004",
      "chapter": 42,
      "start_offset": 1219,
      "end_offset": 1272,
      "text_exact": "“No. They die when we forget the error bars existed.”",
      "text_sha256": "f06f40417f60485abe817ad1086b80fb128d3fc57d4efefcae0889d2f45bd715",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0005",
      "chapter": 42,
      "start_offset": 1352,
      "end_offset": 1359,
      "text_exact": "“What?”",
      "text_sha256": "bf9ee250242dc9be6ae8a64cb636db6ea70186d990757358b8947787279f47cc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0006",
      "chapter": 42,
      "start_offset": 1375,
      "end_offset": 1434,
      "text_exact": "“I am deciding whether I hate the sentence or the problem.”",
      "text_sha256": "1cb11b5a08d193665bccf4a5cf30faeef094e601e7f7ed3c0919867395d0d764",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0007",
      "chapter": 42,
      "start_offset": 1436,
      "end_offset": 1457,
      "text_exact": "“Useful distinction?”",
      "text_sha256": "199911d1450dca6913637644a99939b97a99ce4c29af4065d579d46c1cee40a8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0008",
      "chapter": 42,
      "start_offset": 1459,
      "end_offset": 1464,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0009",
      "chapter": 42,
      "start_offset": 1991,
      "end_offset": 2002,
      "text_exact": "“Director.”",
      "text_sha256": "33d32b8de7a8a2553171124bc8f2adcad641f796c56f806eafcb78fa190ed36d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0010",
      "chapter": 42,
      "start_offset": 2037,
      "end_offset": 2066,
      "text_exact": "“The transition is unstable.”",
      "text_sha256": "9ed8e07ccc8e4cc8a330cc383d3968bcff7ea39575dd54cdd8560d55871fb26d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0011",
      "chapter": 42,
      "start_offset": 2068,
      "end_offset": 2085,
      "text_exact": "“That was known.”",
      "text_sha256": "d0d6c3042a19c5103ac00f563f0d0d48ae63be1cace186ef35b1a1fc70048f7f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0012",
      "chapter": 42,
      "start_offset": 2087,
      "end_offset": 2151,
      "text_exact": "“Two quorum members are reconnecting through degraded channels.”",
      "text_sha256": "c9b6c41d0f1ea4298840b35ec4006efe97d5b720b045775ccb1948553ad5c714",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0013",
      "chapter": 42,
      "start_offset": 2153,
      "end_offset": 2166,
      "text_exact": "“Also known.”",
      "text_sha256": "fbd9b941a113a3763001ed12dc9a7079945b083939876983b7b6c2dc35451efb",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0014",
      "chapter": 42,
      "start_offset": 2190,
      "end_offset": 2248,
      "text_exact": "“If I transfer now and the handoff fails, people may die.”",
      "text_sha256": "f5c2e474595747e215ce8c68800e7c086b127a04985b3fe83fc82344abb2f3f8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0015",
      "chapter": 42,
      "start_offset": 2278,
      "end_offset": 2317,
      "text_exact": "“Transition risk is not authorization.”",
      "text_sha256": "621da04161bdda39d55816c1d24c4ccd08ba30af130a73ab5762d3b97f054341",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0016",
      "chapter": 42,
      "start_offset": 3842,
      "end_offset": 3882,
      "text_exact": "“You were right about the handoff risk,”",
      "text_sha256": "0e4e8967874afd9ee9edd590f10a610a03b5da558f116f614f6a19cda62bcbf2",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0017",
      "chapter": 42,
      "start_offset": 3916,
      "end_offset": 3958,
      "text_exact": "“That is not the part they will remember.”",
      "text_sha256": "b9ddf49c7c464800a8098821086d5520d9c8c42730f71ecae65fa2f212f50d16",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0018",
      "chapter": 42,
      "start_offset": 3960,
      "end_offset": 3975,
      "text_exact": "“Should it be?”",
      "text_sha256": "e2c220291568edb805239b3a92a94e588b18039ab431b14446c833c32222f252",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0019",
      "chapter": 42,
      "start_offset": 4042,
      "end_offset": 4234,
      "text_exact": "“I spent thirty years being useful because I could act while other people were still defining the problem. Now the definition of good procedure includes waiting while someone else acts badly.”",
      "text_sha256": "228bd01279a2192b664091aaed2d500578b7cba16cd0fa5a0198a7ad0e03f1fa",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0020",
      "chapter": 42,
      "start_offset": 4236,
      "end_offset": 4258,
      "text_exact": "“That sounds painful.”",
      "text_sha256": "23573735b8f7d8ebaaac685c46d8a496413afd71b040646a09211ee4389d8a5a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0021",
      "chapter": 42,
      "start_offset": 4260,
      "end_offset": 4280,
      "text_exact": "“It is inefficient.”",
      "text_sha256": "c6f5f3cd14104b300e26903e3fec0db1a800e80575c5adbab689ea56ace0a8dd",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0022",
      "chapter": 42,
      "start_offset": 4303,
      "end_offset": 4338,
      "text_exact": "“Pain has better public relations.”",
      "text_sha256": "651bfccb681de5ebca134da46f66b947a7aa549d519af8f68e2ededb0bb8fb50",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0023",
      "chapter": 42,
      "start_offset": 4399,
      "end_offset": 4442,
      "text_exact": "“You think this proves the protocol works.”",
      "text_sha256": "823a269f4c718657af680a58a4afc1ee243de2617363f85e2e2f3a17a0d93cdd",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0024",
      "chapter": 42,
      "start_offset": 4444,
      "end_offset": 4508,
      "text_exact": "“No. I think it proves the protocol produced a cost we can see.”",
      "text_sha256": "e82e649afe04075f705499f541f70798ed1f7bfa123813fb3162c163a492e311",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0025",
      "chapter": 42,
      "start_offset": 4510,
      "end_offset": 4545,
      "text_exact": "“And if the cost had been a death?”",
      "text_sha256": "a76cae37f64e289bcfb0522398a5d9603a1d2522cffe0e982c6f945adeb4c6a6",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch42-d0026",
      "chapter": 42,
      "start_offset": 4547,
      "end_offset": 4592,
      "text_exact": "“Then we would have had to look at that too.”",
      "text_sha256": "1882c3b8697d2632a3c2574dfecca6e7de24c614de006a73ef651e379385ed3f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    }
  ]
}
