{
  "schema_version": 1,
  "chapter": 42,
  "chapter_title": "WITNESS",
  "chapter_sha256": "0b3d5c365acd307515b9cb0960b8a52aa9ffe5ac2e71efcd6a82a2a1a8207022",
  "policy": "No unresolved dialogue may fall back to narrator. render_allowed remains false until human approval.",
  "counts": {
    "dialogue_spans": 26,
