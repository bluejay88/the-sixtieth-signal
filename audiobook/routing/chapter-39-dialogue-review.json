    {
      "dialogue_id": "ch39-d0001",
      "chapter": 39,
      "start_offset": 93,
      "end_offset": 210,
      "text_exact": "“LOAM, isolate all archive-facing processes. Suspend autonomous inference. Preserve raw data. No external responses.”",
