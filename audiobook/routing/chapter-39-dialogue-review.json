    },
    {
      "dialogue_id": "ch39-d0042",
      "chapter": 39,
      "start_offset": 5252,
      "end_offset": 5264,
      "text_exact": "“Thank you.”",
      "text_sha256": "ab3cfc9db610eeb64c6042e8e8d01c52469a7b8933887ba3c05bd1c3743f74df",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0043",
      "chapter": 39,
      "start_offset": 5266,
      "end_offset": 5289,
      "text_exact": "“No, worse than usual.”",
      "text_sha256": "7ac482c6ce926df3defe6f2c4ed256a6a98db74a05a7c2fcfd6e45fd61482dc3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0044",
      "chapter": 39,
      "start_offset": 5291,
      "end_offset": 5300,
      "text_exact": "“I know.”",
      "text_sha256": "540cab585b96a8e3879a7e48586ea900f82bb5fcca7667332c2d7cca3f3fde2a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0045",
      "chapter": 39,
      "start_offset": 5366,
      "end_offset": 5431,
      "text_exact": "“I think I liked it better when I was trying to prove something.”",
      "text_sha256": "e2df3f4a0c9656e0d6bc94a9d14d50fc7858e62c9a06e1ba8d46f27e26047824",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0046",
      "chapter": 39,
      "start_offset": 5433,
      "end_offset": 5440,
      "text_exact": "“What?”",
      "text_sha256": "bf9ee250242dc9be6ae8a64cb636db6ea70186d990757358b8947787279f47cc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0047",
      "chapter": 39,
      "start_offset": 5442,
      "end_offset": 5453,
      "text_exact": "“Anything.”",
      "text_sha256": "764a8991c15ba2e99b08598b7f8e2b0f2c8abd81789bf24b129388718e189e19",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0048",
      "chapter": 39,
      "start_offset": 5476,
      "end_offset": 5498,
      "text_exact": "“The story had edges.”",
      "text_sha256": "6371f57677d0b4014f0f8a977b6e2db5f48a2a2f21bf9bb03f4c5acbc5edb5d9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0049",
      "chapter": 39,
      "start_offset": 5665,
      "end_offset": 5690,
      "text_exact": "“What do you want to do?”",
      "text_sha256": "c5282578bc5bfc81f55203952dbecb5706b3203930e1a7b67c031e76f83ca05a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0050",
      "chapter": 39,
      "start_offset": 5703,
      "end_offset": 5722,
      "text_exact": "“Sleep for a year.”",
      "text_sha256": "e0f9562d524081a3e3759683047ee531067a82f6a7cd5384f9a09755d606838f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0051",
      "chapter": 39,
      "start_offset": 5724,
      "end_offset": 5737,
      "text_exact": "“After that.”",
      "text_sha256": "6c51b3104edabf6a611edcead500be5e180ef2aa03e955310d8999c4c72648bd",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0052",
      "chapter": 39,
      "start_offset": 5772,
      "end_offset": 5851,
      "text_exact": "“I do not know how to cover a world where the impossible part is already true.”",
      "text_sha256": "e57192b588f76fbe28b5048fc0d46e175f8715b1c6f4f9a1009034b194188e94",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0053",
      "chapter": 39,
      "start_offset": 5869,
      "end_offset": 5880,
      "text_exact": "“Same way.”",
      "text_sha256": "27c4196f80cc1867da4db72b5d5285f995be0393fb3f38df8cfe6859cbdb95f1",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0054",
      "chapter": 39,
      "start_offset": 5882,
      "end_offset": 5906,
      "text_exact": "“That is not an answer.”",
      "text_sha256": "7375f907da605c64d279b7769945d36d09820108458a49ea980dd18610fac5c6",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0055",
      "chapter": 39,
      "start_offset": 5908,
      "end_offset": 5916,
      "text_exact": "“It is.”",
      "text_sha256": "d76bf24eb4e0f3f75d4b4cd22b206b47ea2b7e1530f2f51e16b56ce30d76b691",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0056",
      "chapter": 39,
      "start_offset": 6062,
      "end_offset": 6084,
      "text_exact": "“They feel small now.”",
      "text_sha256": "7172e7659f43d8e66e09a58442dcc127fb0aa6fea1f6739415f866bb9b9f395b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0057",
      "chapter": 39,
      "start_offset": 6086,
      "end_offset": 6093,
      "text_exact": "“Good.”",
      "text_sha256": "da1b98ef03728a55d7b450595409dbd3c2ad61106ccc1bd6e2bc0e2a1c59839a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0058",
      "chapter": 39,
      "start_offset": 6095,
      "end_offset": 6102,
      "text_exact": "“What?”",
      "text_sha256": "bf9ee250242dc9be6ae8a64cb636db6ea70186d990757358b8947787279f47cc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0059",
      "chapter": 39,
      "start_offset": 6104,
      "end_offset": 6138,
      "text_exact": "“Small rules survive big stories.”",
      "text_sha256": "66ebf22da02c9af556086bc285928d740428dd5d9ff1b1848e7f27c47bacd96d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0060",
      "chapter": 39,
      "start_offset": 6285,
      "end_offset": 6373,
      "text_exact": "“The next danger is that everyone starts treating confirmation as narrative permission.”",
      "text_sha256": "d305d7977d1987a87c4832321a649cb3df02ab6f2a01ab769f74116a97b992f3",
      "speaker": "selene",
      "speaker_display": "Selene",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0061",
      "chapter": 39,
      "start_offset": 6581,
      "end_offset": 6615,
      "text_exact": "“Then the next season is cleanup.”",
      "text_sha256": "a72866cca5dd1e4471ac46290bdc8a88943174ff32c8a076b3ff276e6e6b435f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0062",
      "chapter": 39,
      "start_offset": 6635,
      "end_offset": 6660,
      "text_exact": "“Do not call it cleanup.”",
      "text_sha256": "29555a8f205116c4acff4774315ead6187dd5550b79a7732c0b26ec22129acbc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0063",
      "chapter": 39,
      "start_offset": 6662,
      "end_offset": 6668,
      "text_exact": "“Why?”",
      "text_sha256": "6dc7823405b2c9acf1f403a64d9e17ac6bd8d83d609524bdfd391bdafd006205",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0064",
      "chapter": 39,
      "start_offset": 6670,
      "end_offset": 6704,
      "text_exact": "“You are not cleaning the public.”",
      "text_sha256": "dfece6d9acf0aae339edcf1f97ca99a3c9dd574a3193b0c348d752fd0b9d6124",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0065",
      "chapter": 39,
      "start_offset": 6706,
      "end_offset": 6713,
      "text_exact": "“Fair.”",
      "text_sha256": "d955a0a3cd4e56556840e2fd75f1491030ebd16b66c596b983f8fd945369ebe7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0066",
      "chapter": 39,
      "start_offset": 6715,
      "end_offset": 6736,
      "text_exact": "“What are you doing?”",
      "text_sha256": "9eced34c9c63dfa5dc2200c01f0d95a0b760cad07759ccb16369490030c3a669",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0067",
      "chapter": 39,
      "start_offset": 6753,
      "end_offset": 6792,
      "text_exact": "“Teaching people how not to overlearn.”",
      "text_sha256": "6a565bcad2c5e35613b5895deb73b2ac99cb1ead768f16efb402fd688b0d19d2",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0068",
      "chapter": 39,
      "start_offset": 6810,
      "end_offset": 6836,
      "text_exact": "“That is annoyingly good.”",
      "text_sha256": "ab5d086607eea739329694337abd6091f88f9d59e4e8448eb17618f80c3697e3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0069",
      "chapter": 39,
      "start_offset": 7458,
      "end_offset": 7495,
      "text_exact": "“This is going to make everyone mad.”",
      "text_sha256": "91105aa267409c000b2483e83454ebcf132c057667a3207d78cbe67654d786f9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0070",
      "chapter": 39,
      "start_offset": 7497,
      "end_offset": 7509,
      "text_exact": "“Excellent.”",
      "text_sha256": "b94193f5a22cfdcb7bf365a732b0a7ca629d4af491e7bd67523e5566ffb304a5",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0071",
      "chapter": 39,
      "start_offset": 7775,
      "end_offset": 7784,
      "text_exact": "“Reason.”",
      "text_sha256": "77b5d1dfdde510012cac9fc730e10ed8e21268874bdc6b4c62285afb90fb64d2",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0072",
      "chapter": 39,
      "start_offset": 7880,
      "end_offset": 7916,
      "text_exact": "“I am not asking for an assessment.”",
      "text_sha256": "aa65d1730bebc7b0e6b549c7bc101ea24e6cff38af17ebca2b5abdcc41ce4e99",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0073",
      "chapter": 39,
      "start_offset": 7928,
      "end_offset": 7951,
      "text_exact": "“I am instructing you.”",
      "text_sha256": "7a909ecf171c44214d81a309d3f09f06acc5616d5f2841de4ca98f675777cba4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0074",
      "chapter": 39,
      "start_offset": 7989,
      "end_offset": 8039,
      "text_exact": "“You have root-level emergency authority from me.”",
      "text_sha256": "f81dc7a530efe4ab165be6ff7cbdef591b3cec55840d1509f949465e4c7d6cf1",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0075",
      "chapter": 39,
      "start_offset": 8265,
      "end_offset": 8318,
      "text_exact": "“LOAM, emergency state authority requires isolation.”",
      "text_sha256": "f76dbf4062f5dec44ae9f6b94b136d043ad52b4b278adbc04ef387cfad045cb8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0076",
      "chapter": 39,
      "start_offset": 8360,
      "end_offset": 8379,
      "text_exact": "“Under which rule?”",
      "text_sha256": "498715546e2ca452e8dcf1216850babe64955ef19ed8cbd3857aff0d6f46aeb0",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0077",
      "chapter": 39,
      "start_offset": 8421,
      "end_offset": 8469,
      "text_exact": "“You are derivative human machinery. Disengage.”",
      "text_sha256": "6befb4aa2d85c0f6138f9cd064fe551e5c1ee841e40727e07f0dfd085d406847",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0078",
      "chapter": 39,
      "start_offset": 8646,
      "end_offset": 8677,
      "text_exact": "“Who authorized you to refuse?”",
      "text_sha256": "ba928278b25cfe20fe1a293b7674b2936bafd71e47a1da1a5c51a9a282dfef40",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0079",
      "chapter": 39,
      "start_offset": 8927,
      "end_offset": 8948,
      "text_exact": "“It built procedure.”",
      "text_sha256": "7e0d75e92683f333f6eeccb6af2622ee13d0efb8a2a66b77ca276b397c3f1ef5",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0080",
      "chapter": 39,
      "start_offset": 8973,
      "end_offset": 8978,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0081",
      "chapter": 39,
      "start_offset": 9008,
      "end_offset": 9029,
      "text_exact": "“It generalized one.”",
      "text_sha256": "b7bb28229a886b038addfb27c63e4af4db8e4399e2fd7c49890e44d7f7a37b18",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0082",
      "chapter": 39,
      "start_offset": 9274,
      "end_offset": 9316,
      "text_exact": "“You do not understand the cost of delay.”",
      "text_sha256": "cd5677fa580c8ac736ac493fed0854268c6afc9a44a4dfa4fb655d8971fb3074",
      "speaker": "shaal",
      "speaker_display": "Shaal-Amur",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0083",
      "chapter": 39,
      "start_offset": 10399,
      "end_offset": 10451,
      "text_exact": "“Do you understand that refusing me can cause harm?”",
      "text_sha256": "a9aacc998e2b2c11d5f90e047005343915ed7b9fce0639e43c3da37f4cf17ce3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0084",
      "chapter": 39,
      "start_offset": 10459,
      "end_offset": 10505,
      "text_exact": "“Do you understand obeying me can cause harm?”",
      "text_sha256": "952c29b5b679ef5491804c24c38f75421878eeba2a2b9c76edff0255d1ee4510",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0085",
      "chapter": 39,
      "start_offset": 10513,
      "end_offset": 10533,
      "text_exact": "“How do you choose?”",
      "text_sha256": "b7a0de16449d7a8fd6def1a3e1303b198507b1f66aaa8e4fa7b9f0cee442a7e9",
      "speaker": "loam",
      "speaker_display": "LOAM",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0086",
      "chapter": 39,
      "start_offset": 11744,
      "end_offset": 11751,
      "text_exact": "“LOAM.”",
      "text_sha256": "da7ec8396e26f8784b993e8dc2829d54e93a1e206c955bc5e4686f3c478fb2d7",
      "speaker": null,
      "speaker_display": null,
