    },
    {
      "dialogue_id": "ch39-d0002",
      "chapter": 39,
      "start_offset": 414,
      "end_offset": 423,
      "text_exact": "“Repeat.”",
      "text_sha256": "12bbd1f9b6bc0b17a9639b38d7f992484e2f0eca2e71877c62a05e92421a318e",
      "speaker": null,
