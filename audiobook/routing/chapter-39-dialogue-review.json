      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0039",
      "chapter": 39,
      "start_offset": 3867,
      "end_offset": 3896,
      "text_exact": "“No external language model?”",
      "text_sha256": "50219265588a85d54af4e4886948a68ad2bad8978180943d1621006bf262a25c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
