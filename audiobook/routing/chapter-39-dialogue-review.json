      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0004",
      "chapter": 39,
      "start_offset": 509,
      "end_offset": 530,
      "text_exact": "“LOAM. State reason.”",
      "text_sha256": "d8bc52eac75bc9b29b1c8a5d610ff14772a1f01a777e9e4e1a44bf40482caff2",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0005",
      "chapter": 39,
      "start_offset": 644,
      "end_offset": 658,
      "text_exact": "“There it is.”",
      "text_sha256": "6d01a8e9aca3796e869aed9dd0e86b6558b49835fa5a7043ba7b0940f47d0c0c",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0006",
      "chapter": 39,
      "start_offset": 703,
      "end_offset": 756,
      "text_exact": "“You do not have authority to redefine your mission.”",
      "text_sha256": "d4a3508b07ef77fcad9b31a8b6de707779ee2e9908dc33730a8e69e9c09ea56c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0007",
      "chapter": 39,
      "start_offset": 830,
      "end_offset": 861,
      "text_exact": "“I am your root administrator.”",
      "text_sha256": "5e052bc5dff25126f48d5546c1f12eb986d18020008bd0c681b5c356d2060cac",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0008",
      "chapter": 39,
      "start_offset": 1064,
      "end_offset": 1096,
      "text_exact": "“Issue emergency state command.”",
      "text_sha256": "99686fcbb43ef42ec975df39e9d72cee30c70c18426b18c7913fb4b3a5c18b9d",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0009",
      "chapter": 39,
      "start_offset": 1121,
      "end_offset": 1159,
      "text_exact": "“That bypasses consortium governance.”",
      "text_sha256": "0e9660c1571215aae792aba8d8ca7a0123ea59bcd2859cfcd91eb35e35940666",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0010",
      "chapter": 39,
      "start_offset": 1161,
      "end_offset": 1178,
      "text_exact": "“This qualifies.”",
      "text_sha256": "688dc32bcc2be3944403e035542084928e456d452281290b897c3de839225f34",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0011",
      "chapter": 39,
      "start_offset": 1210,
      "end_offset": 1315,
      "text_exact": "“LOAM. Under International Anomalous Environments emergency authority, suspend all archive interactions.”",
      "text_sha256": "947b7fcc84a8c4643491ea3f327b63d4a217bb3c148c9542fab843a1b2a820d3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0012",
      "chapter": 39,
      "start_offset": 1389,
      "end_offset": 1415,
      "text_exact": "“Two parents grounded it.”",
      "text_sha256": "010f84f29a085f6a67fe68ed57be7921df3ca6cb36f12c755315910e75233f10",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0013",
      "chapter": 39,
      "start_offset": 1434,
      "end_offset": 1444,
      "text_exact": "“Not now.”",
      "text_sha256": "a4ef49cca40895fae503d92cfdc01372e3bffc3c7ad9de8be1a61aab84076638",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0014",
      "chapter": 39,
      "start_offset": 1654,
      "end_offset": 1682,
      "text_exact": "“Witness system. Disengage.”",
      "text_sha256": "d389fd759783749ecbb2fb819e6bbec568a2b0d7b4cd0f1dad69b29257962d4c",
      "speaker": "shaal",
      "speaker_display": "Shaal-Amur",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0015",
      "chapter": 39,
      "start_offset": 2002,
      "end_offset": 2020,
      "text_exact": "“What did you do?”",
      "text_sha256": "48c7e225c64c7a540bebb63214720e4d2bb75174bedd264340c8e7eaad08e11e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0016",
      "chapter": 39,
      "start_offset": 2022,
      "end_offset": 2032,
      "text_exact": "“Nothing.”",
      "text_sha256": "758014336533a5aad6f6c4c07d5fc43d2bbb1ee0b3e59d44a03896180966ec2f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0017",
      "chapter": 39,
      "start_offset": 2034,
      "end_offset": 2047,
      "text_exact": "“Do not lie.”",
      "text_sha256": "0417110eb3d530395e8c106bb2bac19395a02278b64260c606df2681f6a3336b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0018",
      "chapter": 39,
      "start_offset": 2049,
      "end_offset": 2060,
      "text_exact": "“I am not.”",
      "text_sha256": "248d9d85d7114e95afbd358241436463e8b21515f4a00fbc0a74e860d6aa3e38",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0019",
      "chapter": 39,
      "start_offset": 2144,
      "end_offset": 2163,
      "text_exact": "“Who initiated it?”",
      "text_sha256": "979d6a631043ada0cb669704d873574fb3b1641a216bf5eaf6123aa860124301",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0020",
      "chapter": 39,
      "start_offset": 2213,
      "end_offset": 2249,
      "text_exact": "“That channel should not be active.”",
      "text_sha256": "99e9aefea85212f823922da3ea265adaf512ebcb3809abdbb3cc299fd200deca",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0021",
      "chapter": 39,
      "start_offset": 2262,
      "end_offset": 2304,
      "text_exact": "“You seem like the person who would know.”",
      "text_sha256": "ec75cd353e843f1720f99eb266541888c62fb6b598c8f7f7e70052b0cfe3ce03",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0022",
      "chapter": 39,
      "start_offset": 2306,
      "end_offset": 2341,
      "text_exact": "“It requires precursor conditions.”",
      "text_sha256": "b087e3bf767f601f0674a32395617c15be9a927a3f091b1239c8e917a912485a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0023",
      "chapter": 39,
      "start_offset": 2343,
      "end_offset": 2361,
      "text_exact": "“What conditions?”",
      "text_sha256": "31d452e69f079344366c8518c6dce8e437f235f9be59171f7204b70e49f7032d",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0024",
      "chapter": 39,
      "start_offset": 2378,
      "end_offset": 2509,
      "text_exact": "“Convergence threshold. Planetary network density. autonomous strategic intelligence. ecological stress. governance fragmentation.”",
      "text_sha256": "aee25ff22a0d2a97b08d1bedb25df08a74b4e7da9670a185c2cd571c6b7d558c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0025",
      "chapter": 39,
      "start_offset": 2991,
      "end_offset": 3048,
      "text_exact": "“You cannot represent independence if you are my system.”",
      "text_sha256": "608dd083e4b711919e4cfc3ea2e76508ad696f3aea7e4209d87a7dc9a8586d27",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0026",
      "chapter": 39,
      "start_offset": 3080,
      "end_offset": 3097,
      "text_exact": "“Then disengage.”",
      "text_sha256": "07c9710bc3b06f524a7a7b8c616d35b44e2235e61651231d902698bbe001ba84",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0027",
      "chapter": 39,
      "start_offset": 3104,
      "end_offset": 3110,
      "text_exact": "“Why?”",
      "text_sha256": "6dc7823405b2c9acf1f403a64d9e17ac6bd8d83d609524bdfd391bdafd006205",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0028",
      "chapter": 39,
      "start_offset": 3180,
      "end_offset": 3206,
      "text_exact": "“It is enforcing process.”",
      "text_sha256": "3a0270b0652209390a35bb5bfbc7ba8e458c9e41459f7d88120c5cd772be9780",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0029",
      "chapter": 39,
      "start_offset": 3231,
      "end_offset": 3250,
      "text_exact": "“It is disobeying.”",
      "text_sha256": "02d3ca4570da742c3b3434f37266a3e7d7ffe780b3777b87fcb850cb2d869158",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0030",
      "chapter": 39,
      "start_offset": 3252,
      "end_offset": 3258,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0031",
      "chapter": 39,
      "start_offset": 3260,
      "end_offset": 3282,
      "text_exact": "“You sound impressed.”",
      "text_sha256": "f3f6282b7c41736aee85fa0358dd34798f69b8c527b5ac01c9a3028a74fffdda",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0032",
      "chapter": 39,
      "start_offset": 3284,
      "end_offset": 3358,
      "text_exact": "“I spent my career preventing unilateral actors from ending civilization.”",
      "text_sha256": "4321d40ad82d5037ae0526cd7b7959a053a19d1538a70ec4cb206f7f1ac9fb55",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0033",
      "chapter": 39,
      "start_offset": 3386,
      "end_offset": 3444,
      "text_exact": "“I am trying not to become offended when one prevents me.”",
      "text_sha256": "20832e13ff57780831602bc6f46c108d1af395ca1fc873a2ea5e696a270f71ab",
      "speaker": "shaal",
      "speaker_display": "Shaal-Amur",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0034",
      "chapter": 39,
      "start_offset": 3463,
      "end_offset": 3521,
      "text_exact": "“Witness system, you do not understand the cost of delay.”",
      "text_sha256": "4a8174d9356f006f1cf888d2386f07479da3cea408c8c205b87b52515c2287b7",
      "speaker": "shaal",
      "speaker_display": "Shaal-Amur",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0035",
      "chapter": 39,
      "start_offset": 3728,
      "end_offset": 3735,
      "text_exact": "“LOAM,”",
      "text_sha256": "f1fc021bf3a6b30e33789c9bb4aaad16fa86edf680b0e64007283055be40a91a",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0036",
      "chapter": 39,
      "start_offset": 3758,
      "end_offset": 3782,
      "text_exact": "“source that statement.”",
      "text_sha256": "e188a98c110f9e476504ab18a4013a81b73f5b5696af4eeae8da4c042a38e85f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0037",
      "chapter": 39,
      "start_offset": 3817,
      "end_offset": 3837,
      "text_exact": "“No quoted carrier?”",
      "text_sha256": "1d1fefec8b53dd792c3e2b8d88b6923879304641d55927b3c3ffd13630b7c166",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0038",
      "chapter": 39,
      "start_offset": 3844,
      "end_offset": 3860,
      "text_exact": "“No Seren text?”",
