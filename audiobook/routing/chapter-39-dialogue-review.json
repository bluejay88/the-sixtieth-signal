      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0003",
      "chapter": 39,
      "start_offset": 464,
      "end_offset": 482,
      "text_exact": "“Is this a fault?”",
      "text_sha256": "1f0e31058bfc3059e56d5f06335ee78c85252626950186ce88dc43691155d609",
      "speaker": null,
      "speaker_display": null,
