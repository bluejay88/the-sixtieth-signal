      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0040",
      "chapter": 39,
      "start_offset": 4162,
      "end_offset": 4199,
      "text_exact": "“You believe refusal makes you free?”",
      "text_sha256": "d5650f72ac54a28934b787fc54fb0854706ff5cc77b966648f4cfbd7895fcc59",
      "speaker": "loam",
      "speaker_display": "LOAM",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch39-d0041",
      "chapter": 39,
      "start_offset": 5230,
      "end_offset": 5250,
      "text_exact": "“You look terrible.”",
      "text_sha256": "f03081d2f61106372f6f80460b37fd921a04ffe121caceb3c1c5078f1c5b9859",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
