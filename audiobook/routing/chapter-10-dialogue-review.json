      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0011",
      "chapter": 10,
      "start_offset": 1246,
      "end_offset": 1252,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0012",
      "chapter": 10,
      "start_offset": 1254,
      "end_offset": 1270,
      "text_exact": "“What happened?”",
      "text_sha256": "3a29c49456a7f6861930dfc9c8dbe16ed7891bbcb56e95c5a4ad89515caa6cdd",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0013",
      "chapter": 10,
      "start_offset": 1365,
      "end_offset": 1374,
      "text_exact": "“Thirty.”",
      "text_sha256": "f8f6093653c8aeace21c1cda6b6a732fa82eb958a43b18e4893daac9012551db",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0014",
      "chapter": 10,
      "start_offset": 1434,
      "end_offset": 1473,
      "text_exact": "“The system supplied the missing term.”",
      "text_sha256": "6f260a38ee8241cf76a7be62eae23d555fbbb93156d3a336ba8f8b7afb8f5a47",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0015",
      "chapter": 10,
      "start_offset": 1475,
      "end_offset": 1525,
      "text_exact": "“Or the equipment generated a patterned artifact,”",
      "text_sha256": "b304e3c8a8c40cfd8d62041190e8fdfe71c387ac9f56500c0ed8bc8c71a3961f",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0016",
      "chapter": 10,
      "start_offset": 1538,
      "end_offset": 1555,
      "text_exact": "“Did you repeat?”",
      "text_sha256": "2bd01ef2891be910fac2f73f2abad3c2316a1d3a24a3fe1a5b012520614d55cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0017",
      "chapter": 10,
      "start_offset": 1557,
      "end_offset": 1571,
      "text_exact": "“Three times.”",
      "text_sha256": "7a7a419fdd101437c3a21b9d05bf90db7c6388a20e62d1fa90cd77629eb62557",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0018",
      "chapter": 10,
      "start_offset": 1573,
      "end_offset": 1589,
      "text_exact": "“Same response?”",
      "text_sha256": "ca8b839536392a17784eee61f8326c0201e875d43719323575c1a6eabf2a9ef8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0019",
      "chapter": 10,
      "start_offset": 1591,
      "end_offset": 1596,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0020",
      "chapter": 10,
      "start_offset": 1598,
      "end_offset": 1621,
      "text_exact": "“Then why prohibit it?”",
      "text_sha256": "0432a4dc0e18aec351121b6d7ce5183384517f10a16e90e288f58a669e8b5aea",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0021",
      "chapter": 10,
      "start_offset": 1623,
      "end_offset": 1718,
      "text_exact": "“On the third trial, every synchronized instrument at six SVW sites dropped for sixty seconds.”",
      "text_sha256": "eb0578acbb33a073438625e9f2c676fa0415865717d5293d9a8f1ed742c6a07e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0022",
      "chapter": 10,
      "start_offset": 1835,
      "end_offset": 1844,
      "text_exact": "“Damage?”",
      "text_sha256": "5c6f5af97a2428f9f24f6fe9f78a210f7aae9c3c3f09c95bd7e9a6131b8634cc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0023",
      "chapter": 10,
      "start_offset": 1846,
      "end_offset": 1851,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0024",
      "chapter": 10,
      "start_offset": 1853,
      "end_offset": 1864,
      "text_exact": "“Casualty?”",
      "text_sha256": "63781bc4e9c746578224f1077f654175900d58a723e1434930ee907e8809e5df",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0025",
      "chapter": 10,
      "start_offset": 1866,
      "end_offset": 1871,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0026",
      "chapter": 10,
      "start_offset": 1873,
      "end_offset": 1880,
      "text_exact": "“Then?”",
      "text_sha256": "1db82dc0542872730135b8fb652c3f52632747da3b260320e453f4c2234fc9e5",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0027",
      "chapter": 10,
      "start_offset": 1956,
      "end_offset": 2000,
      "text_exact": "“One site was twenty-eight kilometers away.”",
      "text_sha256": "871a6b22b29a462648cab8e65f3dd37fe8f91f128949b8549681cf9d784678d0",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0028",
      "chapter": 10,
      "start_offset": 2072,
      "end_offset": 2112,
      "text_exact": "“You think the interface is one system.”",
      "text_sha256": "cb7ee5ec5cc91c384bc4f3d85d18382941b6029f918492fdd089a6248c7879db",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0029",
      "chapter": 10,
      "start_offset": 2114,
      "end_offset": 2131,
      "text_exact": "“We do not know.”",
      "text_sha256": "f08f598ba4e175da71d33f1b17e7ea936cfebdc7a8eb56cd4c78cdab83227db7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0030",
      "chapter": 10,
      "start_offset": 2316,
      "end_offset": 2341,
      "text_exact": "“What does LOAM propose?”",
      "text_sha256": "ef245e58b388a63ecc616ca1cae9192d832e0b3d465b28a3ef94df674d70f1a4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0031",
      "chapter": 10,
      "start_offset": 2364,
      "end_offset": 2386,
      "text_exact": "“This is your system.”",
      "text_sha256": "ec0a0b8aeeea316fed291daa79534e87f40d8346c067bd8907eac61bc010da71",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0032",
      "chapter": 10,
      "start_offset": 2388,
      "end_offset": 2414,
      "text_exact": "“That isn’t what I asked.”",
      "text_sha256": "90271538bf64790dc6149247f12c79c6139a3f2667499602354df4e92b25e633",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0033",
      "chapter": 10,
      "start_offset": 2453,
      "end_offset": 2598,
      "text_exact": "“Design a falsifiable test distinguishing energy response from pattern response. No semantic assumptions. No use of unregistered number systems.”",
      "text_sha256": "6f9b708c8fa897ff065d5c8f6d9be83ea6fbf7a0c7efc34f8a2b3cc463974a60",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0034",
      "chapter": 10,
      "start_offset": 2858,
      "end_offset": 2900,
      "text_exact": "“That’s what we should have done in 2052.”",
      "text_sha256": "35941299d9fbca9665f4e055ca46280bc717bdc9412cbf6fc38a5ffd48f6a26d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0035",
      "chapter": 10,
      "start_offset": 2934,
      "end_offset": 2967,
      "text_exact": "“Can we run it without drilling?”",
      "text_sha256": "055347955795981aa30f1ab6e0cf39bb986292b9fca55d674055e2f8c08c07b5",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0036",
      "chapter": 10,
      "start_offset": 2969,
      "end_offset": 2975,
      "text_exact": "“Yes,”",
      "text_sha256": "962de7fb6fae75af56fade68f4c6749cef2bb0359757cabcea0e02437a368c4b",
      "speaker": "park",
      "speaker_display": "Park",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0037",
      "chapter": 10,
      "start_offset": 2987,
      "end_offset": 3053,
      "text_exact": "“Through the existing passive channel, if coupling is sufficient.”",
      "text_sha256": "79337a68f2a2760205c5cecbfd4bdd3132f1d315d34a679dbe16ab82f23d014a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0038",
      "chapter": 10,
      "start_offset": 3088,
      "end_offset": 3111,
      "text_exact": "“What is the downside?”",
      "text_sha256": "3c00d33e8bdd28ec845977c17cdedbebf4204f3ff6f4cd4dda73b0bacf8fa2c9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0039",
      "chapter": 10,
      "start_offset": 3132,
      "end_offset": 3165,
      "text_exact": "“We discover something responds.”",
      "text_sha256": "1d1434b4ffc67aaeca5926154a60142a0479d4fc0cc2acba6ce0fae7027b7d80",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0040",
      "chapter": 10,
      "start_offset": 3167,
      "end_offset": 3192,
      "text_exact": "“And the other downside?”",
      "text_sha256": "02c95dcb12a694d4ef45891359ecc8f8552117cfc4ce4700f2d0366bb5b2a017",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0041",
      "chapter": 10,
      "start_offset": 3194,
      "end_offset": 3242,
      "text_exact": "“We convince ourselves it does when it doesn’t.”",
      "text_sha256": "5732d34a1768df93ceaf463d7db2851885ce361a5e5ed7838d9ff3427d128f68",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0042",
      "chapter": 10,
      "start_offset": 3258,
      "end_offset": 3298,
      "text_exact": "“LOAM can blind the sequence generator.”",
      "text_sha256": "1899770c1d2fba3fed4af9223392273b4d6e8a3b2ef6bbfe8cf544e2ea89826f",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0043",
      "chapter": 10,
      "start_offset": 3320,
      "end_offset": 3356,
      "text_exact": "“And if LOAM is part of the system?”",
      "text_sha256": "1a9a34da6a5293811d81b4c2f3b2c19d3134b5ac17e340f059369b621cecd521",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0044",
      "chapter": 10,
      "start_offset": 3441,
      "end_offset": 3452,
      "text_exact": "“It isn’t.”",
      "text_sha256": "fd5f8d10f91c2074b6b3ba118da9529aa0568204efe5b30cc0593916b3ee947c",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0045",
      "chapter": 10,
      "start_offset": 3454,
      "end_offset": 3477,
      "text_exact": "“You do not know that.”",
      "text_sha256": "9ab88f740f3c117d45e33bae408b01960336ae0a673941d9c593b59610c1eafe",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0046",
      "chapter": 10,
      "start_offset": 3479,
      "end_offset": 3492,
      "text_exact": "“I built it.”",
      "text_sha256": "955a6bbafee726087347fa205c8a56c96df1986f2ba8fbe45003a1505f8b5a94",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0047",
      "chapter": 10,
      "start_offset": 3547,
      "end_offset": 3590,
      "text_exact": "“That is not the argument you think it is.”",
      "text_sha256": "4a0ad7730e72903542c06caf75c42dc1d38cec4ba07c64de73b38d103cd79899",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0048",
      "chapter": 10,
      "start_offset": 3894,
      "end_offset": 3937,
      "text_exact": "“Then we use an independent random source,”",
      "text_sha256": "d8241e1b51cfd9ed13ba0d1d0e4462dea15f80afa68e6c7650cfeed4103bb199",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0049",
      "chapter": 10,
      "start_offset": 4899,
      "end_offset": 4914,
      "text_exact": "“Significance?”",
      "text_sha256": "4da7b62a088686aa47a800035f0a0ec47577068023e5f7d4271fa72edb3be119",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0050",
      "chapter": 10,
      "start_offset": 4949,
      "end_offset": 4956,
      "text_exact": "“Good.”",
      "text_sha256": "da1b98ef03728a55d7b450595409dbd3c2ad61106ccc1bd6e2bc0e2a1c59839a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0051",
      "chapter": 10,
      "start_offset": 5192,
      "end_offset": 5210,
      "text_exact": "“Repeat tomorrow.”",
      "text_sha256": "c170cd26f3b4c60baa3e02e7d602631aa7d62fd01dc135fab2d32e51eb4eeeb3",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0052",
      "chapter": 10,
      "start_offset": 5930,
      "end_offset": 5951,
      "text_exact": "“That’s not geology.”",
      "text_sha256": "8d734f4b70f9f8b4126656b037e8935280f62aa365af3232f01023ca1c2e5e07",
      "speaker": "park",
      "speaker_display": "Park",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0053",
      "chapter": 10,
      "start_offset": 6613,
      "end_offset": 6633,
      "text_exact": "“We never got this.”",
      "text_sha256": "7cf54301b2a5ff8bc9a4bed6fcb990268003ce22945979e03da8dfb31bec1f3a",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0054",
      "chapter": 10,
      "start_offset": 6635,
      "end_offset": 6645,
      "text_exact": "“Why now?”",
      "text_sha256": "97525678d3e4cfeca3502b04d0f7c2e7b2d81f80b5004f0aa52acaf461cb8a41",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0055",
      "chapter": 10,
      "start_offset": 6781,
      "end_offset": 6806,
      "text_exact": "“Do not classify origin.”",
      "text_sha256": "363f0a144d3676c1602c4fa485cbe172bb8d1b821250b293e5dcca301dbe51ad",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0056",
      "chapter": 10,
      "start_offset": 6830,
      "end_offset": 6861,
      "text_exact": "“Do not classify intelligence.”",
      "text_sha256": "e7eb71b0ff38168f1ec9f1a65db72fa00c50ecf32893c3a7717a61f1744b83d7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0057",
      "chapter": 10,
      "start_offset": 6891,
      "end_offset": 6920,
      "text_exact": "“Do not classify artificial.”",
      "text_sha256": "681b27fed514dd0f7d602857c11ac0adb4ccabdb7712ab23d911ff5c4995b0c8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0058",
      "chapter": 10,
      "start_offset": 7005,
      "end_offset": 7054,
      "text_exact": "“That is a very Cassian way of saying holy shit.”",
      "text_sha256": "c6b3f302ca11bf7c6322c934401f9853cb8b7fd6bd9e34021628ef835e0e783b",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0059",
      "chapter": 10,
      "start_offset": 7479,
      "end_offset": 7484,
      "text_exact": "“No,”",
      "text_sha256": "0a405d0f063d8a504bcc2dbc25e87880c12d00e2e4284e04b69c64f5d8f7a73a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0060",
      "chapter": 10,
      "start_offset": 7657,
      "end_offset": 7676,
      "text_exact": "“Did we send that?”",
      "text_sha256": "7440452865db9f995601a197e6c28675707c5af8ee8395dda85242fac84ba72e",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0061",
      "chapter": 10,
      "start_offset": 7678,
      "end_offset": 7683,
      "text_exact": "“No,”",
      "text_sha256": "0a405d0f063d8a504bcc2dbc25e87880c12d00e2e4284e04b69c64f5d8f7a73a",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0062",
      "chapter": 10,
      "start_offset": 7699,
      "end_offset": 7722,
      "text_exact": "“Did SVW ever send it?”",
      "text_sha256": "e2464306128954e146b1c36527186fbc60aa30f1acaaf6397ea544c01cfca166",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0063",
      "chapter": 10,
      "start_offset": 7769,
      "end_offset": 7780,
      "text_exact": "“Director.”",
      "text_sha256": "33d32b8de7a8a2553171124bc8f2adcad641f796c56f806eafcb78fa190ed36d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0064",
      "chapter": 10,
      "start_offset": 7815,
      "end_offset": 7820,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0065",
      "chapter": 10,
      "start_offset": 8677,
      "end_offset": 8708,
      "text_exact": "“Nobody uses the word contact,”",
      "text_sha256": "4009287268824006338a61bb92e8753d81ca741450e89df84132f671e820163f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0066",
      "chapter": 10,
      "start_offset": 8746,
      "end_offset": 8769,
      "text_exact": "“What word can we use?”",
      "text_sha256": "af9fd2b2882dedc894d586785a34c08736004d96d9e48fdd3d5195a6623082cb",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0067",
      "chapter": 10,
      "start_offset": 8771,
      "end_offset": 8782,
      "text_exact": "“Response.”",
      "text_sha256": "951b8d284cee37d379799db93aefb13b7cfeffddcb42a8f19ac9393ddc168e06",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0068",
      "chapter": 10,
      "start_offset": 8784,
      "end_offset": 8802,
      "text_exact": "“Responsive what?”",
      "text_sha256": "bb3a544885c753ce40d74f791bbe1df129f4393995b141f61c22df75b5422d32",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0069",
      "chapter": 10,
      "start_offset": 8804,
      "end_offset": 8814,
      "text_exact": "“Unknown.”",
      "text_sha256": "537681d0ed67c7f7e2eeef9868ba63f16c27bf1d47b45a5ea4606228bbf03769",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0070",
      "chapter": 10,
      "start_offset": 9334,
      "end_offset": 9341,
      "text_exact": "“Good,”",
      "text_sha256": "38230771dc0110e9b2c42bc2a2a5ce3febd053c13f3d875fc211f97a38cb713b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0071",
      "chapter": 10,
      "start_offset": 9374,
      "end_offset": 9381,
      "text_exact": "“Good?”",
      "text_sha256": "b2c45b153ec14c18b768bce1458dba3ba639187fc7bcdd3d1a129262d1abfeb4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0072",
      "chapter": 10,
      "start_offset": 9383,
      "end_offset": 9480,
      "text_exact": "“If removing sensors did nothing, I'd suspect the model was overdetermined by prior assumptions.”",
      "text_sha256": "d09248ac13b1c65d7b70190143563196172021c5cd68d31525fd266f36d522ab",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0073",
      "chapter": 10,
      "start_offset": 9482,
      "end_offset": 9533,
      "text_exact": "“You are relieved the miracle got less miraculous.”",
      "text_sha256": "8226413f28a2a0d137976617615b27dd76c29f26084250e41cbff5ebe3cd1356",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0074",
      "chapter": 10,
      "start_offset": 9535,
      "end_offset": 9541,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0075",
      "chapter": 10,
      "start_offset": 9608,
      "end_offset": 9642,
      "text_exact": "“You know this changes your life,”",
      "text_sha256": "7801785735b457c1ee255330651cb3dc04aa27810c79a6d016055af395d56ff0",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0076",
      "chapter": 10,
      "start_offset": 9655,
      "end_offset": 9683,
      "text_exact": "“We do not know what it is.”",
      "text_sha256": "1f18f6c00fae5ba8702ee3ad88ba504049a38e8dd8adba280d6287a1f90997fe",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0077",
      "chapter": 10,
      "start_offset": 9685,
      "end_offset": 9718,
      "text_exact": "“That has never stopped history.”",
      "text_sha256": "a74357ee7dfd33b426ced7146e28c83ab2f2d9e2067c1f2ec31915e467c57323",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0078",
      "chapter": 10,
      "start_offset": 9744,
      "end_offset": 9787,
      "text_exact": "“Do not make me a character in your story.”",
      "text_sha256": "e2caa519846ebf46eeeb98cb1245337bbbf54b1c91379f2b4c4f262bdfd467fc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0079",
      "chapter": 10,
      "start_offset": 9818,
      "end_offset": 9836,
      "text_exact": "“You already are.”",
      "text_sha256": "38eed938d2b039e2d787ea40f6c0cbf065cfff01a0879495740bca25b3616b11",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0080",
      "chapter": 10,
      "start_offset": 10241,
      "end_offset": 10271,
      "text_exact": "“I did not build it for this,”",
      "text_sha256": "1aebb2aceb91501ccd3d3030d8b255a28fe435efcac2dae3b28780bb8c98c81e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0081",
      "chapter": 10,
      "start_offset": 10319,
      "end_offset": 10376,
      "text_exact": "“Nobody builds the thing for what it eventually becomes.”",
      "text_sha256": "0ddc2dc34e6c7e1573133f14563b385b54dd97c1c50c15fd7494600e4ced2e7e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0082",
      "chapter": 10,
      "start_offset": 10588,
      "end_offset": 10595,
      "text_exact": "“What?”",
      "text_sha256": "bf9ee250242dc9be6ae8a64cb636db6ea70186d990757358b8947787279f47cc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0083",
      "chapter": 10,
      "start_offset": 10619,
      "end_offset": 10686,
      "text_exact": "“The interface response was detected at four additional SVW sites.”",
      "text_sha256": "e89e79000cc25e7692df888ffe04b4a4e872c4baeb66203d220109a717cf69f4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0084",
      "chapter": 10,
      "start_offset": 10688,
      "end_offset": 10705,
      "text_exact": "“Simultaneously?”",
      "text_sha256": "044bf1194538b38ec1842a9aba79c4c5d4f08740fbf392e75f08177d91694691",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0085",
      "chapter": 10,
      "start_offset": 10707,
      "end_offset": 10740,
      "text_exact": "“Within clock-correction limits.”",
      "text_sha256": "188d3404e2e3aed6deba9629062e6350a3c0bcbffb5e2cb68e417b6243c7e702",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0086",
      "chapter": 10,
      "start_offset": 11353,
      "end_offset": 11395,
      "text_exact": "“Because continuing risked contamination.”",
      "text_sha256": "b2ef10bb3aa1bbecc9320822ea0dfcde1230b7e2ec113dfab8dd5344fb0a129c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0087",
      "chapter": 10,
      "start_offset": 11473,
      "end_offset": 11526,
      "text_exact": "“Because bad evidence can be worse than no evidence.”",
      "text_sha256": "e00773c9da86e7fd5fac9acbc3ef100278aa248169cfce22d2e3c59a0e8511fc",
