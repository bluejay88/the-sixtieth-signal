      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0006",
      "chapter": 10,
      "start_offset": 1074,
      "end_offset": 1086,
      "text_exact": "“Why those?”",
      "text_sha256": "b45f9145bbc7286621bf461335547e4c6f7da4752cacf16b73809523b0636e80",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0007",
      "chapter": 10,
      "start_offset": 1088,
      "end_offset": 1167,
      "text_exact": "“Because someone on the team believed the earlier events followed that family.”",
      "text_sha256": "114b0204897a4fcf37cc7362fc44edfd3cbe81e03a683272372fc21c37d858d9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch10-d0008",
      "chapter": 10,
      "start_offset": 1169,
      "end_offset": 1205,
      "text_exact": "“So they were testing their theory.”",
      "text_sha256": "dbaa1f84f8e73d3f8dbb96b49d976eb690cc6a5a2315bc57832b87fc96e8171f",
      "speaker": null,
      "speaker_display": null,
