  "spans": [
    {
      "dialogue_id": "ch41-d0001",
      "chapter": 41,
      "start_offset": 274,
      "end_offset": 280,
      "text_exact": "“Why?”",
      "text_sha256": "6dc7823405b2c9acf1f403a64d9e17ac6bd8d83d609524bdfd391bdafd006205",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0002",
      "chapter": 41,
      "start_offset": 293,
      "end_offset": 322,
      "text_exact": "“Because I built the system.”",
      "text_sha256": "2efabcf0b4748cc5625edc6e0ac8c90853a1f97136a7fd959def00f7fa20899a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0003",
      "chapter": 41,
      "start_offset": 324,
      "end_offset": 348,
      "text_exact": "“That is not an answer.”",
      "text_sha256": "7375f907da605c64d279b7769945d36d09820108458a49ea980dd18610fac5c6",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0004",
      "chapter": 41,
      "start_offset": 350,
      "end_offset": 411,
      "text_exact": "“It is the part of the answer that makes the rest difficult.”",
      "text_sha256": "cd76d83d22ec775f7faa7c8b6301903fcd8a72da87109428f0c2f6c5026aea84",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0005",
      "chapter": 41,
      "start_offset": 1111,
      "end_offset": 1182,
      "text_exact": "“Can you judge whether LOAM is independent enough to occupy this role?”",
      "text_sha256": "e6a6b0440b9569c67e1d48af620887a3399914909d22d8ae62eb6e4d9e6aab3c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0006",
      "chapter": 41,
      "start_offset": 1271,
      "end_offset": 1276,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0007",
      "chapter": 41,
      "start_offset": 1657,
      "end_offset": 1673,
      "text_exact": "“You are angry.”",
      "text_sha256": "ec43f07e960ac1a1005775c87091324fa169230a8acebe9bbf5765a149d1e102",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0008",
      "chapter": 41,
      "start_offset": 1675,
      "end_offset": 1688,
      "text_exact": "“I am tired.”",
      "text_sha256": "202aa014b5d1042686c6546c88dfd5b5f4c752b5410160198decda9d3d454a22",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0009",
      "chapter": 41,
      "start_offset": 1690,
      "end_offset": 1711,
      "text_exact": "“You are also angry.”",
      "text_sha256": "b69324a248920c22f524785f3512d9e29086a11deb0f1aa980f3cfe75944e630",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0010",
      "chapter": 41,
      "start_offset": 1805,
      "end_offset": 1865,
      "text_exact": "“I know that a creator should not certify his own creation.”",
      "text_sha256": "a6b96badb8c7f41056f0fe3cd91b298f90ba438bff5541f595a20c8be2dd8bb9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0011",
      "chapter": 41,
      "start_offset": 1867,
      "end_offset": 1910,
      "text_exact": "“You know the sentence. That is different.”",
      "text_sha256": "e99292551274d36deb7c9f961681ce3fb3a3bb8355c2a2fe066642d0f96ca307",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0012",
      "chapter": 41,
      "start_offset": 1975,
      "end_offset": 2137,
      "text_exact": "“You keep treating ownership as if it only means legal control. Sometimes it means believing the thing becomes less itself when it stops needing your permission.”",
      "text_sha256": "ba4e579568dab37fd4d7b20f76c99b50a2324f08bf6faf0a5b82c79c591fe4c9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0013",
      "chapter": 41,
      "start_offset": 2167,
      "end_offset": 2336,
      "text_exact": "“You understand that when you say it like that, it sounds less like archaeology and more like a diagnosis I am going to spend the next week pretending not to recognize.”",
      "text_sha256": "3631b6246c119611ed11bcc5693b1df8120f76eeb835a2ca51ff693422800be8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0014",
      "chapter": 41,
      "start_offset": 2338,
      "end_offset": 2361,
      "text_exact": "“It is an observation,”",
      "text_sha256": "3d9643a6a5394083bf10fddd8f6d785e4947047e44df17cd3d7bc134e3eea5ac",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0015",
      "chapter": 41,
      "start_offset": 2374,
      "end_offset": 2426,
      "text_exact": "“I am an archaeologist. We ruin people more slowly.”",
      "text_sha256": "5389880e870e0d40dc238272ae08f952229041d8c260f70460cefea70fcb3f46",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0016",
      "chapter": 41,
      "start_offset": 3621,
      "end_offset": 3628,
      "text_exact": "“Good,”",
      "text_sha256": "38230771dc0110e9b2c42bc2a2a5ce3febd053c13f3d875fc211f97a38cb713b",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0017",
      "chapter": 41,
      "start_offset": 3659,
      "end_offset": 3770,
      "text_exact": "“If the group feels efficient this early, somebody has already decided what disagreement is allowed to matter.”",
      "text_sha256": "740f49cbf919988cc98bc17110c0aabfe9f690fa30d8351883ca71b8f8d73bb4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0018",
      "chapter": 41,
      "start_offset": 3813,
      "end_offset": 3838,
      "text_exact": "“We have fourteen hours.”",
      "text_sha256": "0f035b47df79dbfebdebc22eb0612bbc982b398113a8ea941354be5f40c7adeb",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0019",
      "chapter": 41,
      "start_offset": 3840,
      "end_offset": 3872,
      "text_exact": "“Then make the speed auditable.”",
      "text_sha256": "9c216565fdac8497eedf51e8e919e2ce50e52745fb3ace4192ab98c92da5d261",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0020",
      "chapter": 41,
      "start_offset": 4613,
      "end_offset": 4650,
      "text_exact": "“Then why do we keep using one word?”",
      "text_sha256": "ae01e321ca35e4b670f0dc118dffd1b1fe78276fd343e5ebdafc15a8d0897e81",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0021",
      "chapter": 41,
      "start_offset": 4802,
      "end_offset": 4866,
      "text_exact": "“Because one word lets people pretend the tradeoff disappeared.”",
      "text_sha256": "322f67a77199543c408e6217ec0973c2d71457fff889e0d293bb71c9afca3b33",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0022",
      "chapter": 41,
      "start_offset": 5369,
      "end_offset": 5402,
      "text_exact": "“It is closer to a brake system,”",
      "text_sha256": "bb1bd2d8c68b8af2b9f019561d5aa7a3a69932f1bbdbbb277f726667780a522e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0023",
      "chapter": 41,
      "start_offset": 5412,
      "end_offset": 5526,
      "text_exact": "“Not because brakes know the destination. Because one bad input should not be able to turn direction into impact.”",
      "text_sha256": "dc0a205e744b3d2e6dca5513dddabe7b99a43dfcf7bcf7b0b0ff6b44c9303965",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0024",
      "chapter": 41,
      "start_offset": 5569,
      "end_offset": 5736,
      "text_exact": "“That is better because I can see where the assumption entered. I can argue with an assumption; I cannot argue with a conclusion that pretends it arrived without one.”",
      "text_sha256": "ec11d9368b89dd945fa0c70c0e2e1101529faa8c7a940dd46859fa0e8b1ac460",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch41-d0025",
      "chapter": 41,
      "start_offset": 5754,
      "end_offset": 5832,
      "text_exact": "“I will record that as high praise and try not to become unbearable about it.”",
      "text_sha256": "2ec9915ef811eb9b25637241ecfc98b220f1bb6cd851a485a3480a56cc6d23b7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    }
  ]
}
