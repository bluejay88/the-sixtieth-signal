{
  "schema_version": 1,
  "chapter": 41,
  "chapter_title": "THREE VOTES",
  "chapter_sha256": "70578380ffec6be589b53ef300cd3834cfc011ac6e6438db5966a4e92114c5ed",
  "policy": "No unresolved dialogue may fall back to narrator. render_allowed remains false until human approval.",
  "counts": {
