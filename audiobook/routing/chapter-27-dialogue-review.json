  },
  "spans": [
    {
      "dialogue_id": "ch27-d0001",
      "chapter": 27,
      "start_offset": 1151,
      "end_offset": 1157,
      "text_exact": "“Why?”",
      "text_sha256": "6dc7823405b2c9acf1f403a64d9e17ac6bd8d83d609524bdfd391bdafd006205",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0002",
      "chapter": 27,
      "start_offset": 1671,
      "end_offset": 1690,
      "text_exact": "“I understand him.”",
      "text_sha256": "dc33d14391ee0935302ffd904e459ea3721d0b0d566c439d8edc69841d208c7a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0003",
      "chapter": 27,
      "start_offset": 1706,
      "end_offset": 1748,
      "text_exact": "“That's not a sentence I wanted from you.”",
      "text_sha256": "40f5dfe080be96b678a3580581de7c8c0dda6baa5dc4b7a9b96cfbcc53c912ea",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0004",
      "chapter": 27,
      "start_offset": 1750,
      "end_offset": 1785,
      "text_exact": "“Understanding is not endorsement.”",
      "text_sha256": "e6d3a130cf2801dafd8a656342e4b5ae0fefbfc9b1a0b6acdfbce1f8ead8271c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0005",
      "chapter": 27,
      "start_offset": 1787,
      "end_offset": 1814,
      "text_exact": "“It usually arrives first.”",
      "text_sha256": "cb41d92a1f45bc0b8783f50ef7dc3f0e14ecc42751bf79e64258f15e37b7d1c5",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0006",
      "chapter": 27,
      "start_offset": 1830,
      "end_offset": 1844,
      "text_exact": "“She's right.”",
      "text_sha256": "e0b67a5ff7e5c97f73fa76133d41d241b81e072bb3235e6a906f355dd3889800",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0007",
      "chapter": 27,
      "start_offset": 1870,
      "end_offset": 1926,
      "text_exact": "“Great. Everybody loves the genocide administrator now.”",
      "text_sha256": "6db0c39f5e2bcf4ab28f967e7903809f69515b65a4a22e034fb4bdaebb441cc4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0008",
      "chapter": 27,
      "start_offset": 1951,
      "end_offset": 1972,
      "text_exact": "“Stop flattening it.”",
      "text_sha256": "f3db7d178a32cac33a22b571552ff49b5d356dad0f7eb8ea59ec707cd4841bd6",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0009",
      "chapter": 27,
      "start_offset": 1974,
      "end_offset": 2000,
      "text_exact": "“He killed civilizations.”",
      "text_sha256": "dd83dafac4d459fd6d23399ae228818ee9d06e6b95b0ae546bf8df864d2e2cc2",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0010",
      "chapter": 27,
      "start_offset": 2002,
      "end_offset": 2081,
      "text_exact": "“And if we reduce him to evil, we learn nothing about why systems produce him.”",
      "text_sha256": "86b75fab596bf8c899f81d54ae7ea5d7a351474e78b85894ad6e61e6254b0b99",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0011",
      "chapter": 27,
      "start_offset": 2106,
      "end_offset": 2130,
      "text_exact": "“Tell that to the dead.”",
      "text_sha256": "87505ced721fbf417c031cc7600e4e0597780e06d2dad74e8d9090e084a56886",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0012",
      "chapter": 27,
      "start_offset": 2157,
      "end_offset": 2208,
      "text_exact": "“The dead are exactly why the explanation matters.”",
      "text_sha256": "49ff53a48a0e8d5168ade2fdf35b2a1e19cc9ab7e9f8aba520eb1f590a2cf6f8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0013",
      "chapter": 27,
      "start_offset": 2889,
      "end_offset": 2923,
      "text_exact": "“His mistake is not intervention.”",
      "text_sha256": "899c4db43363fd69659dbe28ec9bd8c71acd9ea7fa58fcb6804d7306b20c56fa",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0014",
      "chapter": 27,
      "start_offset": 2939,
      "end_offset": 2961,
      "text_exact": "“It's self-exemption.”",
      "text_sha256": "c7e7ab12237d7471382dc1f7223df00b5a96a491ccb8fe768774394364cd6c33",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0015",
      "chapter": 27,
      "start_offset": 2963,
      "end_offset": 2996,
      "text_exact": "“He treats his fear as evidence.”",
      "text_sha256": "16e682b6a9dd79281d25c2293e8180415a40f4657be8f869f69b0162a0a62ee1",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0016",
      "chapter": 27,
      "start_offset": 3009,
      "end_offset": 3032,
      "text_exact": "“Fear can be evidence.”",
      "text_sha256": "bae34c97dc4648c1b5817a4abfad2c17a947408025379360e8c861899b63e71c",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0017",
      "chapter": 27,
      "start_offset": 3034,
      "end_offset": 3056,
      "text_exact": "“Yes. But not enough.”",
      "text_sha256": "d11f42d2b062f36084508cba01b0a75dffe4faef80b8be45780a1f4d812388c5",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0018",
      "chapter": 27,
      "start_offset": 3421,
      "end_offset": 3450,
      "text_exact": "“He's minimizing worst case,”",
      "text_sha256": "e1ab59fdd16a51a9309879bacb7848a50396aaf6495e9c0f2c38f42f584cb6f8",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0019",
      "chapter": 27,
      "start_offset": 3480,
      "end_offset": 3490,
      "text_exact": "“Minimax.”",
      "text_sha256": "66aa1f62fe992314c528301cec615afed6727ed2f23778a1462c0af8f161fa56",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0020",
      "chapter": 27,
      "start_offset": 3492,
      "end_offset": 3515,
      "text_exact": "“With no cost ceiling.”",
      "text_sha256": "7b468f35fc01c56cf49af008c7d6bb1ffd9ae789cae73a5f5a82bcb8ab4df3df",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0021",
      "chapter": 27,
      "start_offset": 3539,
      "end_offset": 3549,
      "text_exact": "“Meaning?”",
      "text_sha256": "fdb7f9e055ab62c8c17c766922619db538737c3840b8c4b17f482098af007e0c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0022",
      "chapter": 27,
      "start_offset": 3551,
      "end_offset": 3648,
      "text_exact": "“If extinction is infinitely bad, almost any lesser atrocity becomes mathematically permissible.”",
      "text_sha256": "cf8cab5b0c2b8bfe93635e1a649470925376291059bae48452ecaac05a4aff83",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0023",
      "chapter": 27,
      "start_offset": 3661,
      "end_offset": 3689,
      "text_exact": "“There. That's the monster.”",
      "text_sha256": "f043362de66a386890a911d557a63325fa0024f19eb0f1266289ca903e25968d",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0024",
      "chapter": 27,
      "start_offset": 3715,
      "end_offset": 3766,
      "text_exact": "“No. That's the equation that can manufacture one.”",
      "text_sha256": "aecd9e8ad3d81945cd0435d9f4db700320b26daa97062cedc81eb27b7cc71273",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0025",
      "chapter": 27,
      "start_offset": 4201,
      "end_offset": 4220,
      "text_exact": "“That's the split.”",
      "text_sha256": "44b9b61fda9b2d46a6b5551c5eadd55da690ba4379c92b1e8afb091b2d63fbce",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0026",
      "chapter": 27,
      "start_offset": 4360,
      "end_offset": 4383,
      "text_exact": "“Translate your child.”",
      "text_sha256": "e238a57109fa91e330d26fd8ff61b8cea6a2868860ea8dbfb434b2a14d9cdca8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0027",
      "chapter": 27,
      "start_offset": 4418,
      "end_offset": 4499,
      "text_exact": "“It means saving ninety-nine people does not make the hundredth interchangeable.”",
      "text_sha256": "bb2fa6bcf9f892e926a9266a57c21240fd6ef358888e750a3f8092265f163645",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0028",
      "chapter": 27,
      "start_offset": 4512,
      "end_offset": 4558,
      "text_exact": "“But emergency policy always makes tradeoffs.”",
      "text_sha256": "9d91a67a1fafe7a063e514195db90551199c4334483d6996202893e1fff2bd0d",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0029",
      "chapter": 27,
      "start_offset": 4560,
      "end_offset": 4566,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0030",
      "chapter": 27,
      "start_offset": 4568,
      "end_offset": 4593,
      "text_exact": "“Then where is the line?”",
      "text_sha256": "da4860aecc88bf248bcb650b10a32f6bc9c75b7109db43ff3df1508c137ee286",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0031",
      "chapter": 27,
      "start_offset": 6002,
      "end_offset": 6019,
      "text_exact": "“What was funny?”",
      "text_sha256": "42988a8cb74dcb824f57b0e2efced41a7cacce51c1791c97c2cd3e3c1630d8e7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0032",
      "chapter": 27,
      "start_offset": 6046,
      "end_offset": 6094,
      "text_exact": "“The model did exactly what the input required.”",
      "text_sha256": "2b421fbcb469845466356e6a30f38a233e59e508eae2575b2c804950dcdf96d1",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0033",
      "chapter": 27,
      "start_offset": 6113,
      "end_offset": 6135,
      "text_exact": "“Okay. That is funny.”",
      "text_sha256": "6efa1cde42bea859c2327bf23314ac1790b82af12db017decc538e2c6c6e6779",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0034",
      "chapter": 27,
      "start_offset": 6670,
      "end_offset": 6698,
      "text_exact": "“They are the same problem,”",
      "text_sha256": "8b2bd65f3d5268c881e3bd71de1016e443c99c5890491ccac9539e0ee1a38571",
      "speaker": "shaal",
      "speaker_display": "Shaal-Amur",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0035",
      "chapter": 27,
      "start_offset": 6721,
      "end_offset": 6726,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0036",
      "chapter": 27,
      "start_offset": 6728,
      "end_offset": 6752,
      "text_exact": "“They share atmosphere.”",
      "text_sha256": "1084afc7ce470564ee412244610a3f09c2edf0e7a8d9adb5a86299ccc8cd4e20",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0037",
      "chapter": 27,
      "start_offset": 6754,
      "end_offset": 6760,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0038",
      "chapter": 27,
      "start_offset": 6762,
      "end_offset": 6770,
      "text_exact": "“Power.”",
      "text_sha256": "516c4fc2a3194dca010ac0937f07555ccbad48bb7ac5112cf8f3b51ed0fec172",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0039",
      "chapter": 27,
      "start_offset": 6772,
      "end_offset": 6778,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0040",
      "chapter": 27,
      "start_offset": 6780,
      "end_offset": 6790,
      "text_exact": "“Transit.”",
      "text_sha256": "a940a8d578c6f5cedc07b5903fa5dd1f6fe0f01a7a6d526a7273b6cd1e2656ce",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0041",
      "chapter": 27,
      "start_offset": 6792,
      "end_offset": 6798,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0042",
      "chapter": 27,
      "start_offset": 6800,
      "end_offset": 6826,
      "text_exact": "“Then failures propagate.”",
      "text_sha256": "3daa7d54b21b8bb5ac575258b7e004d7d694250aa1b822c303a831c7395e55dc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0043",
      "chapter": 27,
      "start_offset": 6849,
      "end_offset": 6869,
      "text_exact": "“So does authority.”",
      "text_sha256": "3c522f33cb8c01ad25db3c1e47d4946611c978ad37eeb8eacb52aa8fa4a003c9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0044",
      "chapter": 27,
      "start_offset": 16311,
      "end_offset": 16343,
      "text_exact": "“Why keep obsolete law visible?”",
      "text_sha256": "9bcc1c259497c09ea75f166e5b550887a2213eef0ebaf59814aad09c7ff66047",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0045",
      "chapter": 27,
      "start_offset": 17422,
      "end_offset": 17447,
      "text_exact": "“That is understandable.”",
      "text_sha256": "241b9de1123f8dc1e59ed8980a6404e909fb16f2961c400667a8b46bdbbd5bba",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0046",
      "chapter": 27,
      "start_offset": 17470,
      "end_offset": 17484,
      "text_exact": "“Dangerously.”",
      "text_sha256": "9d7401795fd47f8cad79907ea2dc42363f81660d89d3cdbd4dd53316b40a1d92",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0047",
      "chapter": 27,
      "start_offset": 17486,
      "end_offset": 17492,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": "seren",
      "speaker_display": "Seren",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0048",
      "chapter": 27,
      "start_offset": 17678,
      "end_offset": 17690,
      "text_exact": "“It is not.”",
      "text_sha256": "a5f0fb0c233c78d681ffec94244d5ef3910a7c3c485f6848f6671d28f5745664",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0049",
      "chapter": 27,
      "start_offset": 17692,
      "end_offset": 17706,
      "text_exact": "“It is to us.”",
      "text_sha256": "d7a7ac1d7f6e188add6af1e6dbf3e18ffe4fdc32004c6e1e7bb36c684e135828",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0050",
      "chapter": 27,
      "start_offset": 18080,
      "end_offset": 18127,
      "text_exact": "“He loved her more cleanly after she was gone.”",
      "text_sha256": "5cd6d50bf20e2faff75aa26823ee86011a5e61064fbeb173c1ddd287c4e0e158",
      "speaker": "seren",
      "speaker_display": "Seren",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0051",
      "chapter": 27,
      "start_offset": 18146,
      "end_offset": 18168,
      "text_exact": "“What does that mean?”",
      "text_sha256": "6bbea48ab979d12488c281de15f5cec8cf5c5879fae58e5e3a152e661a38ff32",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0052",
      "chapter": 27,
      "start_offset": 18170,
      "end_offset": 18227,
      "text_exact": "“He removed every contradiction that made her difficult.”",
      "text_sha256": "6b97d55fd6c9363c12b254ac999ca248e3662a59c8161e68f83a71c5d0cb6e74",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0053",
      "chapter": 27,
      "start_offset": 19336,
      "end_offset": 19387,
      "text_exact": "“Can we determine whether Shaal-Amur still exists?”",
      "text_sha256": "8c37b63b757ed59bd5d1cdcf9ecfe9751b17e5bfb8c1deb8014541b56a3bd500",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0054",
      "chapter": 27,
      "start_offset": 19399,
      "end_offset": 19434,
      "text_exact": "“Any archive references to return?”",
      "text_sha256": "3264da3ca4742f7211d6ed77e35eb713129e03a1c72b0e02bc26ff1cdbacbcfb",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0055",
      "chapter": 27,
      "start_offset": 19542,
      "end_offset": 19565,
      "text_exact": "“That sounds like yes.”",
      "text_sha256": "cfb148cfb029a4d6e7f48b5536dff3c028c19ff983929bf2abb96a0920ea0d51",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0056",
      "chapter": 27,
      "start_offset": 19579,
      "end_offset": 19617,
      "text_exact": "“It sounds like a protocol condition.”",
      "text_sha256": "edcaf92e4ad50a428e2fdf16c0610f2e09e393660385f4938a3e444f410eaa98",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0057",
      "chapter": 27,
      "start_offset": 19974,
      "end_offset": 20004,
      "text_exact": "“If the protocol is active...”",
      "text_sha256": "dedde59fc168caf15cf7a2044e048d1260afdd6fa0622d8084701e067d09706e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0058",
      "chapter": 27,
      "start_offset": 20025,
      "end_offset": 20081,
      "text_exact": "“Then opening the archive may not have summoned anyone.”",
      "text_sha256": "d8b806395ae6cdc29b699780c6d4506da418f92487a942041810eb98e643517e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0059",
      "chapter": 27,
      "start_offset": 20110,
      "end_offset": 20127,
      "text_exact": "“What did it do?”",
      "text_sha256": "6fa58976a738a748c96e2ad60446d328215a2df2f53a194f8b638c290f7a23a2",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0060",
      "chapter": 27,
      "start_offset": 20691,
      "end_offset": 20718,
      "text_exact": "“What would you have done?”",
      "text_sha256": "21fe49cbc0f5a4d08c562e5e1bc96f7c3a762532dcd93df27d5748a0513874dd",
      "speaker": "shaal",
      "speaker_display": "Shaal-Amur",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0061",
      "chapter": 27,
      "start_offset": 20814,
      "end_offset": 20851,
      "text_exact": "“If the evidence were strong enough?”",
      "text_sha256": "34fd3076768f33e4ad78c6dd6f10d562ab94a875182d0c1ffeb8673d515f86df",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0062",
      "chapter": 27,
      "start_offset": 20853,
      "end_offset": 20884,
      "text_exact": "“Do not hide behind threshold.”",
      "text_sha256": "c743cc60248581e7722785d9b61f100d87c64605e7a7158b6945ff4e36e0a0d1",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0063",
      "chapter": 27,
      "start_offset": 20922,
      "end_offset": 20943,
      "text_exact": "“I would have acted.”",
      "text_sha256": "9fc7a60e285b62a474ec84873426b034365fe16900bcd95a82775b03f6fa0804",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0064",
      "chapter": 27,
      "start_offset": 20976,
      "end_offset": 21009,
      "text_exact": "“Then we differ only in courage.”",
      "text_sha256": "0584fd001326561ed158f55ae1c55f7e487466814276c3e5caec614c0bb6f677",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0065",
      "chapter": 27,
      "start_offset": 21011,
      "end_offset": 21016,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0066",
      "chapter": 27,
      "start_offset": 21043,
      "end_offset": 21077,
      "text_exact": "“We differ in what happens after.”",
      "text_sha256": "b7e36cdec473a97d7b715c8ac4475bafd4a7179838332e743fd8e5dc84a007d2",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0067",
      "chapter": 27,
      "start_offset": 21132,
      "end_offset": 21232,
      "text_exact": "“You survived one crisis by breaking procedure. Then you converted the exception into a philosophy.”",
      "text_sha256": "1475c13464515c96ceafbc39fa001897204479f8eb59b08fd83f2c2b82a2ff2e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0068",
      "chapter": 27,
      "start_offset": 21234,
      "end_offset": 21263,
      "text_exact": "“I learned that delay kills.”",
      "text_sha256": "a936de41f5ec9c1f0ee362f9d9fdc6eae2b6cff46323fcd0acf2119404f7832e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0069",
      "chapter": 27,
      "start_offset": 21265,
      "end_offset": 21310,
      "text_exact": "“And then you began seeing delay everywhere.”",
      "text_sha256": "6bffbe22f17022fd624605b1ecc12a7a0794c01178768d4aae2222af50370154",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0070",
      "chapter": 27,
      "start_offset": 21355,
      "end_offset": 21415,
      "text_exact": "“My people do not have the luxury of forgetting extinction.”",
      "text_sha256": "b577789ca4c5da75fcabf31012c4a3d5baa7e5546ab3b8750453744101aff536",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0071",
      "chapter": 27,
      "start_offset": 21506,
      "end_offset": 21532,
      "text_exact": "“You did not learn mercy,”",
      "text_sha256": "7ef09c5e84464a884b54d5018627fa4f12b769e1ad00bdbfc41f5f9c85450c60",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0072",
      "chapter": 27,
      "start_offset": 21543,
      "end_offset": 21564,
      "text_exact": "“You learned terror.”",
      "text_sha256": "b6b88b16a85eed262aff28047e287f89b43f092e2fb876e9f07380291c470982",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0073",
      "chapter": 27,
      "start_offset": 21602,
      "end_offset": 21654,
      "text_exact": "“I learned mercy from one who could not survive it.”",
      "text_sha256": "3af0f9e095faf8957a2787c389fe0fecd86f24175676e58f0d9a1e1e1defd5d8",
      "speaker": "shaal",
      "speaker_display": "Shaal-Amur",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0074",
      "chapter": 27,
      "start_offset": 22078,
      "end_offset": 22103,
      "text_exact": "“She was my counterpart.”",
      "text_sha256": "22f5448cd0a6a0023ee7fbfb6ac27bb228d5a791be026bf1ed2b73ca79a70961",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0075",
      "chapter": 27,
      "start_offset": 22118,
      "end_offset": 22128,
      "text_exact": "“Partner?”",
      "text_sha256": "f379cafb3ebd3ff38c8aa35c67eb8e1301c799c55aa917704183478bdd8099e7",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0076",
      "chapter": 27,
      "start_offset": 22130,
      "end_offset": 22135,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0077",
      "chapter": 27,
      "start_offset": 22137,
      "end_offset": 22147,
      "text_exact": "“Sibling?”",
      "text_sha256": "e1a1bbdc5d161365169c8f1fb3211d0a21343c4ad5a1672b86628cc1f2f4deb2",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0078",
      "chapter": 27,
      "start_offset": 22149,
      "end_offset": 22154,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0079",
      "chapter": 27,
      "start_offset": 22156,
      "end_offset": 22168,
      "text_exact": "“Colleague?”",
      "text_sha256": "e87948b5832d9bc4354d59d9e394d153bdcdf4e586ab54e509155a62d51e735a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0080",
      "chapter": 27,
      "start_offset": 22170,
      "end_offset": 22185,
      "text_exact": "“Insufficient.”",
      "text_sha256": "24212f0b85382cee6d71734e98760527b0620b6c51caf263778d0bdb54a2f9c6",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0081",
      "chapter": 27,
      "start_offset": 22208,
      "end_offset": 22251,
      "text_exact": "“Relationship without equivalent category.”",
      "text_sha256": "a0ee4ceac4ef3b6cb8e08df77b974c63100e09a6f8246049e787c2225b06e12c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0082",
      "chapter": 27,
      "start_offset": 22815,
      "end_offset": 22862,
      "text_exact": "“If I had acted earlier, she would have lived.”",
      "text_sha256": "ec602abc301b2f0610993da9a8f692ef60e023b6cc8221078fe52df16892806b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0083",
      "chapter": 27,
      "start_offset": 22881,
      "end_offset": 22904,
      "text_exact": "“You do not know that.”",
      "text_sha256": "9ab88f740f3c117d45e33bae408b01960336ae0a673941d9c593b59610c1eafe",
      "speaker": "seren",
      "speaker_display": "Seren",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0084",
      "chapter": 27,
      "start_offset": 22906,
      "end_offset": 22922,
      "text_exact": "“I know enough.”",
      "text_sha256": "46395e1644831bc4cffb5ed0f04c7a25286b90683694af90eea6d33bce32be6d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0085",
      "chapter": 27,
      "start_offset": 22924,
      "end_offset": 22929,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch27-d0086",
      "chapter": 27,
      "start_offset": 22951,
      "end_offset": 23019,
      "text_exact": "“You built a civilization around never hearing that sentence again.”",
      "text_sha256": "6d61884d0796068dcc9863ea78e0e0131917b94268c0e9b05626ff3d61058649",
