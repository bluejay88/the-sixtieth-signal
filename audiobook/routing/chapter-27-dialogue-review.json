{
  "schema_version": 1,
  "chapter": 27,
  "chapter_title": "THE MERCY DOCTRINE",
  "chapter_sha256": "a9624bd99eb3259fdc65df00409a3dd1141cc9760412c4a67d3dd341da0b4ef0",
  "policy": "No unresolved dialogue may fall back to narrator. render_allowed remains false until human approval.",
  "counts": {
    "dialogue_spans": 88,
