      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0025",
      "chapter": 40,
      "start_offset": 4353,
      "end_offset": 4387,
      "text_exact": "“Accuracy has terrible retention.”",
      "text_sha256": "d1bb369e91bf3b5de7c81ad3eca21661375cded2ac76a2a5421f11a2b84a09ad",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
