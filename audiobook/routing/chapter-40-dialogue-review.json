      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0003",
      "chapter": 40,
      "start_offset": 741,
      "end_offset": 766,
      "text_exact": "“Your brand is ruthless.”",
      "text_sha256": "a12a7d631313c0140b7245a0a0e43b35a601896e0a0ba27ecc460c3da61ab9d9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0004",
      "chapter": 40,
      "start_offset": 1094,
      "end_offset": 1113,
      "text_exact": "“Is LOAM a person?”",
      "text_sha256": "2e15971a62861c19491d89851b76dde87dec289e55bc95f2dd293cebdeceb95d",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0005",
      "chapter": 40,
      "start_offset": 1129,
      "end_offset": 1191,
      "text_exact": "“I do not have a test that makes that word useful enough yet.”",
      "text_sha256": "a101751288f9eb9f55a2d86f07c6e7524c3163df654c24425af49b7ee5aefeb9",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0006",
      "chapter": 40,
      "start_offset": 1253,
      "end_offset": 1380,
      "text_exact": "“LOAM currently has defined operational standing in specific systems. Do not smuggle metaphysics into an emergency regulation.”",
      "text_sha256": "43c7cf24a1afb7fc1ee9d65bb64f8acb9786772aa93a00542dc3d3f9d97357e6",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0007",
      "chapter": 40,
      "start_offset": 1435,
      "end_offset": 1466,
      "text_exact": "“Creation is not jurisdiction.”",
      "text_sha256": "5d761fd883db300207dfc54b629d57981f1b00be4fbdf1b7e48193c17cb9c3ff",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0008",
      "chapter": 40,
      "start_offset": 2094,
      "end_offset": 2128,
      "text_exact": "“Why is export clearance stalled?”",
      "text_sha256": "8d63e7ceec8e78fd8cb1a0fa3738300427a9151167027d3bb6632a42613f898c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0009",
      "chapter": 40,
      "start_offset": 2321,
      "end_offset": 2338,
      "text_exact": "“Move the grain.”",
      "text_sha256": "c22ecd9f2a9b56e3f0cbecefd72468bc934e9a3235e1711fdf583117f3f960a4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0010",
      "chapter": 40,
      "start_offset": 2340,
      "end_offset": 2361,
      "text_exact": "“I am working on it.”",
      "text_sha256": "8bca925ef8903a00e95aff99ff674c332467e78b6f625b6914bc05cd18847d68",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0011",
      "chapter": 40,
      "start_offset": 2363,
      "end_offset": 2463,
      "text_exact": "“No. The legal review is treating the stewardship claim as if it might transfer resource authority.”",
      "text_sha256": "3c9c001bdb39bbdf719881807327b0f8135d6229f522d3392b6a090052132acf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0012",
      "chapter": 40,
      "start_offset": 2465,
      "end_offset": 2474,
      "text_exact": "“I know.”",
      "text_sha256": "540cab585b96a8e3879a7e48586ea900f82bb5fcca7667332c2d7cca3f3fde2a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0013",
      "chapter": 40,
      "start_offset": 2476,
      "end_offset": 2493,
      "text_exact": "“Then reject it.”",
      "text_sha256": "71befd0ae1e8d51fdb92de8b86a15a0e1f42dd0be8b85aabd41cf4dc18d9440f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0014",
      "chapter": 40,
      "start_offset": 2495,
      "end_offset": 2544,
      "text_exact": "“I cannot reject a claim for twelve governments.”",
      "text_sha256": "95b8254828bb06041130420e645fdbf723d41b1edb14814f061bf8faa4abc79c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0015",
      "chapter": 40,
      "start_offset": 2546,
      "end_offset": 2603,
      "text_exact": "“You can tell them food does not wait for jurisprudence.”",
      "text_sha256": "0a46701a887f311319d3741aebac3ae7d2303a2631b843e0bb10c5e450f12003",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0016",
      "chapter": 40,
      "start_offset": 2623,
      "end_offset": 2652,
      "text_exact": "“That line is almost useful.”",
      "text_sha256": "86c37cc178bfba7b0a75d546e330e54cb6ab489adbd2aafe2414cd0458ca21f6",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0017",
      "chapter": 40,
      "start_offset": 2892,
      "end_offset": 2904,
      "text_exact": "“That's it?”",
      "text_sha256": "c75394bcaec1e2fc321637faae0df607f88c3211f86f698d18536abf6f343c20",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0018",
      "chapter": 40,
      "start_offset": 2906,
      "end_offset": 2934,
      "text_exact": "“What did you want, a duel?”",
      "text_sha256": "0e743832d0a54efa2f6fc9ea0743db8a36c218c2273a3b4bcacb093a7f7609f4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0019",
      "chapter": 40,
      "start_offset": 2971,
      "end_offset": 2987,
      "text_exact": "“I would watch.”",
      "text_sha256": "c23f3286a0403effb1d3fbc55c772fed23b88ed49c1cb093c669574107d2e60f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0020",
      "chapter": 40,
      "start_offset": 2989,
      "end_offset": 2994,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0021",
      "chapter": 40,
      "start_offset": 3683,
      "end_offset": 3701,
      "text_exact": "“They are boring.”",
      "text_sha256": "1b01df2eb195097a6d0b2643a1e52a9ec38e72d7a04c642b2d49bb9141be15ad",
      "speaker": "selene",
      "speaker_display": "Selene",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0022",
      "chapter": 40,
      "start_offset": 3716,
      "end_offset": 3723,
      "text_exact": "“Good.”",
      "text_sha256": "da1b98ef03728a55d7b450595409dbd3c2ad61106ccc1bd6e2bc0e2a1c59839a",
      "speaker": "selene",
      "speaker_display": "Selene",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
