    },
    {
      "dialogue_id": "ch40-d0002",
      "chapter": 40,
      "start_offset": 728,
      "end_offset": 739,
      "text_exact": "“Accurate.”",
      "text_sha256": "922f549dbb3332c96c7664a350e31baa932f09133351af20b21566d59cb1853f",
      "speaker": null,
      "speaker_display": null,
