      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch40-d0024",
      "chapter": 40,
      "start_offset": 4148,
      "end_offset": 4190,
      "text_exact": "“We reported forty-seven. That was wrong.”",
      "text_sha256": "fab4b7c4da51f443501bb13f759a09bff1d62bea80df0bccb107be0bfcac5d6f",
      "speaker": null,
      "speaker_display": null,
