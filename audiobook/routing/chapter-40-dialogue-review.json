    {
      "dialogue_id": "ch40-d0023",
      "chapter": 40,
      "start_offset": 4038,
      "end_offset": 4093,
      "text_exact": "“We have a revised confirmed death count. Forty-three.”",
      "text_sha256": "ef7494b4f43535a508606978e27cef8fa3a0248718f76e53b1512554bba5f866",
      "speaker": null,
      "speaker_display": null,
