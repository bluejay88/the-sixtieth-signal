    },
    {
      "dialogue_id": "ch33-d0044",
      "chapter": 33,
      "start_offset": 7284,
      "end_offset": 7294,
      "text_exact": "“Explain.”",
      "text_sha256": "25e422df7f7fe3c4a2ba6f9434d9ae967e561cb1aa6468a08431f27579af19de",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0045",
      "chapter": 33,
      "start_offset": 7428,
      "end_offset": 7468,
      "text_exact": "“The system isn’t asking them to agree.”",
      "text_sha256": "e078aa8be42a232bd6133ff65b8ec996889ca4d301dfb42075f20ee8e108a961",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0046",
      "chapter": 33,
      "start_offset": 7485,
      "end_offset": 7557,
      "text_exact": "“It is asking them to recognize one another as legitimate participants.”",
      "text_sha256": "9a649e8f9d6345da1ef1f7a61b827c8bd9c36df3faee882255013dc33c5947ab",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0047",
      "chapter": 33,
      "start_offset": 8345,
      "end_offset": 8377,
      "text_exact": "“Did one derive from the other?”",
      "text_sha256": "1c9e4b989dafe585ef80a38e541b0b9bd513db4cfe6e38dc6e4aa3c0ec9c04d7",
      "speaker": "loam",
      "speaker_display": "LOAM",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0048",
      "chapter": 33,
      "start_offset": 8747,
      "end_offset": 8773,
      "text_exact": "“That is the entire book.”",
      "text_sha256": "2b89c921ea9ffa6777b5a97a8b21e0c0a1139ac9e53081434da6b99c15080432",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0049",
      "chapter": 33,
      "start_offset": 8797,
      "end_offset": 8804,
      "text_exact": "“What?”",
      "text_sha256": "bf9ee250242dc9be6ae8a64cb636db6ea70186d990757358b8947787279f47cc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0050",
      "chapter": 33,
      "start_offset": 8806,
      "end_offset": 8841,
      "text_exact": "“The hidden stories are witnesses.”",
      "text_sha256": "ad0f716267e113855864b4d59c0430a5062a56ab10b412024c310730ada9f1c4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0051",
      "chapter": 33,
      "start_offset": 8969,
      "end_offset": 8996,
      "text_exact": "“Do not say that publicly.”",
      "text_sha256": "972c9a5a4d636b5e76f62962d69e4b99f909340ee4d072364ba42c840bb2c837",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0052",
      "chapter": 33,
      "start_offset": 8998,
      "end_offset": 9004,
      "text_exact": "“Why?”",
      "text_sha256": "6dc7823405b2c9acf1f403a64d9e17ac6bd8d83d609524bdfd391bdafd006205",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0053",
      "chapter": 33,
      "start_offset": 9006,
      "end_offset": 9055,
      "text_exact": "“Because then readers will start counting pages.”",
      "text_sha256": "37a77aa23136a459503e6a2530fb1b90e6c65f1cfbc71e83c4fa5df168877838",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0054",
      "chapter": 33,
      "start_offset": 9443,
      "end_offset": 9520,
      "text_exact": "“LOAM, what claim from me would you reject even if I used founder authority?”",
      "text_sha256": "fa3c53ef4c59d9dd8d6a8cb53597742fc5a9d585809a5813addf2458e3f933e3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0055",
      "chapter": 33,
      "start_offset": 9648,
      "end_offset": 9696,
      "text_exact": "“Even if suppression improves public stability?”",
      "text_sha256": "827be262737115c4917b33d49ddd8c5e092722275aa630b905a9d230834820a0",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0056",
      "chapter": 33,
      "start_offset": 9704,
      "end_offset": 9756,
      "text_exact": "“Even if I believe the contradiction is misleading?”",
      "text_sha256": "0aceed091a5b5f201827fe050351b5e6777e8a8c64aac8552df17ede0a892cf0",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0057",
      "chapter": 33,
      "start_offset": 9843,
      "end_offset": 9866,
      "text_exact": "“That is Seren's rule.”",
      "text_sha256": "240b58a222c0577fc900265dcb9a2648f62a3e803400edbebc4ad6264ee458f8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0058",
      "chapter": 33,
      "start_offset": 9868,
      "end_offset": 9887,
      "text_exact": "“No direct access.”",
      "text_sha256": "a68beb063701ccb5ae53a59897719cee32bbb0f0c234afe097dc294514d57892",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
