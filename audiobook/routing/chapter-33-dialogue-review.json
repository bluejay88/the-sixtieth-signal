  "spans": [
    {
      "dialogue_id": "ch33-d0001",
      "chapter": 33,
      "start_offset": 1371,
      "end_offset": 1403,
      "text_exact": "“That is disturbingly literary.”",
      "text_sha256": "a43b9f8e16168ac5931011767164dc193fd7a7bde4bda34c819517894010762f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0002",
      "chapter": 33,
      "start_offset": 1405,
      "end_offset": 1427,
      "text_exact": "“It’s selection bias.”",
      "text_sha256": "9efb0ad705888a5eb4d994050a3126ff6c0451282e6789372ecdffc5bc8a5518",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0003",
      "chapter": 33,
      "start_offset": 1451,
      "end_offset": 1462,
      "text_exact": "“Possibly.”",
      "text_sha256": "237771152ff4ce49ca9430bdcee47d257fff91339c4e84c22dc0a740dad87062",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0004",
      "chapter": 33,
      "start_offset": 1464,
      "end_offset": 1558,
      "text_exact": "“LOAM has thousands of internal entries. If we search enough, we can find apparent responses.”",
      "text_sha256": "e30fb710601d649f3173a7acd5a1bf587903ed2e3c216bf6b47d42e3771bac8c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0005",
      "chapter": 33,
      "start_offset": 1560,
      "end_offset": 1596,
      "text_exact": "“Which is why we blinded the match.”",
      "text_sha256": "bfb3221b49228ab21bbbc067d249a96d555816f0b114992078f0ad6138151f5c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0006",
      "chapter": 33,
      "start_offset": 1950,
      "end_offset": 1982,
      "text_exact": "“Could the archive be adapting?”",
      "text_sha256": "794df86c62ffc53d439e54caefcb820249b770c4eb53cdc1f9dc3f8ccef78f51",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0007",
      "chapter": 33,
      "start_offset": 1984,
      "end_offset": 1998,
      "text_exact": "“No evidence,”",
      "text_sha256": "2af75cf8842c6c2c2730b635c3d85d33e7ad591d5fac3f7144bffa2ace11f500",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0008",
      "chapter": 33,
      "start_offset": 2018,
      "end_offset": 2043,
      "text_exact": "“Could LOAM be adapting?”",
      "text_sha256": "609f32487a3074393e5977651fa9615165f7c5b4524a49aac0521c6ea7506be7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0009",
      "chapter": 33,
      "start_offset": 2045,
      "end_offset": 2051,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0010",
      "chapter": 33,
      "start_offset": 2124,
      "end_offset": 2154,
      "text_exact": "“It is definitely your child.”",
      "text_sha256": "52f6c2ed830eec36ba41178e2f81eb190dd052e6d0d9c1261ccb3158b6169d4d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0011",
      "chapter": 33,
      "start_offset": 2603,
      "end_offset": 2656,
      "text_exact": "“That one goes public and the planet loses its mind.”",
      "text_sha256": "b6309e34531118083e91985fc47daf6f9c78227ff04dad977229ee8c92de09ab",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0012",
      "chapter": 33,
      "start_offset": 2669,
      "end_offset": 2693,
      "text_exact": "“It does not go public.”",
      "text_sha256": "0382336cbf568cfc5f512868b33e286796bcc7443309c4a1dc331c9d1109a148",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0013",
      "chapter": 33,
      "start_offset": 2716,
      "end_offset": 2737,
      "text_exact": "“Temporary sentence?”",
      "text_sha256": "8d6e0310f1bb821c198d911bea6a45294305241aea1a0050eab24c4a3c5fced8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0014",
      "chapter": 33,
      "start_offset": 2808,
      "end_offset": 2889,
      "text_exact": "“You keep wanting the layers to agree because agreement feels like confirmation,”",
      "text_sha256": "4ad952afb82051178203eb74b9a6971927c74f93c83645b82c573353eddc91a9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0015",
      "chapter": 33,
      "start_offset": 2900,
      "end_offset": 3045,
      "text_exact": "“But if they were generated by different witnesses under different pressures, disagreement may be the part that tells us which pressure existed.”",
      "text_sha256": "1a84ec25b3d7b0b1a3140f4b8511d5e559cc8d84a5463d32a61fbc51db6b9b68",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0016",
      "chapter": 33,
      "start_offset": 3095,
      "end_offset": 3126,
      "text_exact": "“So the mismatch is not noise.”",
      "text_sha256": "71de2651e16915681fb22c8dd7133584218f841a1cc58e4c03b865924316b747",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0017",
      "chapter": 33,
      "start_offset": 3127,
      "end_offset": 3194,
      "text_exact": "“Sometimes it is. That is why this is harder than having a slogan.”",
      "text_sha256": "6ea663bd734edf1b61b3c8fc3f4a0a0063eeeae845a874a49ea170486c2f60d4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0018",
      "chapter": 33,
      "start_offset": 3633,
      "end_offset": 3640,
      "text_exact": "“LOAM,”",
      "text_sha256": "f1fc021bf3a6b30e33789c9bb4aaad16fa86edf680b0e64007283055be40a91a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0019",
      "chapter": 33,
      "start_offset": 3650,
      "end_offset": 3700,
      "text_exact": "“did you generate that revision because of Seren?”",
      "text_sha256": "8ac05208c988c3d9b6a7d533c3e7339e8a0f05473238fd49ba754c0d36f2212b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0020",
      "chapter": 33,
      "start_offset": 3714,
      "end_offset": 3724,
      "text_exact": "“Explain.”",
      "text_sha256": "25e422df7f7fe3c4a2ba6f9434d9ae967e561cb1aa6468a08431f27579af19de",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0021",
      "chapter": 33,
      "start_offset": 3812,
      "end_offset": 3832,
      "text_exact": "“Which distinction?”",
      "text_sha256": "9feda2c39c8d7fca91198c2b5a28d34817cee31dcc04f75d19493db90e1e7f7f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0022",
      "chapter": 33,
      "start_offset": 3917,
      "end_offset": 3948,
      "text_exact": "“There goes half of human law.”",
      "text_sha256": "b3ceefcd717148797f8c9cf5a0fae693d261c7874e86eb5baa2c89f8248f74fe",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0023",
      "chapter": 33,
      "start_offset": 3972,
      "end_offset": 4028,
      "text_exact": "“Human law already separates parenthood from ownership.”",
      "text_sha256": "8eaa105352702e99b711154b710453ba58edd2b5a575abca52ab9ae288ad8989",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0024",
      "chapter": 33,
      "start_offset": 4030,
      "end_offset": 4049,
      "text_exact": "“Not software law.”",
      "text_sha256": "f6fd88edebf271dfa7a0a143e5da0923582ac3ccd53a2c7ad84622c258663486",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0025",
      "chapter": 33,
      "start_offset": 4076,
      "end_offset": 4108,
      "text_exact": "“You’re enjoying this too much.”",
      "text_sha256": "2ad0f2e1aba2a09e64a5e27e448253e68c20eb3bab2066853d751d6a657d4e96",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0026",
      "chapter": 33,
      "start_offset": 4110,
      "end_offset": 4189,
      "text_exact": "“I am enjoying watching someone else’s regulatory problem become metaphysical.”",
      "text_sha256": "c308f68cd28effca2649dff88521396e0b040980c084be59cd7652c35a4e0d0b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0027",
      "chapter": 33,
      "start_offset": 5046,
      "end_offset": 5107,
      "text_exact": "“So the two hidden stories really are talking to each other.”",
      "text_sha256": "dbe6757a27b5c58e66e520c484153f9a4fae403caf12fae360a36c8cad630ac4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0028",
      "chapter": 33,
      "start_offset": 5109,
      "end_offset": 5114,
      "text_exact": "“No,”",
      "text_sha256": "0a405d0f063d8a504bcc2dbc25e87880c12d00e2e4284e04b69c64f5d8f7a73a",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0029",
      "chapter": 33,
      "start_offset": 5128,
      "end_offset": 5151,
      "text_exact": "“They are not talking.”",
      "text_sha256": "d32691cafeba224b979bd2cb089098f15585815077ca5c74b556d5e0b964e61e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0030",
      "chapter": 33,
      "start_offset": 5153,
      "end_offset": 5189,
      "text_exact": "“What is the less exciting version?”",
      "text_sha256": "13ff91eec90a04e71406f2669972e2356bba9482b48fb19f3ff59b7929e6fd7b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0031",
      "chapter": 33,
      "start_offset": 5191,
      "end_offset": 5260,
      "text_exact": "“They are reaching compatible constraints from independent evidence.”",
      "text_sha256": "82d9033b8c49030b5aa217ae802f0fd544c336447ced64ca493e5ee72f111039",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0032",
      "chapter": 33,
      "start_offset": 5262,
      "end_offset": 5281,
      "text_exact": "“Exactly. Talking.”",
      "text_sha256": "ab34a1528de4c43327cdd04048671082bc0aadb25ab5d015f1e6050f18cd5f1c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0033",
      "chapter": 33,
      "start_offset": 5919,
      "end_offset": 6008,
      "text_exact": "“If we ever publish all three, they cannot be presented as one canonical reconstruction.”",
      "text_sha256": "8a0bf82408746c8f185bba488adf3d7989d44c0f6b31fb5708ab170d768dc8ad",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0034",
      "chapter": 33,
      "start_offset": 6034,
      "end_offset": 6040,
      "text_exact": "“Why?”",
      "text_sha256": "6dc7823405b2c9acf1f403a64d9e17ac6bd8d83d609524bdfd391bdafd006205",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0035",
      "chapter": 33,
      "start_offset": 6042,
      "end_offset": 6096,
      "text_exact": "“Because then an editor becomes the fourth authority.”",
      "text_sha256": "f311035c76579f63a6c2272423b8a416e535b49a054a124902b750f8d11e20af",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0036",
      "chapter": 33,
      "start_offset": 6112,
      "end_offset": 6181,
      "text_exact": "“That may be the nerdiest sentence anyone has said in this facility.”",
      "text_sha256": "31db5abed652297549c9d09d8d6b71d8c3fd08f2c3f9c2ae321a5db0ee365a04",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0037",
      "chapter": 33,
      "start_offset": 6183,
      "end_offset": 6204,
      "text_exact": "“It is also correct.”",
      "text_sha256": "5e4582e0b878d5c345a0fec03cdb7f827025f070bc82de6fc5a126a9d7143d31",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0038",
      "chapter": 33,
      "start_offset": 6415,
      "end_offset": 6445,
      "text_exact": "“You have invented footnotes.”",
      "text_sha256": "5fe9b6a9f99019c5383e4d5adb1fcd3eed85aeddf46928fdec82b35466902209",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0039",
      "chapter": 33,
      "start_offset": 6471,
      "end_offset": 6510,
      "text_exact": "“We invented survival-grade footnotes.”",
      "text_sha256": "caa4d3d52a3dbbf231ae5bbb5b2f1273eb4bcf417f465aedad40718f89564a61",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0040",
      "chapter": 33,
      "start_offset": 7095,
      "end_offset": 7102,
      "text_exact": "“What?”",
      "text_sha256": "bf9ee250242dc9be6ae8a64cb636db6ea70186d990757358b8947787279f47cc",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0041",
      "chapter": 33,
      "start_offset": 7119,
      "end_offset": 7138,
      "text_exact": "“That is not four.”",
      "text_sha256": "271578be1ab8790ca1de831fb9583f2f5755d387744d234a98908160d9de9e1b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0042",
      "chapter": 33,
      "start_offset": 7140,
      "end_offset": 7153,
      "text_exact": "“What is it?”",
      "text_sha256": "c8b89bfbb71a4de5704727d71604b81e1cb44e37603b1107efbaac94b626d245",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch33-d0043",
      "chapter": 33,
      "start_offset": 7174,
      "end_offset": 7198,
      "text_exact": "“A relationship marker.”",
      "text_sha256": "246a063acc504ec1233ee3451106a59c60ab55e34cd7ce6faba679c806941f44",
      "speaker": null,
