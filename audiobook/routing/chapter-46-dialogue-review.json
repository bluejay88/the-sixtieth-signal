  "chapter": 46,
  "chapter_title": "THE HUMAN VARIABLE",
  "chapter_sha256": "3699193ef2dcd91a03e28c247ddf467785ed4e4b3f9ec3aa90b0f1a0366e355a",
  "policy": "No unresolved dialogue may fall back to narrator. render_allowed remains false until human approval.",
