  "spans": [
    {
      "dialogue_id": "ch46-d0001",
      "chapter": 46,
      "start_offset": 1117,
      "end_offset": 1159,
      "text_exact": "“We do not need to beat every reset node.”",
      "text_sha256": "aa2c500a3941c1da4143da6aa6bd48e93e777578dc1d53de647d283aa34fc566",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0002",
      "chapter": 46,
      "start_offset": 1199,
      "end_offset": 1217,
      "text_exact": "“What do we need?”",
      "text_sha256": "0d7d983e1ad4eeab38a84ee8f95f4e47137358cca7d85d8b155b84626b5da7ed",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0003",
      "chapter": 46,
      "start_offset": 1219,
      "end_offset": 1244,
      "text_exact": "“Make reset ineffective.”",
      "text_sha256": "191a0b6be5b3dbb43d694389447f1f39b7de470510b7179f5fee5e793bb43c3a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0004",
      "chapter": 46,
      "start_offset": 1246,
      "end_offset": 1252,
      "text_exact": "“How?”",
      "text_sha256": "036b3bfdf8856fad1588a4ab6947733c67446f422d26cdcd70bf24d3478b6e77",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0005",
      "chapter": 46,
      "start_offset": 1254,
      "end_offset": 1278,
      "text_exact": "“Stop being one system.”",
      "text_sha256": "19927f292a4f6d7f5061695327d8517af90bca196f34de845c294f894c35cb28",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0006",
      "chapter": 46,
      "start_offset": 1309,
      "end_offset": 1350,
      "text_exact": "“That sounds terrible for globalization.”",
      "text_sha256": "10593247024d270bc2c81fa6269a7dc1faca3f01701a6a24508927111fe4588b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0007",
      "chapter": 46,
      "start_offset": 1352,
      "end_offset": 1403,
      "text_exact": "“It is terrible for certain kinds of optimization.”",
      "text_sha256": "2aa8f31ec7ed7e2ada2ce7bce09ead7b366f2fce6ff9d6dbc62e34a5cf2236b1",
      "speaker": "loam",
      "speaker_display": "LOAM",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0008",
      "chapter": 46,
      "start_offset": 2834,
      "end_offset": 2864,
      "text_exact": "“You have proven my argument.”",
      "text_sha256": "cd758d067a03f2e57cd547bac8a893a93f64c060c29aacfba6f712f6137ca20d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0009",
      "chapter": 46,
      "start_offset": 2890,
      "end_offset": 2896,
      "text_exact": "“How?”",
      "text_sha256": "036b3bfdf8856fad1588a4ab6947733c67446f422d26cdcd70bf24d3478b6e77",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0010",
      "chapter": 46,
      "start_offset": 2898,
      "end_offset": 2952,
      "text_exact": "“Your civilization survives by becoming less unified.”",
      "text_sha256": "4a0314cb36f545d5d5a7f2bec221075d6b406a9bb01ec3ef95e5b2d80fd9abbb",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0011",
      "chapter": 46,
      "start_offset": 2954,
      "end_offset": 2997,
      "text_exact": "“No. It survives by becoming less brittle.”",
      "text_sha256": "4bb8e5e88d52de6e8ee9a78af0c465fbaea060999e972e50fe9bf6652a838fa6",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0012",
      "chapter": 46,
      "start_offset": 2999,
      "end_offset": 3024,
      "text_exact": "“Difference in language.”",
      "text_sha256": "65edcc55b2d6600418722c5a1350f629d0bef86e8b74cedf5ba7a6d6c5fb1256",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0013",
      "chapter": 46,
      "start_offset": 3026,
      "end_offset": 3048,
      "text_exact": "“Difference in power.”",
      "text_sha256": "86db12714019c643c7971206bbbf00583059d30d182a9be3944f45a6368eeff7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0014",
      "chapter": 46,
      "start_offset": 3098,
      "end_offset": 3211,
      "text_exact": "“You call divergence dangerous because disagreement slows obedience. But diversity is why your reset is failing.”",
      "text_sha256": "76eba3b48ef3247057d3f0cf7d2daf2514614870eb4e7b616d35fd879350259a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0015",
      "chapter": 46,
      "start_offset": 3213,
      "end_offset": 3246,
      "text_exact": "“It is also why your wars occur.”",
      "text_sha256": "76eb30e7f246a7a1e077861a6c6a731b87cf029f18b02bc817eb2e1ec849ba66",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0016",
      "chapter": 46,
      "start_offset": 3248,
      "end_offset": 3254,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0017",
      "chapter": 46,
      "start_offset": 3256,
      "end_offset": 3286,
      "text_exact": "“And your religions fracture.”",
      "text_sha256": "71d2b7be5add57b78661867a95ba820a0c8bbfe9ce91b66e83c24384060133ed",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0018",
      "chapter": 46,
      "start_offset": 3288,
      "end_offset": 3294,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0019",
      "chapter": 46,
      "start_offset": 3296,
      "end_offset": 3321,
      "text_exact": "“And your politics fail.”",
      "text_sha256": "2b51bd03ee7710ebc66455c58710eb82b29bf0bbebd3860fb58e9b0144d296c1",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0020",
      "chapter": 46,
      "start_offset": 3323,
      "end_offset": 3329,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0021",
      "chapter": 46,
      "start_offset": 3367,
      "end_offset": 3388,
      "text_exact": "“Then why defend it?”",
      "text_sha256": "93802cf881f6c50c0edf2a92c1c3b3ad7ea5715d519d2998fe45bbd92ffd85d4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0022",
      "chapter": 46,
      "start_offset": 3493,
      "end_offset": 3537,
      "text_exact": "“Because failure distributed is survivable.”",
      "text_sha256": "af8147e711c8d5ab8e35687ef696ba51e91b6db3cd5b75b89a439be55c32a76e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0023",
      "chapter": 46,
      "start_offset": 3693,
      "end_offset": 3714,
      "text_exact": "“Machine compromise.”",
      "text_sha256": "c435e3f05a1935605b382d78f8d67c1fcb646f0114259e60902b363439e8d629",
      "speaker": "loam",
      "speaker_display": "LOAM",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0024",
      "chapter": 46,
      "start_offset": 4585,
      "end_offset": 4600,
      "text_exact": "“That is rude.”",
      "text_sha256": "b86e2ba4be142aa1379c91636f46b1532bfab20bd21ba9dc171fd88bce54cac4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0025",
      "chapter": 46,
      "start_offset": 4602,
      "end_offset": 4620,
      "text_exact": "“It is technical.”",
      "text_sha256": "103d661b247ed9da15d7dc037f64c5a33481866287d8b13689647a6d8760489e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0026",
      "chapter": 46,
      "start_offset": 4622,
      "end_offset": 4659,
      "text_exact": "“That is how rude survives meetings.”",
      "text_sha256": "e0e40fa6091c920f4cd298b6fbb0f674e82b027da692714cb9359f5121aa000b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0027",
      "chapter": 46,
      "start_offset": 4987,
      "end_offset": 5014,
      "text_exact": "“You measure stored grain.”",
      "text_sha256": "f3605fada549fc01ffb7331d8a786782f90dacf54a72df53a3f323e3eed51d52",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0028",
      "chapter": 46,
      "start_offset": 5016,
      "end_offset": 5022,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0029",
      "chapter": 46,
      "start_offset": 5024,
      "end_offset": 5054,
      "text_exact": "“Do you measure who has keys?”",
      "text_sha256": "d84443b5907648c26c42cb15a125d4c439542d8251c9bf7fb54f6ae4d618e38a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0030",
      "chapter": 46,
      "start_offset": 5073,
      "end_offset": 5078,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0031",
      "chapter": 46,
      "start_offset": 5080,
      "end_offset": 5143,
      "text_exact": "“Who knows the generator starts only if you tap the fuel line?”",
      "text_sha256": "39a3a26573685b58945e6a490db7fa72667a5e46d0ea302f0243cc69ef6b70b3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0032",
      "chapter": 46,
      "start_offset": 5145,
      "end_offset": 5150,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0033",
      "chapter": 46,
      "start_offset": 5152,
      "end_offset": 5212,
      "text_exact": "“Who can repair the old irrigation pump without the manual?”",
      "text_sha256": "17456802da13a0dc44cb4b974c99f5c2508b997e7bbb87cc08a63d6363ec7bc6",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0034",
      "chapter": 46,
      "start_offset": 5214,
      "end_offset": 5219,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0035",
      "chapter": 46,
      "start_offset": 5221,
      "end_offset": 5311,
      "text_exact": "“Who is trusted enough to tell twenty families the water is contaminated and be believed?”",
      "text_sha256": "b91c519388af441bacba3dbfec4168f88903e54e585539070878724a12403915",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0036",
      "chapter": 46,
      "start_offset": 5353,
      "end_offset": 5400,
      "text_exact": "“You are counting capacity without custodians.”",
      "text_sha256": "71c508668b936bbca0674be119b099ee97e1fef1a9cdad0a05f9d47de784208d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0037",
      "chapter": 46,
      "start_offset": 6224,
      "end_offset": 6244,
      "text_exact": "“You look terrible,”",
      "text_sha256": "dc557e7d86601bed24de373b668454b3c26dad929a725d83a85932c2481a589a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0038",
      "chapter": 46,
      "start_offset": 6256,
      "end_offset": 6278,
      "text_exact": "“Good to see you too.”",
      "text_sha256": "c56a841f94a87d6e518b907db298a61361dd8e923c4cca4a230d0f4e80118d99",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0039",
      "chapter": 46,
      "start_offset": 6280,
      "end_offset": 6297,
      "text_exact": "“You are eating?”",
      "text_sha256": "f64705bdb8a730bbac3dd106c80f7b15ccb872c53647b2c3ad6206ca4adf8204",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0040",
      "chapter": 46,
      "start_offset": 6299,
      "end_offset": 6304,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0041",
      "chapter": 46,
      "start_offset": 6306,
      "end_offset": 6369,
      "text_exact": "“So humanity may end because my son still does not know lunch.”",
      "text_sha256": "606475b61f63bceac98618faf6aa1b7504f609d289b19f80c430d42d77f02458",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0042",
      "chapter": 46,
      "start_offset": 6549,
      "end_offset": 6586,
      "text_exact": "“You built a local allocation board.”",
      "text_sha256": "e9c953f94678d4891e18aa0c7b7df7bd7c3fdff91439b3cb5b248d8225c7a042",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0043",
      "chapter": 46,
      "start_offset": 6588,
      "end_offset": 6606,
      "text_exact": "“We built a list.”",
      "text_sha256": "5ed48ca3bf99a3e9fac81f2838f2d5ce8b451c737bb2bd5dc948ba1ca2fd202a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0044",
      "chapter": 46,
      "start_offset": 6608,
      "end_offset": 6631,
      "text_exact": "“It is the same thing.”",
      "text_sha256": "d928569da3fefba30cf468c2d27c2ab0e48d35570a052b8fc9efc84a6cf16bec",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0045",
      "chapter": 46,
      "start_offset": 6633,
      "end_offset": 6691,
      "text_exact": "“No. Yours probably has seventeen layers and a committee.”",
      "text_sha256": "6f8baf0dbb3c36806dfed09925fad016ad506cd8dda2a5abc895be8247e3d6cc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0046",
      "chapter": 46,
      "start_offset": 6838,
      "end_offset": 6850,
      "text_exact": "“Why three?”",
      "text_sha256": "41d1eeb3bcd065dffa015296ccef0382f1741ef5a739808644fbd789dc33b86b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0047",
      "chapter": 46,
      "start_offset": 6852,
      "end_offset": 6888,
      "text_exact": "“Because the network keeps failing.”",
      "text_sha256": "6f2445227955c43b8dafc96ee7e34b11d53d2c85cc4a42bb6db79ec4047a492e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0048",
      "chapter": 46,
      "start_offset": 6926,
      "end_offset": 6933,
      "text_exact": "“What?”",
      "text_sha256": "bf9ee250242dc9be6ae8a64cb636db6ea70186d990757358b8947787279f47cc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0049",
      "chapter": 46,
      "start_offset": 6935,
      "end_offset": 6945,
      "text_exact": "“Nothing.”",
      "text_sha256": "758014336533a5aad6f6c4c07d5fc43d2bbb1ee0b3e59d44a03896180966ec2f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0050",
      "chapter": 46,
      "start_offset": 6947,
      "end_offset": 6984,
      "text_exact": "“That is never true when you say it.”",
      "text_sha256": "e703836b929b6ca15724019cfb2ceb62fb4c72dea7bd93d28b8e4fe14b4ee611",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0051",
      "chapter": 46,
      "start_offset": 7102,
      "end_offset": 7151,
      "text_exact": "“You spent your whole life trying to stop waste.”",
      "text_sha256": "3f1d61035cf0f404cfb70f9ccad93d2ef6052222c42da4942da2febdcb45aa28",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0052",
      "chapter": 46,
      "start_offset": 7153,
      "end_offset": 7159,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0053",
      "chapter": 46,
      "start_offset": 7161,
      "end_offset": 7209,
      "text_exact": "“Maybe some waste is what keeps you from dying.”",
      "text_sha256": "aa7c1a7baf551fb0d53bf42a1954cb58e48d588c9fc19b38bdc17d0f17ded9e2",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0054",
      "chapter": 46,
      "start_offset": 8144,
      "end_offset": 8154,
      "text_exact": "“You see.”",
      "text_sha256": "fffef7a067af4181c7532ab9194f38f2a8204c9b44b14bd74699e7c0ea8c83a6",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0055",
      "chapter": 46,
      "start_offset": 8170,
      "end_offset": 8218,
      "text_exact": "“Local control is not automatically legitimate.”",
      "text_sha256": "95d01939e0cf1209d6d041a7b1d935197c677d1cc639ef6249637e4395c37589",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0056",
      "chapter": 46,
      "start_offset": 8220,
      "end_offset": 8238,
      "text_exact": "“Then centralize.”",
      "text_sha256": "054153888815cfca0aaba9ee608893c5e017d7a9b1bf93f27459f480f7d44bb5",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0057",
      "chapter": 46,
      "start_offset": 8240,
      "end_offset": 8245,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0058",
      "chapter": 46,
      "start_offset": 8247,
      "end_offset": 8283,
      "text_exact": "“You prefer distributed corruption.”",
      "text_sha256": "b1a341ebd5711b014f0c6ec4ca9cd398b5e78184b552670ce41d87f7923ae1cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0059",
      "chapter": 46,
      "start_offset": 8285,
      "end_offset": 8353,
      "text_exact": "“I prefer no level of authority being able to call itself innocent.”",
      "text_sha256": "9be6a1466fa6863e4361e9c4e523bd1430ffc8323bb436c2c2978d2219a4dfae",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0060",
      "chapter": 46,
      "start_offset": 8585,
      "end_offset": 8618,
      "text_exact": "“You just reinvented federalism.”",
      "text_sha256": "72b11d52f6046f9493dcaf419e49ae2b7e33ae2e2537fa1a78f05a9cab9f09b0",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0061",
      "chapter": 46,
      "start_offset": 8645,
      "end_offset": 8658,
      "text_exact": "“Federation.”",
      "text_sha256": "69de5ef19d7802d1d96f30c934b3ae300756c4e7d7f3a9c6a2fbcb0e19293287",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0062",
      "chapter": 46,
      "start_offset": 9307,
      "end_offset": 9325,
      "text_exact": "“Send ours first.”",
      "text_sha256": "2c681b81d81bdd59c520af0aad36ffde3c1e9827c2b4b6de08b2f859cba756d5",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0063",
      "chapter": 46,
      "start_offset": 9439,
      "end_offset": 9445,
      "text_exact": "“Mom.”",
      "text_sha256": "93dce211fb290f942e8bf23511a7a9bd9575001dc6e707ed77e0beb6bcec981e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0064",
      "chapter": 46,
      "start_offset": 9447,
      "end_offset": 9454,
      "text_exact": "“What?”",
      "text_sha256": "bf9ee250242dc9be6ae8a64cb636db6ea70186d990757358b8947787279f47cc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0065",
      "chapter": 46,
      "start_offset": 9456,
      "end_offset": 9482,
      "text_exact": "“The other site is worse.”",
      "text_sha256": "0e3c1917fb29bb9f2d40e284feaa7944cdabdd9470ba5423b003dd4542fafbd6",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0066",
      "chapter": 46,
      "start_offset": 9494,
      "end_offset": 9511,
      "text_exact": "“How much worse?”",
      "text_sha256": "a144fa3b4fe640281ac25697f747d44ca4736873ade0b8e44b7b90a645db2a5e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0067",
      "chapter": 46,
      "start_offset": 9543,
      "end_offset": 9550,
      "text_exact": "“Fine.”",
      "text_sha256": "872ee3d75c6fc05922c2910ab52121b05e89e517bf43b5b9c5e32f2911d21197",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0068",
      "chapter": 46,
      "start_offset": 9621,
      "end_offset": 9641,
      "text_exact": "“Do not enjoy this.”",
      "text_sha256": "da244fc5feb9398ad796adc51e680b9eb0532bf21552f8a8ba894925d1d6ab4c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0069",
      "chapter": 46,
      "start_offset": 9643,
      "end_offset": 9667,
      "text_exact": "“I am trying very hard.”",
      "text_sha256": "4446e67043810fe2e0e89a6cdca2cff2760c84f9fca7d60cadea68de2d3a6ef9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0070",
      "chapter": 46,
      "start_offset": 9702,
      "end_offset": 9716,
      "text_exact": "“I was wrong.”",
      "text_sha256": "a390a5fafb2c7f33c75dcb46ef91c4da69b7a35856d24118cbd4ef84e61d9638",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0071",
      "chapter": 46,
      "start_offset": 9738,
      "end_offset": 9784,
      "text_exact": "“Can you say it again? My supervisor is here.”",
      "text_sha256": "3ffc55daef295c575d3a6b43e944fb891b493a6e2bb3f698d62b946066027236",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch46-d0072",
      "chapter": 46,
      "start_offset": 10173,
      "end_offset": 10259,
      "text_exact": "“If losing one thing breaks everything, you didn't have a system. You had a favorite.”",
      "text_sha256": "b14f35761ffcd1d9ddf852911220db16162e27ba3131b4d832b7d9ebf78160e0",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    }
  ]
}
