  "chapter_title": "WHAT THE FLOOD KEPT",
  "chapter_sha256": "8affb355b4a39e0e5713d68ae55a445346b44613903da0a393ec9de1fc9a64a9",
  "policy": "No unresolved dialogue may fall back to narrator. render_allowed remains false until human approval.",
