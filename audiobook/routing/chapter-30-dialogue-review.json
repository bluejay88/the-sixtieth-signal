  "spans": [
    {
      "dialogue_id": "ch30-d0001",
      "chapter": 30,
      "start_offset": 145,
      "end_offset": 174,
      "text_exact": "“You can drown in parallels,”",
      "text_sha256": "6a93e156ff63c4c88e7c451b5edaa2f0ea4f054deb9c38efd964b01fa3f91fc2",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0002",
      "chapter": 30,
      "start_offset": 554,
      "end_offset": 583,
      "text_exact": "“This is why people hate us,”",
      "text_sha256": "f3034291c06e64411202edf3b670e9a949c9c93de283b9a7ab9270eb4afbed2f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0003",
      "chapter": 30,
      "start_offset": 595,
      "end_offset": 620,
      "text_exact": "“People love red string.”",
      "text_sha256": "6092ddde1c4bf95a2af64d54ceaf53d835ba18b4780f636b6364230884b72bf9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0004",
      "chapter": 30,
      "start_offset": 622,
      "end_offset": 676,
      "text_exact": "“People love conclusions that arrive before evidence.”",
      "text_sha256": "c41705eeb69576ef8fa93a2502a8f4bbfe47890e2cf0adf6d332eeb98c1d48d8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0005",
      "chapter": 30,
      "start_offset": 994,
      "end_offset": 1181,
      "text_exact": "“Floods are common human disasters. Rivers overflow. Coasts change. Storm surges happen. Communities live near water because water sustains them. Similar stories can arise independently.”",
      "text_sha256": "b3621d6ef01d3bf1ac9307210dfc842b4de0d7d184200f35f32499efb6b6b834",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0006",
      "chapter": 30,
      "start_offset": 1194,
      "end_offset": 1221,
      "text_exact": "“And they can also travel.”",
      "text_sha256": "330dd93d1509d9804db2e85b0adb38a2560cf6c114580a1cd53e880ff05410fd",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0007",
      "chapter": 30,
      "start_offset": 1223,
      "end_offset": 1229,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0008",
      "chapter": 30,
      "start_offset": 1231,
      "end_offset": 1264,
      "text_exact": "“And some can preserve memories.”",
      "text_sha256": "f426e0ec411465845f77f1515f5152b842e9fe556c542d0e6941c3bba4cf7a47",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0009",
      "chapter": 30,
      "start_offset": 1266,
      "end_offset": 1272,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0010",
      "chapter": 30,
      "start_offset": 1274,
      "end_offset": 1333,
      "text_exact": "“And the archive records a real catastrophic displacement.”",
      "text_sha256": "72951ee556f1f2baac54b93f724bb9aa9a9f1ec3b9f2d7ebfd91c6afec9d3e45",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0011",
      "chapter": 30,
      "start_offset": 1335,
      "end_offset": 1368,
      "text_exact": "“Inside our evidence chain, yes.”",
      "text_sha256": "80d8e0a6156b9fdff214e1cbadc72fa2cb1f31c069a8e9530aca7a551cf5aec9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0012",
      "chapter": 30,
      "start_offset": 1370,
      "end_offset": 1394,
      "text_exact": "“So what's the problem?”",
      "text_sha256": "548702efb4d1c73d7bf08f6b03e10afb2e7ab761cebf0f43c11d69265c98313c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0013",
      "chapter": 30,
      "start_offset": 1396,
      "end_offset": 1469,
      "text_exact": "“The problem is saying therefore every flood story remembers this event.”",
      "text_sha256": "c616dfdf86654bfe2b587a786152c958989e5b152d2adbac8377e9f087615f0a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0014",
      "chapter": 30,
      "start_offset": 1485,
      "end_offset": 1521,
      "text_exact": "“You are devastating for marketing.”",
      "text_sha256": "8f8a22f21c5e6fd76bbb833ce47f3d6d2213f366e837554d91bf6a19aa22f7a9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0015",
      "chapter": 30,
      "start_offset": 1523,
      "end_offset": 1566,
      "text_exact": "“I am excellent for surviving peer review.”",
      "text_sha256": "ad532447fe6038e6e35ed271b0eb5da8c1c553141edacf2ab27406961a1aa112",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0016",
      "chapter": 30,
      "start_offset": 2026,
      "end_offset": 2067,
      "text_exact": "“So the Visitors didn't flood the Earth,”",
      "text_sha256": "86fef05e63961455a41a095659f318386fb3b8af7af306ad032d88fa99581c8e",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0017",
      "chapter": 30,
      "start_offset": 2080,
      "end_offset": 2111,
      "text_exact": "“Not according to this record,”",
      "text_sha256": "093e6d4434454a16d3f2a970eda947d985b1570cf8750a89f7cd63d45ea20ddc",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0018",
      "chapter": 30,
      "start_offset": 2125,
      "end_offset": 2143,
      "text_exact": "“That's less fun.”",
      "text_sha256": "4a95ae1b4b8074337634ab177f9b6034b64fc9a7838f16490eb2daf69bd12c22",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0019",
      "chapter": 30,
      "start_offset": 2145,
      "end_offset": 2179,
      "text_exact": "“Reality keeps doing that to you.”",
      "text_sha256": "326c095dc71345f51837bec1fed4fa6e5a047ec3d96a54a78ac8ecba67141003",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0020",
      "chapter": 30,
      "start_offset": 2432,
      "end_offset": 2447,
      "text_exact": "“Transmission?”",
      "text_sha256": "aad031dfaee5559fc9c0f8c2757d1d690cffe9ebb474de9b6a9501b415db6011",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0021",
      "chapter": 30,
      "start_offset": 2460,
      "end_offset": 2476,
      "text_exact": "“Common source?”",
      "text_sha256": "d90813acc37d4c8fa7cf933a1e673596a50a4b9cb55e2abf35e6cea9026ebe34",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0022",
      "chapter": 30,
      "start_offset": 2493,
      "end_offset": 2519,
      "text_exact": "“Independent convergence?”",
      "text_sha256": "744b697d2234c32228334d509dc339db2acb842881c4515296b0bc5080390668",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0023",
      "chapter": 30,
      "start_offset": 2560,
      "end_offset": 2592,
      "text_exact": "“Good. Keep alternatives alive.”",
      "text_sha256": "ad449156d6b8419920c0bfbacc82dd82d5fd736d09cfa721cd6e5a80cd62227b",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0024",
      "chapter": 30,
      "start_offset": 3221,
      "end_offset": 3249,
      "text_exact": "“Cultural error correction.”",
      "text_sha256": "4b0fa8aaa5d3fb85c8b6a5fe50ea6294795f04b118239733c43ddce13625e9ab",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0025",
      "chapter": 30,
      "start_offset": 3272,
      "end_offset": 3282,
      "text_exact": "“Careful.”",
      "text_sha256": "f8fd75a236d1e7a2653c88de135f16fa9ca019f1e8f88b97df16107e8881b709",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0026",
      "chapter": 30,
      "start_offset": 3284,
      "end_offset": 3300,
      "text_exact": "“As a metaphor.”",
      "text_sha256": "acea0ea1c2b1d91186ff2e69b4f12b17d5923bbf5e9f3bf3300795795a1282f8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0027",
      "chapter": 30,
      "start_offset": 3302,
      "end_offset": 3325,
      "text_exact": "“Then yes. A good one.”",
      "text_sha256": "4677f8675d68869150af54fc2ce5836ebbfdff0c43a4ea7dd8e24009e029c02b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0028",
      "chapter": 30,
      "start_offset": 3351,
      "end_offset": 3380,
      "text_exact": "“So myth is compressed data.”",
      "text_sha256": "0e6bd537e363305e5aa27e59ede5d21a859b8441b5a46ac0dd357102fe3afb87",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0029",
      "chapter": 30,
      "start_offset": 3382,
      "end_offset": 3394,
      "text_exact": "“Sometimes,”",
      "text_sha256": "4de6815d89667b27e61b5ddc5895fec3b969a6515748f7873a906fd9cd4af692",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0030",
      "chapter": 30,
      "start_offset": 3407,
      "end_offset": 3563,
      "text_exact": "“Sometimes myth is myth. Sometimes it's politics. Sometimes ritual. Sometimes entertainment. Sometimes memory. Stop trying to make one key open every door.”",
      "text_sha256": "7aad257de712395bdc395134d10d039cb81b600dce2d04763600419facb29395",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0031",
      "chapter": 30,
      "start_offset": 3565,
      "end_offset": 3581,
      "text_exact": "“But this book-”",
      "text_sha256": "77828b26f6b8e6dff5e701b68e49c984b35b38a0432960b096aacbdcaf7e1e25",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0032",
      "chapter": 30,
      "start_offset": 3621,
      "end_offset": 3638,
      "text_exact": "“This situation.”",
      "text_sha256": "123359cbc1d2a39ee308c716e8a06e8a1ef84628bce6dc0418fb7a71d4b08884",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0033",
      "chapter": 30,
      "start_offset": 4305,
      "end_offset": 4325,
      "text_exact": "“We have a problem.”",
      "text_sha256": "dec550b04e2d627b00276be23c6d31d445a9994e4d2468b52345a3155a4355b2",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0034",
      "chapter": 30,
      "start_offset": 4338,
      "end_offset": 4349,
      "text_exact": "“Only one?”",
      "text_sha256": "2412cca4751a52d1a12da6a2b6f4b3e676a5f952cf97087f4422acd54bcdeea8",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0035",
      "chapter": 30,
      "start_offset": 4845,
      "end_offset": 4866,
      "text_exact": "“They're solving it.”",
      "text_sha256": "82ea336e7cabb6466fdda43f6b3ab9990442706b5142b6472bc8a1b0627f6e62",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0036",
      "chapter": 30,
      "start_offset": 4879,
      "end_offset": 4907,
      "text_exact": "“They're solving something.”",
      "text_sha256": "86bd4e0801ffc1f845238f0b4e3dfd2d038c61996804ba8b36ac7cc87f19daab",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0037",
      "chapter": 30,
      "start_offset": 4909,
      "end_offset": 4922,
      "text_exact": "“Difference?”",
      "text_sha256": "dd48a197e1989e6197104156c095755af60a055ff24deb81f26047791337c55a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0038",
      "chapter": 30,
      "start_offset": 4924,
      "end_offset": 5022,
      "text_exact": "“We don't know whether they're recovering intended structure or manufacturing one from our leaks.”",
      "text_sha256": "cd3d0d56ead80f712b291845ffb3f6c4ea34ba35c3d0287885e3247574ee04bf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0039",
      "chapter": 30,
      "start_offset": 5039,
      "end_offset": 5077,
      "text_exact": "“Then give them falsifiable material.”",
      "text_sha256": "1aeda3ad5a44acf91539ba82f0c89db5aa7970888e9a145b94a5c3031d8a7829",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0040",
      "chapter": 30,
      "start_offset": 5100,
      "end_offset": 5127,
      "text_exact": "“You want to release more?”",
      "text_sha256": "110723770ee06570d8c1a3b08eaca200381bd413c7525b973cc68b96f289c4ba",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0041",
      "chapter": 30,
      "start_offset": 5129,
      "end_offset": 5202,
      "text_exact": "“Controlled raw data with provenance. Enough to let wrong theories fail.”",
      "text_sha256": "62924e747da51919177ab76694c5f775e9ec755488b9cacb9ce419ed2eee9501",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0042",
      "chapter": 30,
      "start_offset": 5300,
      "end_offset": 5332,
      "text_exact": "“If stories preserve structure,”",
      "text_sha256": "6998b7687e9f1e524b9901fc87dbab5145f8f22c76adf6e9f623d9e6b5422d8b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0043",
      "chapter": 30,
      "start_offset": 5342,
      "end_offset": 5371,
      "text_exact": "“then narrative is evidence.”",
      "text_sha256": "654ba6240240479e76c59157324425146effcf1858ba2bf251bae405edeac98f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0044",
      "chapter": 30,
      "start_offset": 5373,
      "end_offset": 5378,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0045",
      "chapter": 30,
      "start_offset": 5380,
      "end_offset": 5441,
      "text_exact": "“You literally just said stories can preserve relationships.”",
      "text_sha256": "883002a9fa01714de5718b6e18337aa4af3ff221caca8a6d44564b1a6b512fe2",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0046",
      "chapter": 30,
      "start_offset": 5443,
      "end_offset": 5493,
      "text_exact": "“That does not make narrative evidence by itself.”",
      "text_sha256": "83a1fee7add4334fa0867f8b95ef2cc366b9f0e19a267fd371c3827f9efd4deb",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0047",
      "chapter": 30,
      "start_offset": 5495,
      "end_offset": 5520,
      "text_exact": "“What is the difference?”",
      "text_sha256": "6ca23be94048f0d236cc575da217f5800f2c019ae38ad9399fcfa9d7dc889354",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0048",
      "chapter": 30,
      "start_offset": 5522,
      "end_offset": 5558,
      "text_exact": "“Evidence is a role in an argument.”",
      "text_sha256": "ff043895a6451cdc10f5a732cf55bd2eb2e02a3e3e9b27193ea5f521029cf374",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0049",
      "chapter": 30,
      "start_offset": 5582,
      "end_offset": 5606,
      "text_exact": "“That is very academic.”",
      "text_sha256": "6b356d58a3edb89572b912b167cebc5a7ac546ae04018d04e3ae060ec482328a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0050",
      "chapter": 30,
      "start_offset": 5608,
      "end_offset": 5625,
      "text_exact": "“It is accurate.”",
      "text_sha256": "f6aff680d9d37ce64a14c6578122425a6fa37f4b1ffd97e962c00c4a42659e5d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0051",
      "chapter": 30,
      "start_offset": 5930,
      "end_offset": 6016,
      "text_exact": "“So a story can carry evidence without being evidence of whatever modern people want.”",
      "text_sha256": "d033d215b88a59a97b65583d16c28991d57089ebf58834a6acdba249611931f1",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0052",
      "chapter": 30,
      "start_offset": 6018,
      "end_offset": 6024,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0053",
      "chapter": 30,
      "start_offset": 6040,
      "end_offset": 6066,
      "text_exact": "“That is annoyingly good.”",
      "text_sha256": "ab5d086607eea739329694337abd6091f88f9d59e4e8448eb17618f80c3697e3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0054",
      "chapter": 30,
      "start_offset": 6083,
      "end_offset": 6099,
      "text_exact": "“Write it down.”",
      "text_sha256": "a94c39cdc169d63eca9ad897118626fc9b9f05fe5bf49b1ad89b73f86459a0e2",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0055",
      "chapter": 30,
      "start_offset": 6385,
      "end_offset": 6431,
      "text_exact": "“That violates every disclosure model I have.”",
      "text_sha256": "b3ffa9edd8193b460fcf127c06833d6c9be73ac608fe2394ffd676e17fe38e5e",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0056",
      "chapter": 30,
      "start_offset": 6447,
      "end_offset": 6491,
      "text_exact": "“Your models assume centralized disclosure.”",
      "text_sha256": "94d79de2dda27c473a28ff71d76232a07cb144f900e330b4afb9db1117e1ec93",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0057",
      "chapter": 30,
      "start_offset": 6526,
      "end_offset": 6551,
      "text_exact": "“LOAM's point, not mine.”",
      "text_sha256": "f79a810d44b7eae5f208bef9940db5f65fb81dee2a834679c46d875ea4275018",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0058",
      "chapter": 30,
      "start_offset": 6742,
      "end_offset": 6761,
      "text_exact": "“That's the point,”",
      "text_sha256": "99ad0d0598bd35bdb6549a2c25ef7c4d2ae4b305baba03c0d867b24fb198d416",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0059",
      "chapter": 30,
      "start_offset": 6798,
      "end_offset": 6838,
      "text_exact": "“The flood survives because it changes.”",
      "text_sha256": "6c2295b154cf2aa3a69e097fd010fd12a0fcbdc684ddd89c50651b84dc3ddce8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0060",
      "chapter": 30,
      "start_offset": 6840,
      "end_offset": 6852,
      "text_exact": "“Sometimes.”",
      "text_sha256": "c5dd008dfc449574ddd4511a5a7f1b4a5beec39891133e0981133b17d9b744f7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0061",
      "chapter": 30,
      "start_offset": 6854,
      "end_offset": 6905,
      "text_exact": "“And the archive survives because copies disagree.”",
      "text_sha256": "7412c285200a72b20afa74342d189f3673c5768cbc2e8a8e59311c800375e774",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0062",
      "chapter": 30,
      "start_offset": 6907,
      "end_offset": 6913,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0063",
      "chapter": 30,
      "start_offset": 6940,
      "end_offset": 6983,
      "text_exact": "“Maybe civilization survives the same way.”",
      "text_sha256": "3ceb5d60014ea56f9c5e6d17cb54105fe743921f2c06e6fd0528bb51e67b13f3",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0064",
      "chapter": 30,
      "start_offset": 7499,
      "end_offset": 7517,
      "text_exact": "“What is missing?”",
      "text_sha256": "a908f5bd70f7ba88f5b49761eb0dc63e6a1935640cd8995a8440e63e6e5da23c",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0065",
      "chapter": 30,
      "start_offset": 7625,
      "end_offset": 7649,
      "text_exact": "“What's the difference?”",
      "text_sha256": "82eb2b933cb11207087af66a864187da99c87a9f3263a3994537e8605c102d30",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0066",
      "chapter": 30,
      "start_offset": 8539,
      "end_offset": 8547,
      "text_exact": "“Lossy,”",
      "text_sha256": "3301d5dc497d5eba437bd26c1ff52ac1c372ec9e9ca875241d52d91410244b35",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0067",
      "chapter": 30,
      "start_offset": 8563,
      "end_offset": 8569,
      "text_exact": "“Yes,”",
      "text_sha256": "962de7fb6fae75af56fade68f4c6749cef2bb0359757cabcea0e02437a368c4b",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0068",
      "chapter": 30,
      "start_offset": 8586,
      "end_offset": 8602,
      "text_exact": "“But redundant.”",
      "text_sha256": "30ff6aa60c7da2e6011f49f24d5ddb26ae6d031a042a4b1145afbdb89a1da441",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0069",
      "chapter": 30,
      "start_offset": 8924,
      "end_offset": 8957,
      "text_exact": "“So the conspiracy is diversity.”",
      "text_sha256": "dd4d90dd958d2b1f5145777d125175b9a56aeb915031e1db168ba5b89db0eb18",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0070",
      "chapter": 30,
      "start_offset": 8974,
      "end_offset": 8979,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0071",
      "chapter": 30,
      "start_offset": 8981,
      "end_offset": 8988,
      "text_exact": "“What?”",
      "text_sha256": "bf9ee250242dc9be6ae8a64cb636db6ea70186d990757358b8947787279f47cc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0072",
      "chapter": 30,
      "start_offset": 8990,
      "end_offset": 9071,
      "text_exact": "“The conspiracy is what happens when somebody destroys the copies that disagree.”",
      "text_sha256": "8c2e2eac2f1e7a0560a8645a86f36fbd8b57d5bad5f1cddfb1378f6213d71e1b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0073",
      "chapter": 30,
      "start_offset": 9436,
      "end_offset": 9466,
      "text_exact": "“That is much more dangerous.”",
      "text_sha256": "7ddaccf31846379456c2de5265d4eb5bc3567be2eb9d6932a842534e2b909e90",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0074",
      "chapter": 30,
      "start_offset": 9757,
      "end_offset": 9778,
      "text_exact": "“Which one is right?”",
      "text_sha256": "f564dcddcae4bd7732f1e8e564703d3e2a3cbb5487c33f34af6740e24341ba7b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0075",
      "chapter": 30,
      "start_offset": 9795,
      "end_offset": 9808,
      "text_exact": "“Maybe none.”",
      "text_sha256": "0ef5348b6c5df2a55ee3ee770b2fd9102fcaf5912cb578192d0451c0a32ac97d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0076",
      "chapter": 30,
      "start_offset": 10857,
      "end_offset": 10872,
      "text_exact": "“Then by what?”",
      "text_sha256": "7baf4fcc1556732470cff302421f0c4b393eeb320cb0b91eeafa94e9f46f6275",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0077",
      "chapter": 30,
      "start_offset": 11098,
      "end_offset": 11122,
      "text_exact": "“That sounds like LOAM.”",
      "text_sha256": "edb766bb9fa5058b0856a4d8ee6558c98b05229b0285ffa4324fcd1afc5ccec2",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0078",
      "chapter": 30,
      "start_offset": 11149,
      "end_offset": 11196,
      "text_exact": "“It sounds like a test LOAM still has to pass.”",
      "text_sha256": "ec108c4594e46effb022d502e1cfba47bab18e07dd2fbc68dd07aaa468616098",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch30-d0079",
      "chapter": 30,
      "start_offset": 11340,
      "end_offset": 11353,
      "text_exact": "“Everything.”",
      "text_sha256": "66785856f920505d211b02bd251ce73d4da998051ceeb4c12b8067e5f8d1dc10",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
