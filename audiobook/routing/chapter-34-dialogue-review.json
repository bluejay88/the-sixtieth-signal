  "spans": [
    {
      "dialogue_id": "ch34-d0001",
      "chapter": 34,
      "start_offset": 1215,
      "end_offset": 1259,
      "text_exact": "“It is under Antarctic treaty jurisdiction,”",
      "text_sha256": "9bf0501ae83ec3f0854b923069cd895c25c5877bbc65208ab31390315f3174fb",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0002",
      "chapter": 34,
      "start_offset": 1284,
      "end_offset": 1364,
      "text_exact": "“It is under several kilometers of ice and has not agreed to your jurisdiction,”",
      "text_sha256": "edc76df2e3f0c30b2fd192fb764f7276b6ada2c560c388c6fceab17a73ae4c69",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0003",
      "chapter": 34,
      "start_offset": 1519,
      "end_offset": 1679,
      "text_exact": "“No theologian, no influencer, no retired intelligence officer, no ancient-mysteries entrepreneur sitting beside me while a host asks whether Enki built Wi-Fi.”",
      "text_sha256": "6b8424e74c4ff17a9768dc453c500ef9193aa5c26aa6a136ff90f01c2b276b76",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0004",
      "chapter": 34,
      "start_offset": 1692,
      "end_offset": 1710,
      "text_exact": "“Specific trauma?”",
      "text_sha256": "01f0477e42060cae3f94e9d9816c4eeccbede344d1363c56d1ab6fcd9a4589ac",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0005",
      "chapter": 34,
      "start_offset": 1712,
      "end_offset": 1747,
      "text_exact": "“I have lived through conferences.”",
      "text_sha256": "0e8dd282fa37be39025ce2ba82228cb4a2e868534c901e7179c00efcebec9da9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0006",
      "chapter": 34,
      "start_offset": 2143,
      "end_offset": 2165,
      "text_exact": "“confirmed the Bible,”",
      "text_sha256": "7cbbb627412c0753e27164eae1f4c09ccce4388caff5e1b0d9526c5fa028b5e8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0007",
      "chapter": 34,
      "start_offset": 2166,
      "end_offset": 2189,
      "text_exact": "“disproved the Qur’an,”",
      "text_sha256": "519d2d21f2199da882d51e568a1d3af3d5efea337968e2ff1cd546a64e217401",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0008",
      "chapter": 34,
      "start_offset": 2190,
      "end_offset": 2212,
      "text_exact": "“validated the Vedas,”",
      "text_sha256": "120cfcbfd8aeed26f1fc31c83547bb409bfd99b13c4e080a2d66a7594623fe13",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0009",
      "chapter": 34,
      "start_offset": 2216,
      "end_offset": 2248,
      "text_exact": "“exposed all religion as fraud.”",
      "text_sha256": "f80a4d370c82c8d23fb6a3d79ed71ca3bd950b3b49705590754b75819820509c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0010",
      "chapter": 34,
      "start_offset": 2413,
      "end_offset": 2425,
      "text_exact": "“I believe,”",
      "text_sha256": "ea650ece4e44dc33e5c258882d26247a8a96195e8fbbf27b9611fbf64b8c0b33",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0011",
      "chapter": 34,
      "start_offset": 2436,
      "end_offset": 2864,
      "text_exact": "“that something not adequately explained by known geology responded to structured testing beneath Antarctic ice. I believe it contains an information system whose internal history claims interaction with humanity. I believe portions of that system preserve mathematical structures that can be compared, carefully, with later human traditions. And I believe none of those sentences gives me permission to say more than they say.”",
      "text_sha256": "5826ff62f51c3652f028b85c459890f9252e19a716dafb3cc51788336d2d51ca",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0012",
      "chapter": 34,
      "start_offset": 3554,
      "end_offset": 3596,
      "text_exact": "“Rate-limit unverified historical claims.”",
      "text_sha256": "6363638b652a77ade4ef0f17d2483d567ca063480bdf88665cc15dae326fad10",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0013",
      "chapter": 34,
      "start_offset": 3605,
      "end_offset": 3640,
      "text_exact": "“Weight primary-source provenance.”",
      "text_sha256": "123278d2a4d608cff751dbb610b8531d2c3dea406883953178200dfcbb6c3e52",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0014",
      "chapter": 34,
      "start_offset": 3649,
      "end_offset": 3704,
      "text_exact": "“Do not infer cultural ancestry from motif similarity.”",
      "text_sha256": "bba97f8a9924d5fa7dd3a4d30fbfba555e0281624831439b988b250c7cca96d9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0015",
      "chapter": 34,
      "start_offset": 3713,
      "end_offset": 3745,
      "text_exact": "“Flag circular citation chains.”",
      "text_sha256": "3c9503fdff7566ed1e97040e1dff67874fc0ed6ebcc8f74ac85a55c128a14028",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0016",
      "chapter": 34,
      "start_offset": 3876,
      "end_offset": 3896,
      "text_exact": "“Of course they do.”",
      "text_sha256": "45756f815f2ebb2cfef8ae19881a62943d17e6346f75cb2664591c30fb6a3cf8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0017",
      "chapter": 34,
      "start_offset": 4386,
      "end_offset": 4402,
      "text_exact": "“the Third God.”",
      "text_sha256": "05049275c257081b00960c39975de985dbe3cc46fa5fce77f8ed32c4216b4520",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0018",
      "chapter": 34,
      "start_offset": 4501,
      "end_offset": 4524,
      "text_exact": "“This is Pike’s model,”",
      "text_sha256": "42afff6acd68ab985a9cce2475269db2c85303a94206a1354bb9d5a5776ee02d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0019",
      "chapter": 34,
      "start_offset": 4557,
      "end_offset": 4571,
      "text_exact": "“Parts of it.”",
      "text_sha256": "18d22c5e26d97692df79bf65b077696d7f2c8aafa082a7ddad117893c79975bc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0020",
      "chapter": 34,
      "start_offset": 4573,
      "end_offset": 4623,
      "text_exact": "“She predicted violence around AI infrastructure.”",
      "text_sha256": "2a33a658a04a948b88f3e34578df4c2e464186bcda016a7f4ec3298fb212bcc8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0021",
      "chapter": 34,
      "start_offset": 4625,
      "end_offset": 4705,
      "text_exact": "“She also predicted coordinated bank runs in fourteen countries. Didn’t happen.”",
      "text_sha256": "5b699122aa6aabbf64ef4fcf01f5c7678a5a3a97e5e32e8d0d4ee28c5d5dc187",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0022",
      "chapter": 34,
      "start_offset": 4707,
      "end_offset": 4713,
      "text_exact": "“Yet.”",
      "text_sha256": "60ecaf0474955f9e6deb999972eeff5b6eda35f1edc17561e7b46a6de1867d44",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0023",
      "chapter": 34,
      "start_offset": 4715,
      "end_offset": 4734,
      "text_exact": "“Don’t become her.”",
      "text_sha256": "e2e21e7dfbbc51ec6dba414a03b04e92a892c0920d1bacca7d330d9de68e7afe",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0024",
      "chapter": 34,
      "start_offset": 4760,
      "end_offset": 4770,
      "text_exact": "“Meaning?”",
      "text_sha256": "fdb7f9e055ab62c8c17c766922619db538737c3840b8c4b17f482098af007e0c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0025",
      "chapter": 34,
      "start_offset": 4772,
      "end_offset": 4844,
      "text_exact": "“Don’t start loving the predictions that justify what you already fear.”",
      "text_sha256": "6857a6a49f3452d78ddc6ec448504b75439ce4e47e0de9058e2585b4a5082057",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0026",
      "chapter": 34,
      "start_offset": 5248,
      "end_offset": 5257,
      "text_exact": "“Useful,”",
      "text_sha256": "b116d685c677148b376a0c0f9f51a29ec525c76a9a78d8ce942d3745c6607a45",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0027",
      "chapter": 34,
      "start_offset": 5282,
      "end_offset": 5312,
      "text_exact": "“You approve of religion now?”",
      "text_sha256": "60bdd77e021c27a9afc6094f4708be2638fd5839b3a02ed22d3e74253a9d5840",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0028",
      "chapter": 34,
      "start_offset": 5314,
      "end_offset": 5431,
      "text_exact": "“I approve of anything that reduces the chance someone launches a missile because their cosmology feels embarrassed.”",
      "text_sha256": "12e710b855b17cc2f8559f904538e4825ddd28a9d24416a0e821be0c58d40a4a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0029",
      "chapter": 34,
      "start_offset": 5871,
      "end_offset": 5878,
      "text_exact": "“What?”",
      "text_sha256": "bf9ee250242dc9be6ae8a64cb636db6ea70186d990757358b8947787279f47cc",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0030",
      "chapter": 34,
      "start_offset": 5892,
      "end_offset": 5975,
      "text_exact": "“The world discovers possible creators and LOAM still wants to reroute fertilizer.”",
      "text_sha256": "993e2ba22bc2385c53ef32d3b8e546e8b278d3dc3a2d7230855c880217b58167",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0031",
      "chapter": 34,
      "start_offset": 6337,
      "end_offset": 6364,
      "text_exact": "“What would you call them?”",
      "text_sha256": "d4f8b3b34a6909bfaf32a21f5b5f594e4701a96de5cfedf41a04ad677823a347",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0032",
      "chapter": 34,
      "start_offset": 6379,
      "end_offset": 6388,
      "text_exact": "“Adults.”",
      "text_sha256": "c7538bd539f7e3897d5f293045ad4f0c0394bcf210c9385e01a0550d3a11375d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0033",
      "chapter": 34,
      "start_offset": 7064,
      "end_offset": 7108,
      "text_exact": "“If we do not debunk it, people believe it.”",
      "text_sha256": "c30d7e495d51066fba0ae415ae8448c0533a2a9bd994de11731954f0f06bfcf4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0034",
      "chapter": 34,
      "start_offset": 7110,
      "end_offset": 7197,
      "text_exact": "“If we debunk it at the top of the show, another forty million people learn it exists.”",
      "text_sha256": "66de9d6ed278ee9621799f0e58a10fda38e5258a4dcbe687b42277273629f384",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0035",
      "chapter": 34,
      "start_offset": 7199,
      "end_offset": 7218,
      "text_exact": "“So what do we do?”",
      "text_sha256": "bba19ee66485ffaee826d21d325e32d069b55bd07d64dd98f5e4f789016a60ef",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0036",
      "chapter": 34,
      "start_offset": 7220,
      "end_offset": 7280,
      "text_exact": "“Put the correction where the claim is already circulating.”",
      "text_sha256": "47eebdec19fd8292978a2e7181d1bd5ae9ae179d5c0c8ce14c351e64fc233bf0",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0037",
      "chapter": 34,
      "start_offset": 7282,
      "end_offset": 7306,
      "text_exact": "“That's not television.”",
      "text_sha256": "dfece12408697956768b8ec9f59de309b4dfedfe8cdd2e731989a8b3e4edc544",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0038",
      "chapter": 34,
      "start_offset": 7308,
      "end_offset": 7313,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0039",
      "chapter": 34,
      "start_offset": 8024,
      "end_offset": 8048,
      "text_exact": "“You have an interview.”",
      "text_sha256": "1138cb5be16ea262f2932bea85e18258b1881467aabb5b0ac8b28d8b05d2bc79",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0040",
      "chapter": 34,
      "start_offset": 8050,
      "end_offset": 8061,
      "text_exact": "“With who?”",
      "text_sha256": "d6bbf3dcc41905e8a9603f834a2a1d99dfff4a67e4432daa1abbdf782901a6be",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0041",
      "chapter": 34,
      "start_offset": 8063,
      "end_offset": 8076,
      "text_exact": "“Archbishop.”",
      "text_sha256": "ddb55f2d15e9029ccd3f54481185d6b50567167544a3e25a0cb5f6a67a62ed14",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0042",
      "chapter": 34,
      "start_offset": 8078,
      "end_offset": 8086,
      "text_exact": "“Which?”",
      "text_sha256": "95e9760c05f090b0f85966019108e6a6f04c74b6d7210f70a6db532b4358a2f2",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0043",
      "chapter": 34,
      "start_offset": 8088,
      "end_offset": 8105,
      "text_exact": "“Does it matter?”",
      "text_sha256": "991cecab1d5aca86057ffe8ac503ec5aba463dffda0c79177788a89665ce7a3c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0044",
      "chapter": 34,
      "start_offset": 8107,
      "end_offset": 8124,
      "text_exact": "“It will to him.”",
      "text_sha256": "5740ee42ea91e0b0fe5edbd722258fce3ec13b3f55fb67b33a69ff89c6886465",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0045",
      "chapter": 34,
      "start_offset": 8318,
      "end_offset": 8379,
      "text_exact": "“You want me to prove the absence of a secret alien archive?”",
      "text_sha256": "3815b41b4899f7bc999357d7561e9b78ffa151b198fb0cd849d0a44890e2aa82",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0046",
      "chapter": 34,
      "start_offset": 8381,
      "end_offset": 8387,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0047",
      "chapter": 34,
      "start_offset": 8389,
      "end_offset": 8395,
      "text_exact": "“How?”",
      "text_sha256": "036b3bfdf8856fad1588a4ab6947733c67446f422d26cdcd70bf24d3478b6e77",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0048",
      "chapter": 34,
      "start_offset": 8397,
      "end_offset": 8460,
      "text_exact": "“Show the provenance of the objects people claim came from it.”",
      "text_sha256": "b9a44e154f031d5aa5d15c5e30a9a4b339c971cb755361ff7c95f2c60b9e4afe",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0049",
      "chapter": 34,
      "start_offset": 8796,
      "end_offset": 8811,
      "text_exact": "“Boring enemy.”",
      "text_sha256": "7ee6a5ccaff6f6812de015369be9cd5633af73d58fb76b377547ff05517fde21",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0050",
      "chapter": 34,
      "start_offset": 9137,
      "end_offset": 9151,
      "text_exact": "“You have it.”",
      "text_sha256": "64da3dcbe6c27d5ccc0ac3a27fac7bb4948f83bf75e688e8e6151325dfb9416e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0051",
      "chapter": 34,
      "start_offset": 9153,
      "end_offset": 9159,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0052",
      "chapter": 34,
      "start_offset": 9161,
      "end_offset": 9178,
      "text_exact": "“Do not publish.”",
      "text_sha256": "16fbeec0d99b84c2faf34dc78899f0e84c37227783a699ae2b1dfe6a39701837",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0053",
      "chapter": 34,
      "start_offset": 9180,
      "end_offset": 9186,
      "text_exact": "“Why?”",
      "text_sha256": "6dc7823405b2c9acf1f403a64d9e17ac6bd8d83d609524bdfd391bdafd006205",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0054",
      "chapter": 34,
      "start_offset": 9188,
      "end_offset": 9262,
      "text_exact": "“Because three governments will interpret the posture shift as targeting.”",
      "text_sha256": "f18cb6cfb3bb74127246264970a8bda078c700258a752d3f5d5cea1918cd5da3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0055",
      "chapter": 34,
      "start_offset": 9264,
      "end_offset": 9272,
      "text_exact": "“Is it?”",
      "text_sha256": "ed8c256858ac7fd04b2ef2c4de5ad23e71e7c1dbe29d3b1f9844446f69919964",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0056",
      "chapter": 34,
      "start_offset": 9274,
      "end_offset": 9279,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0057",
      "chapter": 34,
      "start_offset": 9281,
      "end_offset": 9302,
      "text_exact": "“Can you prove that?”",
      "text_sha256": "d6507f68592952c84bb75d01a124ba7267a7aad9a3d73aa08579d5ec82e50b3c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0058",
      "chapter": 34,
      "start_offset": 9304,
      "end_offset": 9319,
      "text_exact": "“Not publicly.”",
      "text_sha256": "f6a737e546c0cb7a02f8e64a5e12da2a587fcc0d829d03b734162cc047c726d0",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0059",
      "chapter": 34,
      "start_offset": 9321,
      "end_offset": 9354,
      "text_exact": "“Then you understand my problem.”",
      "text_sha256": "3fd0ed7dc4bedfe60628c66035cde922c35949cd0c763d01b3c65dc0e5758e0e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0060",
      "chapter": 34,
      "start_offset": 9374,
      "end_offset": 9398,
      "text_exact": "“Give me a time window.”",
      "text_sha256": "b9970a287870042938262b7e9763c16bc8cae0c8955938838322676c4f2d3c69",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0061",
      "chapter": 34,
      "start_offset": 9400,
      "end_offset": 9411,
      "text_exact": "“For what?”",
      "text_sha256": "93b5aed5c80e35ccf1427eb75cd2ad41269c9f333722fdb5442f93a473ee2aab",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0062",
      "chapter": 34,
      "start_offset": 9413,
      "end_offset": 9478,
      "text_exact": "“For when publication stops creating immediate operational risk.”",
      "text_sha256": "10c2ed9c266306d2f0e59ef954d673f587a219bd082f1e3c900d1e324dcf7add",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0063",
      "chapter": 34,
      "start_offset": 9480,
      "end_offset": 9492,
      "text_exact": "“Six hours.”",
      "text_sha256": "8082a9d95be5bba695178668171eb2ce95aa8f8452e46b134a519bcc9cc3a8ec",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0064",
      "chapter": 34,
      "start_offset": 9494,
      "end_offset": 9504,
      "text_exact": "“Why six?”",
      "text_sha256": "78358342d042a04f98b9350394fcef4a64bf1bce4c963c27a852b3c56a887c6b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0065",
      "chapter": 34,
      "start_offset": 9506,
      "end_offset": 9555,
      "text_exact": "“Because readiness posture changes at 12:00 UTC.”",
      "text_sha256": "15d43bd42171f98c143872917f25b3db070fc73b6831c661e27162815c577486",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0066",
      "chapter": 34,
      "start_offset": 9614,
      "end_offset": 9623,
      "text_exact": "“Agreed.”",
      "text_sha256": "b705c18b53d8f67c3f95b93efbbe1f940519987da92f110dbb0e5a709ca02476",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0067",
      "chapter": 34,
      "start_offset": 9641,
      "end_offset": 9682,
      "text_exact": "“You just accepted an embargo from Pike.”",
      "text_sha256": "bb2f47b1de2b2e32840e6c1a13bc28402e51efc3f05491f96cfb66a1d7d3f588",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0068",
      "chapter": 34,
      "start_offset": 9684,
      "end_offset": 9696,
      "text_exact": "“Temporary.”",
      "text_sha256": "a06e10dddb7ee8095775b06c116d3e682949a165933879706e907c87298a2616",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0069",
      "chapter": 34,
      "start_offset": 9698,
      "end_offset": 9738,
      "text_exact": "“Based on information we cannot verify.”",
      "text_sha256": "c5b5851968d09a56321bc0630ba30901f9c6375616784eb5fa6a30920e82149c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0070",
      "chapter": 34,
      "start_offset": 9740,
      "end_offset": 9769,
      "text_exact": "“We can verify the document.”",
      "text_sha256": "9e3d5ee6c25d1a2f0dcb34261e475e1a2eea2b7a9ef3276bf5a6a2d077eb48c1",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0071",
      "chapter": 34,
      "start_offset": 9771,
      "end_offset": 9792,
      "text_exact": "“Not her risk claim.”",
      "text_sha256": "d915c79da20c723b3665f10666fe618f27f60b7008730e5169d24f5fd76b29d6",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0072",
      "chapter": 34,
      "start_offset": 10038,
      "end_offset": 10045,
      "text_exact": "“Good.”",
      "text_sha256": "da1b98ef03728a55d7b450595409dbd3c2ad61106ccc1bd6e2bc0e2a1c59839a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0073",
      "chapter": 34,
      "start_offset": 10047,
      "end_offset": 10054,
      "text_exact": "“What?”",
      "text_sha256": "bf9ee250242dc9be6ae8a64cb636db6ea70186d990757358b8947787279f47cc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0074",
      "chapter": 34,
      "start_offset": 10056,
      "end_offset": 10103,
      "text_exact": "“You gave the secrecy an expiration condition.”",
      "text_sha256": "12f6d940ade507f23c96613534a50775aa50a7686ec1d0060e5a38aebf145d34",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0075",
      "chapter": 34,
      "start_offset": 10481,
      "end_offset": 10541,
      "text_exact": "“What is the most important thing people are getting wrong?”",
      "text_sha256": "37dbb4262de59197112f51ba06d6f30a2f37f4121684c80752f0d471ee948b07",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0076",
      "chapter": 34,
      "start_offset": 10554,
      "end_offset": 10641,
      "text_exact": "“That confirmation of one hidden history makes every hidden-history claim more likely.”",
      "text_sha256": "72db0a9b1705d7c562641007e9fce664b3a83ff51e62edf0bd030fc732d8e701",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0077",
      "chapter": 34,
      "start_offset": 10643,
      "end_offset": 10656,
      "text_exact": "“Doesn't it?”",
      "text_sha256": "de26974da7189f06657fbd25eabc403ed265c0f32535c60f323a61623b5e7447",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0078",
      "chapter": 34,
      "start_offset": 10658,
      "end_offset": 10665,
      "text_exact": "“Some.”",
      "text_sha256": "85cb1f1bcb1e9ab991ce2d53890decf9386ef2fea6f9102960e10a1b3f5f4e3d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0079",
      "chapter": 34,
      "start_offset": 10667,
      "end_offset": 10675,
      "text_exact": "“Which?”",
      "text_sha256": "95e9760c05f090b0f85966019108e6a6f04c74b6d7210f70a6db532b4358a2f2",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0080",
      "chapter": 34,
      "start_offset": 10677,
      "end_offset": 10732,
      "text_exact": "“The ones that share mechanisms supported by evidence.”",
      "text_sha256": "cd037a7618c7f71cfa447b17f4e0daa2f79e8afe2f4ec7454e540b6dba59fe04",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0081",
      "chapter": 34,
      "start_offset": 10763,
      "end_offset": 10847,
      "text_exact": "“An extraordinary discovery expands possibility space. It does not erase standards.”",
      "text_sha256": "62cf0764a3fa90f29c2949380011feba1d8e1704c5944c2ece17c013ac4665d4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0082",
      "chapter": 34,
      "start_offset": 11585,
      "end_offset": 11640,
      "text_exact": "“Maybe that is what keeps this from becoming religion.”",
      "text_sha256": "d4b6931c23f2de28d111eb5eda08c1c96d706528132754b859510d83e40f411a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0083",
      "chapter": 34,
      "start_offset": 12701,
      "end_offset": 12724,
      "text_exact": "“Why give them oxygen?”",
      "text_sha256": "0d9d3f465375f9a1fe1524c3f27f8fa275e1d87e59575c6b07ca396f2ab898c3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0084",
      "chapter": 34,
      "start_offset": 12726,
      "end_offset": 12808,
      "text_exact": "“Because pseudo-history becomes dangerous when it attaches hierarchy to ancestry.”",
      "text_sha256": "a383d1e1c553593732349d4dc857385bf7ccec4d84a2abd31b9ba52d135fb1d1",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0085",
      "chapter": 34,
      "start_offset": 13002,
      "end_offset": 13018,
      "text_exact": "“Visitor blood.”",
      "text_sha256": "89c18ac4f02f39604cd3b22975e0b07de579cda7b9b75565a7d556a8d87cde2d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0086",
      "chapter": 34,
      "start_offset": 13941,
      "end_offset": 13971,
      "text_exact": "“That is the actual conflict.”",
      "text_sha256": "717fe8f0e70123cdb1576435e0a8875b5bd55f5cf82a585d65fbd20964a46f4a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0087",
      "chapter": 34,
      "start_offset": 13990,
      "end_offset": 14003,
      "text_exact": "“Not belief.”",
      "text_sha256": "57adfac444945e890cdf4615ed152fca45582f4f9daad12c0140307c4e682d46",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0088",
      "chapter": 34,
      "start_offset": 14005,
      "end_offset": 14015,
      "text_exact": "“Custody.”",
      "text_sha256": "ed87dfd784249a8b9990e27820a186b2d742ad81b5e348599606ffb19c403356",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0089",
      "chapter": 34,
      "start_offset": 14557,
      "end_offset": 14567,
      "text_exact": "“Meaning?”",
      "text_sha256": "fdb7f9e055ab62c8c17c766922619db538737c3840b8c4b17f482098af007e0c",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0090",
      "chapter": 34,
      "start_offset": 14585,
      "end_offset": 14665,
      "text_exact": "“People can tolerate uncertainty better than being lied to about its existence.”",
      "text_sha256": "6e4d7185a5d52d7466da49bf2e26e93e3deaafc7f84709cfd42f6621ccc9218b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0091",
      "chapter": 34,
      "start_offset": 14769,
      "end_offset": 14785,
      "text_exact": "“What happened?”",
      "text_sha256": "3a29c49456a7f6861930dfc9c8dbe16ed7891bbcb56e95c5a4ad89515caa6cdd",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0092",
      "chapter": 34,
      "start_offset": 14841,
      "end_offset": 14867,
      "text_exact": "“We became the authority.”",
      "text_sha256": "c9f2f7d50805d50750e8174219a83903bb252dfa319ce52d10f0d7005d6c601a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0093",
      "chapter": 34,
      "start_offset": 14869,
      "end_offset": 14890,
      "text_exact": "“That was the point.”",
      "text_sha256": "65fa4b94c7ce5c237be7e434f3800687c0b933a1f28374ccc197a837eafa505f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0094",
      "chapter": 34,
      "start_offset": 14892,
      "end_offset": 14925,
      "text_exact": "“No. The point was verification.”",
      "text_sha256": "c5de2ceca51f991aa20f4f99dd0c876d0febd82ab716c9afca007d8fcdaea03e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0095",
      "chapter": 34,
      "start_offset": 15301,
      "end_offset": 15376,
      "text_exact": "“We built a tool to preserve uncertainty. People turned it into a ranking.”",
      "text_sha256": "fd26e641d3cc5400ce5581fd6b96987c95bdb0f7e2f1739ad0a668c435d98d11",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0096",
      "chapter": 34,
      "start_offset": 15495,
      "end_offset": 15513,
      "text_exact": "“What did you do?”",
      "text_sha256": "48c7e225c64c7a540bebb63214720e4d2bb75174bedd264340c8e7eaad08e11e",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0097",
      "chapter": 34,
      "start_offset": 15527,
      "end_offset": 15576,
      "text_exact": "“We stopped accepting submissions for six hours.”",
      "text_sha256": "4e4419523801201c4af442922324318256739cddf4b73029ffd4103a44f0b63f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0098",
      "chapter": 34,
      "start_offset": 15578,
      "end_offset": 15670,
      "text_exact": "“You took down one of the largest mirrors during the biggest information crisis in history.”",
      "text_sha256": "5b9523589749f69f170140f30faa767857e13fd98cbc496b12454c0c72d90d23",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0099",
      "chapter": 34,
      "start_offset": 15672,
      "end_offset": 15678,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0100",
      "chapter": 34,
      "start_offset": 15680,
      "end_offset": 15702,
      "text_exact": "“People were furious.”",
      "text_sha256": "f3ef7cd4e4c141fd3e9c4a58e0228de0aaba4021394e6f6a04b58a0681b40d99",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0101",
      "chapter": 34,
      "start_offset": 15704,
      "end_offset": 15710,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch34-d0102",
      "chapter": 34,
      "start_offset": 15712,
      "end_offset": 15718,
      "text_exact": "“Why?”",
      "text_sha256": "6dc7823405b2c9acf1f403a64d9e17ac6bd8d83d609524bdfd391bdafd006205",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
