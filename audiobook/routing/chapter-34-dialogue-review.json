      "dialogue_id": "ch34-d0103",
      "chapter": 34,
      "start_offset": 15720,
      "end_offset": 15744,
      "text_exact": "“To rewrite the labels.”",
      "text_sha256": "9987431a431ca8d354072e5ebd30866858445f16fbbd6d8923c7c367644808fa",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
