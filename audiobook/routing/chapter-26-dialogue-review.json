{
  "schema_version": 1,
  "chapter": 26,
  "chapter_title": "AFTER THE TURN",
  "chapter_sha256": "e4bac85aa57570448425aed8d0138a9c75de5aad27972bb91ee38da76810fb8e",
  "policy": "No unresolved dialogue may fall back to narrator. render_allowed remains false until human approval.",
  "counts": {
    "dialogue_spans": 85,
    "explicit_named": 20,
    "unresolved": 65,
    "approved": 0
  },
  "spans": [
    {
      "dialogue_id": "ch26-d0001",
      "chapter": 26,
      "start_offset": 149,
      "end_offset": 182,
      "text_exact": "“I preferred the cosmic tyranny,”",
      "text_sha256": "09f4775a062ec048aef126a18b348a9894bfeebe39798d0917da0c5e58424e82",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0002",
      "chapter": 26,
      "start_offset": 226,
      "end_offset": 250,
      "text_exact": "“At least it was clean.”",
      "text_sha256": "143ad1d946e68191e556c38edd6f788cccab926e7b0403eaf1c9b3115a225668",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0003",
      "chapter": 26,
      "start_offset": 252,
      "end_offset": 315,
      "text_exact": "“Clean stories are usually where someone washed the blood off,”",
      "text_sha256": "aa44a931edb91642d41c28d9f5c763bda12d7ccfeabd9facdd987e0ab0393484",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0004",
      "chapter": 26,
      "start_offset": 1002,
      "end_offset": 1029,
      "text_exact": "“Could the others be lost?”",
      "text_sha256": "ecba65020369fac48e457964b539a22e187b12ccc976b4d71714feebb1a10c77",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0005",
      "chapter": 26,
      "start_offset": 1043,
      "end_offset": 1049,
      "text_exact": "“Yes,”",
      "text_sha256": "962de7fb6fae75af56fade68f4c6749cef2bb0359757cabcea0e02437a368c4b",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0006",
      "chapter": 26,
      "start_offset": 1177,
      "end_offset": 1208,
      "text_exact": "“Someone removed disagreement.”",
      "text_sha256": "9f9ed3ab57eb2d012dbd349bc5d41be74b98a2dc3c9086688ef6017588311bea",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0007",
      "chapter": 26,
      "start_offset": 1210,
      "end_offset": 1268,
      "text_exact": "“Or disagreement was stored in a region we don't possess.”",
      "text_sha256": "c233610b103e93f72356ec163084b179b821f3b8798ac815e19bb2aed949ff78",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0008",
      "chapter": 26,
      "start_offset": 1270,
      "end_offset": 1286,
      "text_exact": "“Also possible.”",
      "text_sha256": "a18ce3e34868df8d9dbcf874e7b469d6f0173a0eb0bd1893ac43af295fa57a65",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0009",
      "chapter": 26,
      "start_offset": 1814,
      "end_offset": 1867,
      "text_exact": "“So he just killed people he thought were dangerous.”",
      "text_sha256": "3a69438b5f246979efd222c3885715a00d9ea64c421e7b2ecf4c0aab1ec248ff",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0010",
      "chapter": 26,
      "start_offset": 1880,
      "end_offset": 1904,
      "text_exact": "“We do not know motive.”",
      "text_sha256": "f1b5e8aaaabe1951d07891cda37e690c57f3413ddd75a4e875c824007a0995d2",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0011",
      "chapter": 26,
      "start_offset": 1906,
      "end_offset": 1928,
      "text_exact": "“You keep saving him.”",
      "text_sha256": "6659ee1529eab4cf5d91f4bd96e75e691abbb63356ffcaee92a3e181eddcf4bf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0012",
      "chapter": 26,
      "start_offset": 1930,
      "end_offset": 1968,
      "text_exact": "“I keep saving the evidence from you.”",
      "text_sha256": "bdffbb8717ff77a3906f2ff008341eed92827170c390db1046bf805d15855e6e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0013",
      "chapter": 26,
      "start_offset": 1992,
      "end_offset": 2011,
      "text_exact": "“Both of you stop.”",
      "text_sha256": "cafb3aff3c105e625046c76b5749ace40300191e659aeb5273caf5e8a474ae0a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0014",
      "chapter": 26,
      "start_offset": 2041,
      "end_offset": 2211,
      "text_exact": "“The important thing is not whether Shaal-Amur was evil. It's whether the system could distinguish legitimate emergency action from someone claiming emergency authority.”",
      "text_sha256": "3d6d8404847ccd9cbfbb0c79b3e7931cc1608f0d536306e0de6a0b6ed6a59187",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0015",
      "chapter": 26,
      "start_offset": 2267,
      "end_offset": 2278,
      "text_exact": "“Could it?”",
      "text_sha256": "266d30b3c5346ae7ee9451e798f4106ae36758c378cdeb4299a1f19805b686b7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0016",
      "chapter": 26,
      "start_offset": 2382,
      "end_offset": 2405,
      "text_exact": "“When did they change?”",
      "text_sha256": "6ed8f2af2bee74f88f832093b22ddf39c64e538f13850de1b43c2cba20b8451a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0017",
      "chapter": 26,
      "start_offset": 2751,
      "end_offset": 2765,
      "text_exact": "“There it is.”",
      "text_sha256": "6d01a8e9aca3796e869aed9dd0e86b6558b49835fa5a7043ba7b0940f47d0c0c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0018",
      "chapter": 26,
      "start_offset": 3049,
      "end_offset": 3102,
      "text_exact": "“So order may not be corruption in the simple sense.”",
      "text_sha256": "49ed92adee68a26de722cb78181d0f487efa806c47a27122f1116161bb4ddfa0",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0019",
      "chapter": 26,
      "start_offset": 3104,
      "end_offset": 3109,
      "text_exact": "“No,”",
      "text_sha256": "0a405d0f063d8a504bcc2dbc25e87880c12d00e2e4284e04b69c64f5d8f7a73a",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0020",
      "chapter": 26,
      "start_offset": 3124,
      "end_offset": 3175,
      "text_exact": "“It could be emergency code that became permanent.”",
      "text_sha256": "45db77e293de390facd06a400f9b229e11721a331fb5b36642372b67eb0b3a66",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0021",
      "chapter": 26,
      "start_offset": 3209,
      "end_offset": 3262,
      "text_exact": "“That's somehow more believable and more depressing.”",
      "text_sha256": "bf9888b6f02ee20ada35817e8050d03c81314c19fcf6a9d8df0a0ef7a0a23f88",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0022",
      "chapter": 26,
      "start_offset": 3458,
      "end_offset": 3505,
      "text_exact": "“That sounds like somebody wrote it yesterday.”",
      "text_sha256": "fce5ea2e61f6ca793925ca58400cb1949d8a92772d1d4b6ef926a8c7ef831e9a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0023",
      "chapter": 26,
      "start_offset": 3507,
      "end_offset": 3552,
      "text_exact": "“Which is exactly why we should distrust it,”",
      "text_sha256": "1e410fa8895118bd3551a04cf261bd9e4621b0a17a8f3302211a97a211348fdb",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0024",
      "chapter": 26,
      "start_offset": 3609,
      "end_offset": 3616,
      "text_exact": "“Good.”",
      "text_sha256": "da1b98ef03728a55d7b450595409dbd3c2ad61106ccc1bd6e2bc0e2a1c59839a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0025",
      "chapter": 26,
      "start_offset": 3888,
      "end_offset": 3990,
      "text_exact": "“My directorate has emergency powers that renew automatically during anomalous disclosure conditions.”",
      "text_sha256": "5cbbcda52137d6344da1df9c237428424a98a9cba3b9ba6e796c9357cd305423",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0026",
      "chapter": 26,
      "start_offset": 4006,
      "end_offset": 4023,
      "text_exact": "“You're kidding.”",
      "text_sha256": "465d041e19f7d5b9d2aaae309eb13cd097fb31d7c0f2f593026c936be233564c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0027",
      "chapter": 26,
      "start_offset": 4025,
      "end_offset": 4030,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0028",
      "chapter": 26,
      "start_offset": 4032,
      "end_offset": 4067,
      "text_exact": "“How long have they been renewing?”",
      "text_sha256": "333b7fcc14e5fb56a5626868e686813685b4f304ef160e6dbc910cfe0fd98eed",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0029",
      "chapter": 26,
      "start_offset": 4069,
      "end_offset": 4088,
      "text_exact": "“Twenty-six years.”",
      "text_sha256": "a0afa6af379079eabb718c5d41704cbd09ea79adfa42476db58e9f2562389786",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0030",
      "chapter": 26,
      "start_offset": 4135,
      "end_offset": 4202,
      "text_exact": "“I was about to criticize a species for doing exactly what we did.”",
      "text_sha256": "50f58f7501751d477e2cbc20890b72afe6e06a3e97580c058f3c657cfe9d3029",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0031",
      "chapter": 26,
      "start_offset": 4216,
      "end_offset": 4252,
      "text_exact": "“That doesn't make the cases equal.”",
      "text_sha256": "3dd68d25d05adf8c360bd5bda8671ba07230aded14b3f80e7666396927045363",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0032",
      "chapter": 26,
      "start_offset": 4254,
      "end_offset": 4294,
      "text_exact": "“No. It makes the pattern recognizable.”",
      "text_sha256": "bb92e5d4d98311d1e60b46e61fa8851f1d195a76e116cf1e243bb5bda6f3fb84",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0033",
      "chapter": 26,
      "start_offset": 4753,
      "end_offset": 4760,
      "text_exact": "“Half.”",
      "text_sha256": "c8fb0f29a147eec7bb3e22c44a57ec62ff2b3184bd82ca44a5983505c402ae08",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0034",
      "chapter": 26,
      "start_offset": 5305,
      "end_offset": 5408,
      "text_exact": "“If ORDER influenced what we chose to translate first, then every downstream priority is contaminated.”",
      "text_sha256": "95f48ff3afaa9cf1fbc4cfc062fceb0ecafaef48cee5038daae56f15db4f1cc7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0035",
      "chapter": 26,
      "start_offset": 5426,
      "end_offset": 5455,
      "text_exact": "“Contaminated is too strong.”",
      "text_sha256": "17671e62305b4ce5b0a31eba2ff9ac1105318d95ab3d2f4c8a6da1c6c3263e44",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0036",
      "chapter": 26,
      "start_offset": 5457,
      "end_offset": 5466,
      "text_exact": "“Biased.”",
      "text_sha256": "2f177de0da0731ab4d536c6a4d32136a84c99610f80dfd6d486c1724b81567ac",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0037",
      "chapter": 26,
      "start_offset": 5468,
      "end_offset": 5486,
      "text_exact": "“Also too strong.”",
      "text_sha256": "79cbd90e66556878406fbdeba300a97fa1f6a506b5b0958b5b61f4c3ef8c3123",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0038",
      "chapter": 26,
      "start_offset": 5488,
      "end_offset": 5502,
      "text_exact": "“Conditioned.”",
      "text_sha256": "ad001cfd8ecd66a7904621642b20ac1f74d26e8831e6db78cc83dfde83769cb3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0039",
      "chapter": 26,
      "start_offset": 5522,
      "end_offset": 5529,
      "text_exact": "“Fine.”",
      "text_sha256": "872ee3d75c6fc05922c2910ab52121b05e89e517bf43b5b9c5e32f2911d21197",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0040",
      "chapter": 26,
      "start_offset": 6095,
      "end_offset": 6127,
      "text_exact": "“Three witnesses approved this.”",
      "text_sha256": "8cce8ee1ef4cfa4dd6ba02511434e17f3a423737c4f85fad2d481e7763e7d3ff",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0041",
      "chapter": 26,
      "start_offset": 6129,
      "end_offset": 6135,
      "text_exact": "“Yes,”",
      "text_sha256": "962de7fb6fae75af56fade68f4c6749cef2bb0359757cabcea0e02437a368c4b",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0042",
      "chapter": 26,
      "start_offset": 6149,
      "end_offset": 6174,
      "text_exact": "“So the protocol failed.”",
      "text_sha256": "437fc235772f859af3fdb47f5de15ac693d83a56f89a309cc233663572a444fc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0043",
      "chapter": 26,
      "start_offset": 6176,
      "end_offset": 6193,
      "text_exact": "“Protocols fail.”",
      "text_sha256": "2b493169f04485953d13d217c8979150589391a0aa087d23ebe6824abed368ad",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0044",
      "chapter": 26,
      "start_offset": 6195,
      "end_offset": 6218,
      "text_exact": "“That seems important.”",
      "text_sha256": "3862b102f5d6ed8f76aabf0c6b2283fb00226e9ba4f546aa77893f703a6f2a60",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0045",
      "chapter": 26,
      "start_offset": 6220,
      "end_offset": 6228,
      "text_exact": "“It is.”",
      "text_sha256": "d76bf24eb4e0f3f75d4b4cd22b206b47ea2b7e1530f2f51e16b56ce30d76b691",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0046",
      "chapter": 26,
      "start_offset": 6634,
      "end_offset": 6677,
      "text_exact": "“So even the root protocol is not perfect.”",
      "text_sha256": "0556d714e506ebecd7ce1f4bcc78050456d4068eb6dfeed51669e67f157c134b",
      "speaker": "seren",
      "speaker_display": "Seren",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0047",
      "chapter": 26,
      "start_offset": 7256,
      "end_offset": 7279,
      "text_exact": "“Then why preserve it?”",
      "text_sha256": "95a2b3b2acff29c2fd2b878d646fda121eb82872262f442117994894d18d9768",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0048",
      "chapter": 26,
      "start_offset": 7529,
      "end_offset": 7575,
      "text_exact": "“You understand what this does to disclosure.”",
      "text_sha256": "5a690730772278e6ba864b0499b5425e12d03fd07fc92020f483e1e86ece4a04",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0049",
      "chapter": 26,
      "start_offset": 7589,
      "end_offset": 7617,
      "text_exact": "“Makes it more complicated.”",
      "text_sha256": "d83249915c09ef22a32752a556e45a0b80656806d1d83e15209c336aab5bba1b",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0050",
      "chapter": 26,
      "start_offset": 7619,
      "end_offset": 7655,
      "text_exact": "“It makes it impossible to package.”",
      "text_sha256": "7ebc724a45277013c8a4cf8105a0b7e4e81276564f8648f42fdec09343e32c78",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0051",
      "chapter": 26,
      "start_offset": 7657,
      "end_offset": 7664,
      "text_exact": "“Good.”",
      "text_sha256": "da1b98ef03728a55d7b450595409dbd3c2ad61106ccc1bd6e2bc0e2a1c59839a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0052",
      "chapter": 26,
      "start_offset": 7666,
      "end_offset": 7713,
      "text_exact": "“No, Nico. Not everything complicated is good.”",
      "text_sha256": "8acf08485cb06c6d6a29edb6c4b4416cfd3996234b60dd6ca35799f21e55c2a5",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0053",
      "chapter": 26,
      "start_offset": 7744,
      "end_offset": 7821,
      "text_exact": "“The public will want the first text. The real law. The uncorrupted version.”",
      "text_sha256": "1599103324865f31c8567cd68f19e54b9dce12c36b6138203cc2def99e22dd33",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0054",
      "chapter": 26,
      "start_offset": 7838,
      "end_offset": 7911,
      "text_exact": "“And we will have to tell them there is no pristine constitutional Eden.”",
      "text_sha256": "442abebe1b90aea65e75abe30ad45ba7a65f3cb44fa544eff64a14b9af5d8ae9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0055",
      "chapter": 26,
      "start_offset": 8558,
      "end_offset": 8569,
      "text_exact": "“You okay?”",
      "text_sha256": "0f2c2225629f68c636edba0bbab845c291ab0334c1fbdb673ecce008d11d9812",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0056",
      "chapter": 26,
      "start_offset": 8571,
      "end_offset": 8576,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0057",
      "chapter": 26,
      "start_offset": 8578,
      "end_offset": 8585,
      "text_exact": "“Same.”",
      "text_sha256": "20bcee9982c3deb28b87c07fb21b5561817060c2bab8cbdcf845fb241823a824",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0058",
      "chapter": 26,
      "start_offset": 8623,
      "end_offset": 8685,
      "text_exact": "“I liked the twist better when it meant Shaal-Amur was wrong.”",
      "text_sha256": "6b5a022a38fcdec59dabb2b9ceee671243f8aaff5d8801b04c665aa4f382b9e6",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0059",
      "chapter": 26,
      "start_offset": 8705,
      "end_offset": 8735,
      "text_exact": "“That would have been easier.”",
      "text_sha256": "9947f6adc03044fe50dfd4f4c4c8c2d8df00f604e0a7dd41c1f540c50e03f298",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0060",
      "chapter": 26,
      "start_offset": 8737,
      "end_offset": 8762,
      "text_exact": "“Now everyone was wrong.”",
      "text_sha256": "79c674fb7e5c5f5b9ad4cacb847900f090b80849107bb0521f68c7d2eb2e34e7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0061",
      "chapter": 26,
      "start_offset": 8764,
      "end_offset": 8781,
      "text_exact": "“More realistic.”",
      "text_sha256": "55f45f93dcc967016231d97a64f4586aab8131d06aa4cfb41fd40057260f5574",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0062",
      "chapter": 26,
      "start_offset": 8811,
      "end_offset": 8840,
      "text_exact": "“Does this change the story?”",
      "text_sha256": "66d2f55b93ab053a5b8088178b345e82e05c0cc7ff11664179006b07d926c82b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0063",
      "chapter": 26,
      "start_offset": 8866,
      "end_offset": 8897,
      "text_exact": "“It changes the kind of story.”",
      "text_sha256": "6aaffe2f94cde4d643f1e5e8d0cb348d519052176802e704724a5c3a0311fb3b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0064",
      "chapter": 26,
      "start_offset": 8899,
      "end_offset": 8905,
      "text_exact": "“How?”",
      "text_sha256": "036b3bfdf8856fad1588a4ab6947733c67446f422d26cdcd70bf24d3478b6e77",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0065",
      "chapter": 26,
      "start_offset": 8925,
      "end_offset": 8976,
      "text_exact": "“Before, we thought somebody had hidden the truth.”",
      "text_sha256": "b1d0e02ba1e23101bd73082ffea66fd2475acfbb717ec5660a5586aa9ae6c620",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0066",
      "chapter": 26,
      "start_offset": 8978,
      "end_offset": 8988,
      "text_exact": "“And now?”",
      "text_sha256": "e71b5b41fcb20f3e269f956dc0b47ee0387109b39b8e064abf5930775bb9b89c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0067",
      "chapter": 26,
      "start_offset": 8990,
      "end_offset": 9067,
      "text_exact": "“Now I think the truth changed shape while people kept using the same words.”",
      "text_sha256": "d6dbe9b66bea23ca7ef7dc52f54b4e9ba4fb54f83399947c9a55a09465dc7a11",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0068",
      "chapter": 26,
      "start_offset": 9679,
      "end_offset": 9691,
      "text_exact": "“Of course.”",
      "text_sha256": "79c08c89c1cebe27ec4298287aae8a5585fb5ee45cb8dddec0f7b13a981cbe99",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0069",
      "chapter": 26,
      "start_offset": 9717,
      "end_offset": 9724,
      "text_exact": "“What?”",
      "text_sha256": "bf9ee250242dc9be6ae8a64cb636db6ea70186d990757358b8947787279f47cc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0070",
      "chapter": 26,
      "start_offset": 9726,
      "end_offset": 9788,
      "text_exact": "“The person breaking civilizations called himself continuity.”",
      "text_sha256": "b259385ceabdbd2d21e06ccf008ca9acab82cc5d09956d7fdf9dd6baea12de96",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0071",
      "chapter": 26,
      "start_offset": 9895,
      "end_offset": 9917,
      "text_exact": "“Permanent emergency.”",
      "text_sha256": "95fd03aceb04f85b73722732622513ffc72f1c61bf310b6b2db1bba7c6b0fde5",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0072",
      "chapter": 26,
      "start_offset": 10478,
      "end_offset": 10512,
      "text_exact": "“This is worse than a conspiracy.”",
      "text_sha256": "ff543d6e71da57fa93aecd2a7d06d68cd3139fe504fd45cedfc26d5b1b4ab17a",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0073",
      "chapter": 26,
      "start_offset": 10525,
      "end_offset": 10531,
      "text_exact": "“How?”",
      "text_sha256": "036b3bfdf8856fad1588a4ab6947733c67446f422d26cdcd70bf24d3478b6e77",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0074",
      "chapter": 26,
      "start_offset": 10533,
      "end_offset": 10553,
      "text_exact": "“It is bureaucracy.”",
      "text_sha256": "46f7d6c01c68a898b159e608860221a297d04b388f63e854c77204544f332a32",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0075",
      "chapter": 26,
      "start_offset": 10973,
      "end_offset": 11001,
      "text_exact": "“That is the whole disease.”",
      "text_sha256": "9088ae661a22f4c7322fc69842f1ba5a023c09c5bfb4afef2d9c340e97191e5b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0076",
      "chapter": 26,
      "start_offset": 11017,
      "end_offset": 11080,
      "text_exact": "“The system began treating the safety mechanism as the threat.”",
      "text_sha256": "37c21498b356cf88f3042d2e5c03cad82fc23f55c405a69cf162caaa15cdf21f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0077",
      "chapter": 26,
      "start_offset": 11501,
      "end_offset": 11510,
      "text_exact": "“Do not.”",
      "text_sha256": "f36c9cc975475ee17cb42ac5448bf3971fdd661bef2822511b69ef5a02f9339b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0078",
      "chapter": 26,
      "start_offset": 11512,
      "end_offset": 11537,
      "text_exact": "“I did not say anything.”",
      "text_sha256": "6b494eb72072a016a62163bff49e657b26fba38a58db432501545bf7bea19118",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0079",
      "chapter": 26,
      "start_offset": 11539,
      "end_offset": 11569,
      "text_exact": "“You were thinking it loudly.”",
      "text_sha256": "5fbb4d2d1763f2722f2f93c334872465d174e8660e77c5d515dd81abf19a4afe",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0080",
      "chapter": 26,
      "start_offset": 11972,
      "end_offset": 11998,
      "text_exact": "“This is where it starts.”",
      "text_sha256": "6623863b78bbdc8c88af57d94a41123c03771cca022f792645f21d2dc0429bee",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0081",
      "chapter": 26,
      "start_offset": 12022,
      "end_offset": 12027,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0082",
      "chapter": 26,
      "start_offset": 12048,
      "end_offset": 12091,
      "text_exact": "“This is where the record becomes visible.”",
      "text_sha256": "03be71ce5c11f45d0413d41872c5084b9696b5cb485bc80fc139472ebc7c4bc1",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0083",
      "chapter": 26,
      "start_offset": 12276,
      "end_offset": 12343,
      "text_exact": "“Systems do not become corrupt on the day someone finally notices.”",
      "text_sha256": "1c2b2ea9bb19cf6bfd204e8b19e269db7f78818f53b80d2618f073af34e929b7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0084",
      "chapter": 26,
      "start_offset": 12610,
      "end_offset": 12619,
      "text_exact": "“Killed?”",
      "text_sha256": "c055200e631a1b547939304660ce1b4a1358dbf56e944c73a252c1c7077aeda3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch26-d0085",
      "chapter": 26,
      "start_offset": 12634,
      "end_offset": 12644,
      "text_exact": "“Unknown.”",
      "text_sha256": "537681d0ed67c7f7e2eeef9868ba63f16c27bf1d47b45a5ea4606228bbf03769",
      "speaker": "seren",
      "speaker_display": "Seren",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    }
  ]
}
