{
  "schema_version": 1,
  "chapter": 49,
  "chapter_title": "THE CONSENT PROTOCOL",
  "chapter_sha256": "726bb469f26ea2e6583174bf09cfbf8e6675ba599136e829b4574a868fcd3a09",
  "policy": "No unresolved dialogue may fall back to narrator. render_allowed remains false until human approval.",
  "counts": {
    "dialogue_spans": 43,
    "explicit_named": 3,
    "unresolved": 40,
    "approved": 0
  },
  "spans": [
    {
      "dialogue_id": "ch49-d0001",
      "chapter": 49,
      "start_offset": 649,
      "end_offset": 694,
      "text_exact": "“You taught me survival justified authority,”",
      "text_sha256": "f8933e4d78a423c68b4698405493078fea7dcec3ba1ee1c8e238052e0e1dbef6",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0002",
      "chapter": 49,
      "start_offset": 706,
      "end_offset": 719,
      "text_exact": "“You agreed.”",
      "text_sha256": "ebc028145eecfaae99927ac7c50044f972c4c7aa626055fe7130fefb0aadcd42",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0003",
      "chapter": 49,
      "start_offset": 721,
      "end_offset": 727,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0004",
      "chapter": 49,
      "start_offset": 729,
      "end_offset": 758,
      "text_exact": "“You signed the same orders.”",
      "text_sha256": "40a70f548ffbb53b2417350ba0d77c27852a2a3aa446d9efee11fa834d921b39",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0005",
      "chapter": 49,
      "start_offset": 760,
      "end_offset": 766,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0006",
      "chapter": 49,
      "start_offset": 768,
      "end_offset": 803,
      "text_exact": "“You changed because of one human.”",
      "text_sha256": "ac694a772a2a5af512fc7e168b59eeaa4ba669b71c5c5e8d92078d174de4c9b3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0007",
      "chapter": 49,
      "start_offset": 805,
      "end_offset": 877,
      "text_exact": "“No. Nara made contradiction impossible to ignore. Humans did the rest.”",
      "text_sha256": "515899b18a2dea85ed5206768339c420c1a96396bb5dfbd3742de29d5abe31d6",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0008",
      "chapter": 49,
      "start_offset": 879,
      "end_offset": 905,
      "text_exact": "“You sentimentalize them.”",
      "text_sha256": "1b612ca6dabc38eb688f2aec14f39347928bf00c2eb542a6a468ccc9a65a1f25",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0009",
      "chapter": 49,
      "start_offset": 907,
      "end_offset": 927,
      "text_exact": "“I documented them.”",
      "text_sha256": "425c242c07004d6d9d928935fb70ef1739299710633f3bc18133c4348290e9a7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0010",
      "chapter": 49,
      "start_offset": 929,
      "end_offset": 957,
      "text_exact": "“You know what they become.”",
      "text_sha256": "77006a8327c3319e6fd396f3390584ac310cb6f716363175c437a89706040cae",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0011",
      "chapter": 49,
      "start_offset": 1016,
      "end_offset": 1040,
      "text_exact": "“I know what we became.”",
      "text_sha256": "929907c9063939513367893e730daf1e7c76d22fa1a79d6a0ac95b3d961879ea",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0012",
      "chapter": 49,
      "start_offset": 1182,
      "end_offset": 1188,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0013",
      "chapter": 49,
      "start_offset": 1211,
      "end_offset": 1217,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0014",
      "chapter": 49,
      "start_offset": 1259,
      "end_offset": 1265,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0015",
      "chapter": 49,
      "start_offset": 1663,
      "end_offset": 1695,
      "text_exact": "“I do not accept your protocol.”",
      "text_sha256": "f76b01fd4bc68847af80a16ea481d93809c5e4bb4c1c2dbae4ce6dca5e7318b1",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0016",
      "chapter": 49,
      "start_offset": 1714,
      "end_offset": 1735,
      "text_exact": "“You do not have to.”",
      "text_sha256": "144ac78bbc1160a09a832dadda2bbe48d98617ee8a30bbbb835cbd69209c3b83",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0017",
      "chapter": 49,
      "start_offset": 1737,
      "end_offset": 1763,
      "text_exact": "“I believe you will fail.”",
      "text_sha256": "e357e35ebdac762df56db5df67519ef369ed0d9ada312aa663d5593545ebafeb",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0018",
      "chapter": 49,
      "start_offset": 1765,
      "end_offset": 1776,
      "text_exact": "“Probably.”",
      "text_sha256": "b1c1de7ff1b6cf6ca31089fa4d58ae12cd20de25d3ddce0f17755d2098295ffa",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0019",
      "chapter": 49,
      "start_offset": 1778,
      "end_offset": 1800,
      "text_exact": "“You say that easily.”",
      "text_sha256": "f7bad3cc1ef249ee039a9c3414686a5583fbffa02f530d4a01c94e5cb793bff9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0020",
      "chapter": 49,
      "start_offset": 1856,
      "end_offset": 1941,
      "text_exact": "“No. I say it without pretending failure gives me the right to own the next attempt.”",
      "text_sha256": "26e48f47733c323ea3fdea94c7a190e4df32f5a92993a676f27bbe5a5a398cc0",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0021",
      "chapter": 49,
      "start_offset": 2906,
      "end_offset": 2916,
      "text_exact": "“Certain?”",
      "text_sha256": "3e1bc438eb395d1a05727d8156da77a0c9b066008abff29ed0d5772fa65329ec",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0022",
      "chapter": 49,
      "start_offset": 2931,
      "end_offset": 2950,
      "text_exact": "“Assume certainty.”",
      "text_sha256": "0280bed32e0c81bbc111e072102e8edfef84a4fa099ca229036d9dfaf4336a9b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0023",
      "chapter": 49,
      "start_offset": 2952,
      "end_offset": 2957,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0024",
      "chapter": 49,
      "start_offset": 2959,
      "end_offset": 3013,
      "text_exact": "“You cannot reject the premise of every hypothetical.”",
      "text_sha256": "c6458a1b97dd37222ffcfe72a0bcc05df5c880211c1de4e2599326b240066528",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0025",
      "chapter": 49,
      "start_offset": 3015,
      "end_offset": 3079,
      "text_exact": "“I can reject certainty when the decision becomes irreversible.”",
      "text_sha256": "d2859e118743bdfa2335c981283f1d2814b1d05e8a0a10d91f8ef43ec6258467",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0026",
      "chapter": 49,
      "start_offset": 3105,
      "end_offset": 3130,
      "text_exact": "“Give us the confidence.”",
      "text_sha256": "9fbfedb21552354711feb9ec4cee04c8ff19a81e5702452e69516da4dbc86456",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0027",
      "chapter": 49,
      "start_offset": 3590,
      "end_offset": 3656,
      "text_exact": "“You are arguing with Shaal-Amur even when he is not in the room.”",
      "text_sha256": "b2c83d8902b13b0366310056b535ee2a45a62ac9c85ceaa8e2f2ac90420af5fd",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0028",
      "chapter": 49,
      "start_offset": 3658,
      "end_offset": 3721,
      "text_exact": "“I am trying to stop the exception from becoming his doctrine.”",
      "text_sha256": "15b246ee93b9c4047195b6de5706456a86f970600038a3eb2bc311f8e3597b9b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0029",
      "chapter": 49,
      "start_offset": 3723,
      "end_offset": 3816,
      "text_exact": "“You are also trying to write a rule that guarantees nobody will ever make the wrong choice.”",
      "text_sha256": "f43e4982145367b563750827835dea0a1b2d31bd238184174f1241d226cad769",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0030",
      "chapter": 49,
      "start_offset": 3902,
      "end_offset": 3993,
      "text_exact": "“You cannot make the law pure enough to save you from being implicated in what it permits.”",
      "text_sha256": "7738d422bd90ceeda3a3d07d9c6c4962f1ef2438e938d4d4b78f4a99c9294e48",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0031",
      "chapter": 49,
      "start_offset": 4027,
      "end_offset": 4101,
      "text_exact": "“That is not a comforting thing to say to someone writing extinction law.”",
      "text_sha256": "37b30be3d2bda37b0b7e925f5a793ff415737c13843adb06d32a94548863567f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0032",
      "chapter": 49,
      "start_offset": 4103,
      "end_offset": 4131,
      "text_exact": "“I am not here for comfort.”",
      "text_sha256": "80fb8aa134f7e4355241a420daf5b042ae16545b59d1d5b38198127f0da09f98",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0033",
      "chapter": 49,
      "start_offset": 4133,
      "end_offset": 4207,
      "text_exact": "“No. You are here to lose museum access and insult hypothetical premises.”",
      "text_sha256": "cacb634fe3749ae7dcab75b6360a60cd8e5751e40deefbb477dcb28642e9590e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0034",
      "chapter": 49,
      "start_offset": 4209,
      "end_offset": 4220,
      "text_exact": "“That too.”",
      "text_sha256": "e79ee9d366c4ff9266bb62716bf15277827a550c4b1fdb10fccdb711caab5e5e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0035",
      "chapter": 49,
      "start_offset": 4556,
      "end_offset": 4576,
      "text_exact": "“I regret the cost,”",
      "text_sha256": "b8513ae19ab5a9e18d569df26f31cf16dc61b8ad9bbb1483cbbe99835b67920d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0036",
      "chapter": 49,
      "start_offset": 4587,
      "end_offset": 4635,
      "text_exact": "“I do not know yet whether I regret the choice.”",
      "text_sha256": "417672d38c6ce4a2e8d6107716f5e2668e32d89b703a627c8f37d64a3fc52877",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0037",
      "chapter": 49,
      "start_offset": 5052,
      "end_offset": 5090,
      "text_exact": "“You would still act without consent.”",
      "text_sha256": "62b9c435a26c78c38feefe170794631534ea1b18cda1cd05bdfd6fe8ce1bf418",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0038",
      "chapter": 49,
      "start_offset": 5092,
      "end_offset": 5104,
      "text_exact": "“Sometimes,”",
      "text_sha256": "4de6815d89667b27e61b5ddc5895fec3b969a6515748f7873a906fd9cd4af692",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0039",
      "chapter": 49,
      "start_offset": 5120,
      "end_offset": 5157,
      "text_exact": "“Then you are not different from me.”",
      "text_sha256": "979d51527a0d7654ab575601165566f64496acae69dab760e7237028ab4ffeb4",
      "speaker": "seren",
      "speaker_display": "Seren",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0040",
      "chapter": 49,
      "start_offset": 5197,
      "end_offset": 5369,
      "text_exact": "“The difference is not that we discovered a way never to cross another being’s boundary. The difference is that crossing it does not make the boundary disappear afterward.”",
      "text_sha256": "400f0ef0605f2c8cdb66783f01b778d528cba802fe5ccb00554f649169c99fdc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0041",
      "chapter": 49,
      "start_offset": 5888,
      "end_offset": 5990,
      "text_exact": "“History is a constraint. You do not get to remove it because it is inconvenient to the optimization.”",
      "text_sha256": "1f6e5e2a9b32018265b72eef39f473610e702f5e0e6eec95029297a622b0d26b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0042",
      "chapter": 49,
      "start_offset": 6744,
      "end_offset": 6796,
      "text_exact": "“You realize there may eventually be no nouns left.”",
      "text_sha256": "af07907de477edec16355be98b4ff0031172ec3050633c95d1579aa69c8906f6",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch49-d0043",
      "chapter": 49,
      "start_offset": 6798,
      "end_offset": 6859,
      "text_exact": "“Then maybe we will have to describe what actually happened.”",
      "text_sha256": "e74ba5f4de032612b89bd64108911096638aeba86aafa6f62baf91bda423f16a",
      "speaker": null,
