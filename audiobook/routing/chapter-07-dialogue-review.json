    {
      "dialogue_id": "ch07-d0044",
      "chapter": 7,
      "start_offset": 5492,
      "end_offset": 5523,
      "text_exact": "“Terminate passive deployment.”",
      "text_sha256": "4e52bc9cf1686a5790cf71aca4b601661cf91632da9605e92dd458c4c54c91e9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0045",
      "chapter": 7,
      "start_offset": 5549,
      "end_offset": 5555,
      "text_exact": "“Why?”",
      "text_sha256": "6dc7823405b2c9acf1f403a64d9e17ac6bd8d83d609524bdfd391bdafd006205",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0046",
      "chapter": 7,
      "start_offset": 5557,
      "end_offset": 5563,
      "text_exact": "“Now.”",
      "text_sha256": "2587c7accf076ea4a28d9784a8b8274a0ddbc280b1e62491b9003154ffb8df36",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0047",
      "chapter": 7,
      "start_offset": 5579,
      "end_offset": 5610,
      "text_exact": "“We still have twenty minutes.”",
      "text_sha256": "80724d380564063e44d9c9f9a3e45e3597eef10e1b45ef61521a663f48b2d7e7",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0048",
      "chapter": 7,
      "start_offset": 5612,
      "end_offset": 5640,
      "text_exact": "“Dr. Osei-Lorne, terminate.”",
      "text_sha256": "a88437fd8eefc5065c32394d80d16a146f61a3c13ac4e36fb364bfa79ce63c7d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0049",
      "chapter": 7,
      "start_offset": 5896,
      "end_offset": 5906,
      "text_exact": "“Cassian.”",
      "text_sha256": "714febfa84cbcedc90cc852927533e08b8bd2eeffe9566c61b7cb8e6605d53fe",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0050",
      "chapter": 7,
      "start_offset": 6025,
      "end_offset": 6032,
      "text_exact": "“What?”",
      "text_sha256": "bf9ee250242dc9be6ae8a64cb636db6ea70186d990757358b8947787279f47cc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0051",
      "chapter": 7,
      "start_offset": 6131,
      "end_offset": 6153,
      "text_exact": "“That could be right.”",
      "text_sha256": "250cb8478f9b2d99166e1bb2349058e0414563b5082ca15eec53f867b5195c55",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0052",
      "chapter": 7,
      "start_offset": 6166,
      "end_offset": 6187,
      "text_exact": "“Retrieve the probe.”",
      "text_sha256": "228aa9b8cc01e4608f3acdfb4fd4f313642597888a51adf24a4ed90d3956ea85",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0053",
      "chapter": 7,
      "start_offset": 7072,
      "end_offset": 7086,
      "text_exact": "“Stop moving,”",
      "text_sha256": "5585ce6c0a32bc7734e2af08a2869cf493b7ec78f4bc43be31f6188a150a21cd",
      "speaker": "park",
      "speaker_display": "Park",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0054",
      "chapter": 7,
      "start_offset": 7203,
      "end_offset": 7230,
      "text_exact": "“Can you see marker three?”",
      "text_sha256": "d01f0f05abb19604902cf85661a1486ec2c07bd148add10504dd5a373608b181",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0055",
      "chapter": 7,
      "start_offset": 7232,
      "end_offset": 7254,
      "text_exact": "“I can see my gloves.”",
      "text_sha256": "2b6ad9feda5b0e781792f1b24ea8cee03c4f09bc40c4b2f77c77f36341448e1f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0056",
      "chapter": 7,
      "start_offset": 7256,
      "end_offset": 7306,
      "text_exact": "“Good. Those are attached to you. Stay with them.”",
      "text_sha256": "c29f5f6dadb59269d3e8f70fb8764f2724b40ef2e1b45a20c0a3e0a392960860",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0057",
      "chapter": 7,
      "start_offset": 7339,
      "end_offset": 7414,
      "text_exact": "“This is why all ancient revelations happen in deserts. Better visibility.”",
      "text_sha256": "9c4e2af93cf8110e37b600d753180367f3430acb532cb25bfd510661e8157b4c",
      "speaker": "park",
      "speaker_display": "Park",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0058",
      "chapter": 7,
      "start_offset": 7427,
      "end_offset": 7434,
      "text_exact": "“Nico.”",
      "text_sha256": "96e02d2e8476f05d05aafaee2597a61caa1b5c4fa4e49a78a55ca0a034ddcb88",
      "speaker": "park",
      "speaker_display": "Park",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0059",
      "chapter": 7,
      "start_offset": 7436,
      "end_offset": 7447,
      "text_exact": "“Stopping.”",
      "text_sha256": "b6bd0be0dfd1920cf023537f8e3d00f237ca438790a1a112ea2e69427815ee1f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0060",
      "chapter": 7,
      "start_offset": 7957,
      "end_offset": 7975,
      "text_exact": "“Why record that?”",
      "text_sha256": "e5cbef6ae97fbe377b955666a020e4573686474c9bab1c7612bbb4c8e2710296",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0061",
      "chapter": 7,
      "start_offset": 7977,
      "end_offset": 8071,
      "text_exact": "“Because we are going to interpret ambiguous data while tired, cold, and expecting a pattern.”",
      "text_sha256": "a5a0c8d4a30b2553a2e55928f9607aaa7b196cea94cbde585be4eb250ff6db92",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0062",
      "chapter": 7,
      "start_offset": 8086,
      "end_offset": 8093,
      "text_exact": "“Good.”",
      "text_sha256": "da1b98ef03728a55d7b450595409dbd3c2ad61106ccc1bd6e2bc0e2a1c59839a",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0063",
      "chapter": 7,
      "start_offset": 8211,
      "end_offset": 8242,
      "text_exact": "“That's disgustingly quotable.”",
      "text_sha256": "a6979cabcd02d0e2c962746ac7d5cd6f01b8ef9a2f250ce7b819f4c77e311f52",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0064",
      "chapter": 7,
      "start_offset": 8244,
      "end_offset": 8253,
      "text_exact": "“Do not.”",
      "text_sha256": "f36c9cc975475ee17cb42ac5448bf3971fdd661bef2822511b69ef5a02f9339b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0065",
      "chapter": 7,
      "start_offset": 8979,
      "end_offset": 8993,
      "text_exact": "“Turn around,”",
      "text_sha256": "be07f964b9f6b511e75ff198874c14612978fa6261d726698a5ffd79490f403e",
      "speaker": "park",
      "speaker_display": "Park",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0066",
      "chapter": 7,
      "start_offset": 9049,
      "end_offset": 9071,
      "text_exact": "“Now close your eyes.”",
      "text_sha256": "9c74b332fdec1742112108c8380b9c192235c7b23fb3cb0ab461096017e223ee",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0067",
      "chapter": 7,
      "start_offset": 9084,
      "end_offset": 9101,
      "text_exact": "“Absolutely not.”",
      "text_sha256": "39b32d3468178e8572105ff54785a175de3e9428cce7e4447dbd71bd03003b34",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0068",
      "chapter": 7,
      "start_offset": 9103,
      "end_offset": 9118,
      "text_exact": "“Then go back.”",
      "text_sha256": "37bcdf4f8410c3f3f4634f19ba409d0851b045a57cf42d95b1bb8efe510d7f69",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0069",
      "chapter": 7,
      "start_offset": 9201,
      "end_offset": 9221,
      "text_exact": "“Point toward camp.”",
      "text_sha256": "17f0dbee80841bb6074778464ad5623d114a72010d642a637fb2437bc75d44a0",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0070",
      "chapter": 7,
      "start_offset": 9336,
      "end_offset": 9371,
      "text_exact": "“Your internal compass is fiction.”",
      "text_sha256": "65744fc9454144c8631ba6f2fea43c310ec794a4c82f10e9214fae33b41807a8",
      "speaker": "park",
      "speaker_display": "Park",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0071",
      "chapter": 7,
      "start_offset": 9404,
      "end_offset": 9417,
      "text_exact": "“But I knew—”",
      "text_sha256": "29900e5b83d752d5a50b2c566eed7cea4a263a56defee269f554a499c9ac07ef",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0072",
      "chapter": 7,
      "start_offset": 9419,
      "end_offset": 9430,
      "text_exact": "“You felt.”",
      "text_sha256": "f97e96c1025625a10268e87520344211c1d413bea8c6bfb407df4c1f11d09e2f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0073",
      "chapter": 7,
      "start_offset": 9458,
      "end_offset": 9520,
      "text_exact": "“In whiteout, confidence survives after reference disappears.”",
      "text_sha256": "a68358a0cf9154334f872c14386fff9419e9349871d6791e98e1a18dec98f47b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0074",
      "chapter": 7,
      "start_offset": 9563,
      "end_offset": 9627,
      "text_exact": "“And a baseline isn't nature. It's where you started measuring.”",
      "text_sha256": "2dd8b349d00d009a5e0099b713144438c272b5edfd2683be1bec5c13e50caeaa",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0075",
      "chapter": 7,
      "start_offset": 9873,
      "end_offset": 9975,
      "text_exact": "“People walk in circles because the body is asymmetric. They correct for errors they cannot perceive.”",
      "text_sha256": "b6f4aa9248b80214be3db3174dd83fc8043ff3d919bf76c2f54a5be06bbf015d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0076",
      "chapter": 7,
      "start_offset": 10089,
      "end_offset": 10110,
      "text_exact": "“Why teach this now?”",
      "text_sha256": "4ad1b510cd6c8d9939d9b696987125d68cc9e2fa83bc0c1a5a061389e776ba31",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0077",
      "chapter": 7,
      "start_offset": 10112,
      "end_offset": 10180,
      "text_exact": "“Because tomorrow your equipment may tell you something impossible.”",
      "text_sha256": "5d9b1dccf725ccb631ca4dd9020552f93f08a49b651b8002c045a8ef28dd2bef",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0078",
      "chapter": 7,
      "start_offset": 10211,
      "end_offset": 10302,
      "text_exact": "“If the instruments and your story disagree, do not immediately assume the story is brave.”",
      "text_sha256": "08a1d31d75e1050b19bbf610d2c96feda0f19d49461e79836c301ace180a3c90",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0079",
      "chapter": 7,
      "start_offset": 10317,
      "end_offset": 10368,
      "text_exact": "“What if the instruments disagree with each other?”",
      "text_sha256": "b5978fcef90a281a4111527be5f182146b632c7388e8c4182f6cfc9a7eb289ef",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0080",
      "chapter": 7,
      "start_offset": 10370,
      "end_offset": 10377,
      "text_exact": "“Good.”",
      "text_sha256": "da1b98ef03728a55d7b450595409dbd3c2ad61106ccc1bd6e2bc0e2a1c59839a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0081",
      "chapter": 7,
      "start_offset": 10393,
      "end_offset": 10417,
      "text_exact": "“Then you have science.”",
      "text_sha256": "40d85ddcdef553dab36a89d2a042ceb41993ebf862b9363fa605b7006d447d2e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0082",
      "chapter": 7,
      "start_offset": 11005,
      "end_offset": 11034,
      "text_exact": "“So the machine says closed.”",
      "text_sha256": "d80e64acd5f7b5340cb7de09fb84327446b7dad5bcbea5d00ca5876db7f65837",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0083",
      "chapter": 7,
      "start_offset": 11050,
      "end_offset": 11076,
      "text_exact": "“The door says otherwise.”",
      "text_sha256": "2869bd679b618b56a51865e379a39161b4214a03084b0cc5ec763a8405344e3d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0084",
      "chapter": 7,
      "start_offset": 11134,
      "end_offset": 11158,
      "text_exact": "“That much ice matters?”",
      "text_sha256": "08124bc828c69454c17b4873205abbca22eb33d29d854e0520485119ed6266eb",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0085",
      "chapter": 7,
      "start_offset": 11160,
      "end_offset": 11199,
      "text_exact": "“In this temperature gradient? Enough.”",
      "text_sha256": "69ccbb00332a2bb2f3c8cd4fd9b0c2a206d5baeb2253a57cb8465233b881a9d4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0086",
      "chapter": 7,
      "start_offset": 11554,
      "end_offset": 11578,
      "text_exact": "“Another model feature?”",
      "text_sha256": "025305a98bc7c86a7cb3d4740e3fc4f2ce0039554928921b43e63c90cbe70f8b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0087",
      "chapter": 7,
      "start_offset": 11580,
      "end_offset": 11588,
      "text_exact": "“Maybe.”",
      "text_sha256": "7d9b35cf3ea6b7f208e574f5f51b917aef0265b4639e8f111dd29d3bbf8fe1ab",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0088",
      "chapter": 7,
      "start_offset": 11590,
      "end_offset": 11595,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0089",
      "chapter": 7,
      "start_offset": 11637,
      "end_offset": 11718,
      "text_exact": "“Another reminder not to confuse a measurement with the condition we care about.”",
      "text_sha256": "4b9ba254a0ff444e60734f6952dda3b5e28f1ad0acbf15055a7851342c00169c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0090",
      "chapter": 7,
      "start_offset": 11720,
      "end_offset": 11729,
      "text_exact": "“Better.”",
      "text_sha256": "87e9d77a27305e185401b9c82ea735ef47ccc08f9420f5fed16ef7a5c90bb458",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0091",
      "chapter": 7,
      "start_offset": 12138,
      "end_offset": 12160,
      "text_exact": "“Blue ice transition.”",
      "text_sha256": "a4b7d3adcada762100c8b5dad9e5a50f8181caa27a8b46404791fda61c46487e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0092",
      "chapter": 7,
      "start_offset": 12224,
      "end_offset": 12247,
      "text_exact": "“Camera stays clipped.”",
      "text_sha256": "57eb0c543769558ab280644caf946e32402435f16d97df47955c332b8a142c3a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0093",
      "chapter": 7,
      "start_offset": 12249,
      "end_offset": 12255,
      "text_exact": "“Why?”",
      "text_sha256": "6dc7823405b2c9acf1f403a64d9e17ac6bd8d83d609524bdfd391bdafd006205",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0094",
      "chapter": 7,
      "start_offset": 12257,
      "end_offset": 12312,
      "text_exact": "“Because if you drop it, you will instinctively reach.”",
      "text_sha256": "342bdc4a1a888b9feb733a3eec062f98bccd0da4262cb31aa08eaa4cee55a220",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0095",
      "chapter": 7,
      "start_offset": 12314,
      "end_offset": 12334,
      "text_exact": "“I am not an idiot.”",
      "text_sha256": "a6b83f4cc22f11a1577fcf97500ef0a499aaa87465b4a149201fba66ef388968",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0096",
      "chapter": 7,
      "start_offset": 12336,
      "end_offset": 12355,
      "text_exact": "“You are a mammal.”",
      "text_sha256": "0cd9802de23c61dc9e8b91c052636ad0971b0e60490fdc701b7497f0295c1eaf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0097",
      "chapter": 7,
      "start_offset": 12624,
      "end_offset": 12648,
      "text_exact": "“Do not romanticize it.”",
      "text_sha256": "3831212637ff40f3c87009cb014fecef75f594d82abfe5bdf6a8608f4e91f2c3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0098",
      "chapter": 7,
      "start_offset": 12667,
      "end_offset": 12686,
      "text_exact": "“How did you know?”",
      "text_sha256": "af1edb12ee1f7cfe72303c821866a765a9795ea13ccee667648a002927dbc7e8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0099",
      "chapter": 7,
      "start_offset": 12688,
      "end_offset": 12719,
      "text_exact": "“Everyone does the first time.”",
      "text_sha256": "c53410d42c139db47796580425d093a8ab12fac088b01f9c14f34e0f937f928e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0100",
      "chapter": 7,
      "start_offset": 12854,
      "end_offset": 12880,
      "text_exact": "“We have the coordinates.”",
      "text_sha256": "e5744335ee10d1674560728fa01b4843befad4f7a927b2cc31722fcda0ea5b30",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0101",
      "chapter": 7,
      "start_offset": 12882,
      "end_offset": 12937,
      "text_exact": "“We have instruments that say we have the coordinates.”",
      "text_sha256": "9ce3c6080b54272f7c48dcd8094532649112239efae5e43ba4b9e0d51b24828d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0102",
      "chapter": 7,
      "start_offset": 12939,
      "end_offset": 12988,
      "text_exact": "“That distinction is going to become exhausting.”",
      "text_sha256": "fc6a9a594f9744266b368849fb94a19c55e23497f762a6ee565c49302cbd1811",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0103",
      "chapter": 7,
      "start_offset": 12990,
      "end_offset": 13014,
      "text_exact": "“It keeps people alive.”",
      "text_sha256": "445114f58e16c116eb7eb3166a50dcc6677a7554d2404ba54b2e30339a1ff983",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch07-d0104",
      "chapter": 7,
      "start_offset": 13580,
      "end_offset": 13666,
      "text_exact": "“This is why we spend four hours proving where we are before asking what is under us.”",
      "text_sha256": "245b68b4a36d04525216bd2176d15dc2fbb7160d897b77d756b0e02527fdd111",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    }
  ]
}
