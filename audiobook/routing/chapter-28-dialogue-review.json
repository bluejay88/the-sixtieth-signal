  "spans": [
    {
      "dialogue_id": "ch28-d0001",
      "chapter": 28,
      "start_offset": 387,
      "end_offset": 427,
      "text_exact": "“This is why journalists are dangerous,”",
      "text_sha256": "ea87d2012d81411d61d5cee63a72ede5bf6fb0c2016f95ccb8ecdba704be4fa3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0002",
      "chapter": 28,
      "start_offset": 439,
      "end_offset": 477,
      "text_exact": "“This is why archaeologists are slow.”",
      "text_sha256": "759a7fc81f0e22ddbe0a958c017f726f63a634525be362cdb36bfe99f42cdb52",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0003",
      "chapter": 28,
      "start_offset": 479,
      "end_offset": 547,
      "text_exact": "“We are slow because dirt does not care about your upload schedule.”",
      "text_sha256": "39f2363372e18b7c3685179b8d048e0a72d4a8a36dafe46114da113fcaf4ea56",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0004",
      "chapter": 28,
      "start_offset": 1134,
      "end_offset": 1150,
      "text_exact": "“No expedition,”",
      "text_sha256": "aa21eb325f42c4548a2918f4df24441a0b45e0a4c7fd9ab0a48d9d5dbfc6c541",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0005",
      "chapter": 28,
      "start_offset": 1163,
      "end_offset": 1178,
      "text_exact": "“I didn't ask.”",
      "text_sha256": "d8cd03890f25bfc723f9d5732eb1b552d0abe8f2e8d35fd136bd0a9307d2f3ef",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0006",
      "chapter": 28,
      "start_offset": 1180,
      "end_offset": 1200,
      "text_exact": "“You were going to.”",
      "text_sha256": "c6390d736944ed28443f51f9ea7ca338010a05939b4ddd45f243f75746dc9901",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0007",
      "chapter": 28,
      "start_offset": 1202,
      "end_offset": 1250,
      "text_exact": "“I was going to ask who has already been there.”",
      "text_sha256": "475b62702084f5a6975f55da5f7110c02a4131a4c83a59581bb63d060843fdb7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0008",
      "chapter": 28,
      "start_offset": 2022,
      "end_offset": 2057,
      "text_exact": "“Where's the anti-gravity machine?”",
      "text_sha256": "a277cf36f27004147b2a2cd6f5fb241694209b0eb6e3d16f26ac6e31dee2f455",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0009",
      "chapter": 28,
      "start_offset": 2071,
      "end_offset": 2092,
      "text_exact": "“Thank God, nowhere.”",
      "text_sha256": "54d8bcf52b055669084f3000e576d8f455facd678c1692b004a5a0aaf3ec4955",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0010",
      "chapter": 28,
      "start_offset": 2704,
      "end_offset": 2726,
      "text_exact": "“Another grave thing?”",
      "text_sha256": "45c45a865573518ea1dd977116fc54d21467c062f1fe7d593f268fc3f83bf7f8",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0011",
      "chapter": 28,
      "start_offset": 2765,
      "end_offset": 2789,
      "text_exact": "“Sentimental retention.”",
      "text_sha256": "edf21d79108b08f4471005177684aecd27137690bf7566ef5ce89b3752c602ca",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0012",
      "chapter": 28,
      "start_offset": 2806,
      "end_offset": 2831,
      "text_exact": "“You are learning words.”",
      "text_sha256": "18b95847049b1b6897a4042c96d6722b2ff636b0294ced19e585a7aaff105b55",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0013",
      "chapter": 28,
      "start_offset": 3582,
      "end_offset": 3595,
      "text_exact": "“Same event.”",
      "text_sha256": "6666dd831eb3fd40618ae684537287a46227684efc365744b43997e06c161625",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0014",
      "chapter": 28,
      "start_offset": 3597,
      "end_offset": 3629,
      "text_exact": "“Different objective functions.”",
      "text_sha256": "cd674929fba35ca55d883fcba64ab89adbbba0914e1cea92db2063a65f39a480",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0015",
      "chapter": 28,
      "start_offset": 4156,
      "end_offset": 4189,
      "text_exact": "“That's worse than a laser beam.”",
      "text_sha256": "862f2d6ace35cd7601b39f74f1c258705a314298fc05343dc280f554380fab7f",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0016",
      "chapter": 28,
      "start_offset": 4203,
      "end_offset": 4209,
      "text_exact": "“Why?”",
      "text_sha256": "6dc7823405b2c9acf1f403a64d9e17ac6bd8d83d609524bdfd391bdafd006205",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0017",
      "chapter": 28,
      "start_offset": 4211,
      "end_offset": 4236,
      "text_exact": "“Because it's plausible.”",
      "text_sha256": "82a4d36e921ae287ef61c6ed394aae58d608d16c5097ff908db253ad4c5eb8e1",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0018",
      "chapter": 28,
      "start_offset": 4268,
      "end_offset": 4302,
      "text_exact": "“And because it leaves survivors.”",
      "text_sha256": "25cf1211e04a3ffdb811e5560572486ade9dbb20b84990f702789cbf3b4a9994",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0019",
      "chapter": 28,
      "start_offset": 5726,
      "end_offset": 5734,
      "text_exact": "“Sixty.”",
      "text_sha256": "a1909bba4184e4cd13af206a29ee5788b32d9c6285c5d6000f9a7debb5628f4d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0020",
      "chapter": 28,
      "start_offset": 5769,
      "end_offset": 5778,
      "text_exact": "“I know.”",
      "text_sha256": "540cab585b96a8e3879a7e48586ea900f82bb5fcca7667332c2d7cca3f3fde2a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0021",
      "chapter": 28,
      "start_offset": 5780,
      "end_offset": 5789,
      "text_exact": "“Do you?”",
      "text_sha256": "180331e7f6cddced61d84246d8a135220dbbf676f514b5ce74d80ab4ea5e1e7c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0022",
      "chapter": 28,
      "start_offset": 5791,
      "end_offset": 5797,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0023",
      "chapter": 28,
      "start_offset": 6501,
      "end_offset": 6540,
      "text_exact": "“They are living inside foreshadowing.”",
      "text_sha256": "4e4522b4a8ce82d409dd38fa41a4b5ee4a746ab0d4697fc6f45d0831bce903eb",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0024",
      "chapter": 28,
      "start_offset": 6564,
      "end_offset": 6578,
      "text_exact": "“Everyone is.”",
      "text_sha256": "13d2179057408161ebeffc7f0013ef2a59e287a2dfcc32a6c2e7103193152b23",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0025",
      "chapter": 28,
      "start_offset": 10245,
      "end_offset": 10268,
      "text_exact": "“What happens to them?”",
      "text_sha256": "b85e426a6f6f91060c3fb726467ea1c0924ee7250188149769b1757835fe490f",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0026",
      "chapter": 28,
      "start_offset": 10319,
      "end_offset": 10342,
      "text_exact": "“We know some survive.”",
      "text_sha256": "322131a62e1f123ed4b42dc988ad9457ee986d2bd21488f7a4eb79124c8ae677",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0027",
      "chapter": 28,
      "start_offset": 10344,
      "end_offset": 10363,
      "text_exact": "“Do they remember?”",
      "text_sha256": "289ad2d35c06aeb399899308dab6f9ee63cf028b8c331f84a61cf35542132c6f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0028",
      "chapter": 28,
      "start_offset": 10365,
      "end_offset": 10376,
      "text_exact": "“Not this.”",
      "text_sha256": "4f00014c17045d80c61e3c8c7c97b4a1b3697f8423df69918deb8bdda7ed7a6e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0029",
      "chapter": 28,
      "start_offset": 10392,
      "end_offset": 10416,
      "text_exact": "“Then what is survival?”",
      "text_sha256": "19b1ccbb0f5365da9022772d372ee8227f680228cf2c07b2e776f961edc90c82",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0030",
      "chapter": 28,
      "start_offset": 10570,
      "end_offset": 10577,
      "text_exact": "“Good.”",
      "text_sha256": "da1b98ef03728a55d7b450595409dbd3c2ad61106ccc1bd6e2bc0e2a1c59839a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0031",
      "chapter": 28,
      "start_offset": 10593,
      "end_offset": 10630,
      "text_exact": "“You are happy sixty is meaningless?”",
      "text_sha256": "ca3a9bc4caa0a94fb45141fa32ef9496d6824b5518933de749432dd7d13340a5",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0032",
      "chapter": 28,
      "start_offset": 10632,
      "end_offset": 10647,
      "text_exact": "“In this case.”",
      "text_sha256": "5fd43dad30cd37cb850c4a30525ab217aba0b423a19256aa564b1c8b21676098",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0033",
      "chapter": 28,
      "start_offset": 11679,
      "end_offset": 11736,
      "text_exact": "“So civilization died because nobody trusted the ledger.”",
      "text_sha256": "496831a3a62d6371eca6998ebd891ca43e13c43fe87d1be2d7768145c0987ea7",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0034",
      "chapter": 28,
      "start_offset": 11761,
      "end_offset": 11772,
      "text_exact": "“Not only.”",
      "text_sha256": "7df1676ea2f52bf54beecf6599bcc50bb34fcbcc3432574460bfe11409c95b6d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0035",
      "chapter": 28,
      "start_offset": 12240,
      "end_offset": 12405,
      "text_exact": "“We are not going to point at one flood story and declare this its source. Human beings live near water. Floods happen. Stories travel. Similarity is not genealogy.”",
      "text_sha256": "177c129a803c7232e785c51cb77fa5c4c91f8b98fa40662091e6b65945d753dd",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0036",
      "chapter": 28,
      "start_offset": 12418,
      "end_offset": 12466,
      "text_exact": "“But the archive says survivors carried memory.”",
      "text_sha256": "7223f3d63e92d354785e3584b4d580edd6623c2646ca63fb31a36cf8e987b64c",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0037",
      "chapter": 28,
      "start_offset": 12468,
      "end_offset": 12596,
      "text_exact": "“Yes. That is evidence inside our fictional event chain. It is not permission to colonize every real tradition with one answer.”",
      "text_sha256": "d7700aa5105dbb19cfce95c7b817c4bdbbef578d2d73f78083f2a9561d705578",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0038",
      "chapter": 28,
      "start_offset": 12615,
      "end_offset": 12636,
      "text_exact": "“You rehearsed that.”",
      "text_sha256": "a9a42adb82125468262ce42cd45ecdc21c92a932563de4a9577a9825fbd19eea",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0039",
      "chapter": 28,
      "start_offset": 12638,
      "end_offset": 12657,
      "text_exact": "“For twenty years.”",
      "text_sha256": "50ebb01f2f2cb466e802b5978201c6274af90f8bc8e49c06540f30b57ccfe186",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0040",
      "chapter": 28,
      "start_offset": 12879,
      "end_offset": 12903,
      "text_exact": "“That's the last thing?”",
      "text_sha256": "438ad11fc911ef3faee130b9628cfff10131471370795c0c84a13bd8e9808a5b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0041",
      "chapter": 28,
      "start_offset": 12905,
      "end_offset": 12928,
      "text_exact": "“Last surviving thing,”",
      "text_sha256": "b9f6356858ddb4fac7f13084be009cd8f67b2d024dfab0035288f73dc5ce44a1",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0042",
      "chapter": 28,
      "start_offset": 13870,
      "end_offset": 13901,
      "text_exact": "“advanced civilization reveal.”",
      "text_sha256": "41507e545ce5283a16ac078e8b651a9212555520c4556554384d96e8236f71d7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch28-d0043",
      "chapter": 28,
      "start_offset": 13928,
      "end_offset": 13961,
      "text_exact": "“They had sophisticated systems.”",
      "text_sha256": "c7ccc138eb2cc75e41457f81dd2476c55c54b50369244809c0d1b835111c0d85",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
