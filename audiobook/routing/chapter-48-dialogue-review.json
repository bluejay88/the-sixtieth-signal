  "chapter": 48,
  "chapter_title": "THE CREATORS' FEAR",
  "chapter_sha256": "1a83621691c9dabb43eb3ccca2c10a95224d0b06623aac97f188a02bb8e36c81",
  "policy": "No unresolved dialogue may fall back to narrator. render_allowed remains false until human approval.",
  "counts": {
