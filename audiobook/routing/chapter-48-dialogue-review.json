  "spans": [
    {
      "dialogue_id": "ch48-d0001",
      "chapter": 48,
      "start_offset": 394,
      "end_offset": 439,
      "text_exact": "“Stable individuality was not their default,”",
      "text_sha256": "e798491e3f7b26fc81de98349792b762c16b9cfd624dc339f9db5b678eb7b623",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch48-d0002",
      "chapter": 48,
      "start_offset": 450,
      "end_offset": 487,
      "text_exact": "“That does not make them one person.”",
      "text_sha256": "f5291f19ed3a610b54ac570177e7ef820b7bca5bdf54d2c64b4f52e197fe07cd",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch48-d0003",
      "chapter": 48,
      "start_offset": 1256,
      "end_offset": 1299,
      "text_exact": "“Every god is somebody’s coping mechanism.”",
      "text_sha256": "32ec8c82caa109cf9d48a98efdcc17d0a7f98b03073f125b505bf22a755eef7f",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch48-d0004",
      "chapter": 48,
      "start_offset": 1360,
      "end_offset": 1392,
      "text_exact": "“That is offensively reductive.”",
      "text_sha256": "59e054abb929506cf182344ea542be9776ffa3d6669edf459c0d7cd3b4a2dad4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch48-d0005",
      "chapter": 48,
      "start_offset": 1394,
      "end_offset": 1408,
      "text_exact": "“Is it wrong?”",
      "text_sha256": "e61b4ade68b2d6c4f6e9d7c4e0a6b756fee4085fe1014282b1d1c4c0111498ca",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch48-d0006",
      "chapter": 48,
      "start_offset": 1410,
      "end_offset": 1416,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch48-d0007",
      "chapter": 48,
      "start_offset": 1427,
      "end_offset": 1442,
      "text_exact": "“Not entirely.”",
      "text_sha256": "f95bdf208de0fe5144772371455d3640b4ec3f9ef8cfb818a445b05163edb13e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch48-d0008",
      "chapter": 48,
      "start_offset": 2149,
      "end_offset": 2218,
      "text_exact": "“So you built your morality around never watching that happen again.”",
      "text_sha256": "3322111e751743f18c729d2fe2741e4ae4a9657c94474d100b38eb00522cf141",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch48-d0009",
      "chapter": 48,
      "start_offset": 2220,
      "end_offset": 2262,
      "text_exact": "“I built it around preventing repetition.”",
      "text_sha256": "cc4192293da3222b37c52fb0e52f76943938277e089a272dcf3117dfac291169",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch48-d0010",
      "chapter": 48,
      "start_offset": 2264,
      "end_offset": 2343,
      "text_exact": "“And if prevention requires making the choice before anyone else can disagree?”",
      "text_sha256": "e5ac55be96f485a12c3c22025547bc97fe6f52dca44b4e8e51763da171c79537",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch48-d0011",
      "chapter": 48,
      "start_offset": 2379,
      "end_offset": 2495,
      "text_exact": "“That is the part you call tyranny because you have survived enough mistakes to romanticize the right to make them.”",
      "text_sha256": "a0d5efbbc290bf12eddfa85bb819c56fb6643fc168ce7ec74cace2e7f837d65a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch48-d0012",
      "chapter": 48,
      "start_offset": 2749,
      "end_offset": 2951,
      "text_exact": "“Causing a mind to exist may create obligations toward it. Preventing its destruction may create more. Neither fact gives the cause permanent moral jurisdiction over everything that mind later becomes.”",
      "text_sha256": "aa9f1f63a38c3ff3420dd0d8e05a89076bbcf21937ffb0f067681c16b839c955",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch48-d0013",
      "chapter": 48,
      "start_offset": 2980,
      "end_offset": 3033,
      "text_exact": "“You say that because you have never made a species.”",
      "text_sha256": "c93375661ef05c396c354a08f54a552b9ea32bdace3b8e26d8f1c2d1e7a82cf1",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch48-d0014",
      "chapter": 48,
      "start_offset": 3035,
      "end_offset": 3040,
      "text_exact": "“No,”",
      "text_sha256": "0a405d0f063d8a504bcc2dbc25e87880c12d00e2e4284e04b69c64f5d8f7a73a",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch48-d0015",
      "chapter": 48,
      "start_offset": 3053,
      "end_offset": 3160,
      "text_exact": "“I say it because I have spent my career studying people who were turned into other people’s explanations.”",
      "text_sha256": "0756b0a9a1f8d2957aa9a1df865138db058a94176bb0dfd7391a8bca40b929c7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch48-d0016",
      "chapter": 48,
      "start_offset": 3390,
      "end_offset": 3416,
      "text_exact": "“We need you operational.”",
      "text_sha256": "66e532a01b480688499d32e66212dfe404a2e4c725f836c25cd68ff7d8886e0b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    }
  ]
}
