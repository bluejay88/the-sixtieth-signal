      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch47-d0013",
      "chapter": 47,
      "start_offset": 1418,
      "end_offset": 1480,
      "text_exact": "“For you to stay with one explanation long enough to hurt it.”",
