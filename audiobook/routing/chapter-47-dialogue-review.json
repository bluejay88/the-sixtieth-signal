    {
      "dialogue_id": "ch47-d0012",
      "chapter": 47,
      "start_offset": 1397,
      "end_offset": 1416,
      "text_exact": "“What do you want?”",
      "text_sha256": "5af79f76f6b5043e967383b4ebbc976dcb4f8f9efcb66196e8fca17f326061c7",
      "speaker": null,
      "speaker_display": null,
