{
  "schema_version": 1,
  "chapter": 45,
  "chapter_title": "PIKE OPENS THE FILES",
  "chapter_sha256": "cb8747c0732c21b573b8186d1752c7b0da06bc6f463f26e9120163844ba1874e",
  "policy": "No unresolved dialogue may fall back to narrator. render_allowed remains false until human approval.",
  "counts": {
    "dialogue_spans": 30,
    "explicit_named": 0,
    "unresolved": 30,
    "approved": 0
  },
  "spans": [
    {
      "dialogue_id": "ch45-d0001",
      "chapter": 45,
      "start_offset": 1294,
      "end_offset": 1331,
      "text_exact": "“You do not have to do that tonight.”",
      "text_sha256": "e463409d8733430419657b2d12163b261c86a7197cd303aa3c621c1a0b3f9fb7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0002",
      "chapter": 45,
      "start_offset": 1333,
      "end_offset": 1383,
      "text_exact": "“That is not what you would say if Pike owned it.”",
      "text_sha256": "600aaf57a1570d115e37fb7356674b05db6a6c2d5cc94c590b249783f98b5704",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0003",
      "chapter": 45,
      "start_offset": 1385,
      "end_offset": 1390,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0004",
      "chapter": 45,
      "start_offset": 1392,
      "end_offset": 1408,
      "text_exact": "“Or Shaal-Amur.”",
      "text_sha256": "af8481633490dc2e942c5e5cd36170961c0ec228a211bdac0b7dd430df3bcc36",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0005",
      "chapter": 45,
      "start_offset": 1410,
      "end_offset": 1415,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0006",
      "chapter": 45,
      "start_offset": 1435,
      "end_offset": 1467,
      "text_exact": "“You could pretend to hesitate.”",
      "text_sha256": "1e7432099ac50ba091645ca5b08c4761380c8bb53943b0895124970fd535a28f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0007",
      "chapter": 45,
      "start_offset": 1469,
      "end_offset": 1482,
      "text_exact": "“I am tired.”",
      "text_sha256": "202aa014b5d1042686c6546c88dfd5b5f4c752b5410160198decda9d3d454a22",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0008",
      "chapter": 45,
      "start_offset": 1719,
      "end_offset": 1748,
      "text_exact": "“I know what this costs you,”",
      "text_sha256": "44ef5200e514121da0e94964c72e66ac988d47a5c9d6814468be67440ad4c58b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0009",
      "chapter": 45,
      "start_offset": 1760,
      "end_offset": 1773,
      "text_exact": "“You cannot.”",
      "text_sha256": "7bcc55340c2439d6bdd0bfdf11a894d84838fcf83ec3c084832a09ec78bfff7a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0010",
      "chapter": 45,
      "start_offset": 1775,
      "end_offset": 1815,
      "text_exact": "“No. But I know it is not only control.”",
      "text_sha256": "88fdd8cbc5ac7cab3109108055fd0ef652f174e736236e3d0d4e49569ac061e9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0011",
      "chapter": 45,
      "start_offset": 1881,
      "end_offset": 2118,
      "text_exact": "“I built the first version in a room where the air conditioning failed every Thursday. Half the code was ugly. The recovery key was not sovereignty. It was me being the person who got called when the thing broke at three in the morning.”",
      "text_sha256": "168f6a720fef0f4f3872e9a36ee79e8ed23ebb93354310f21791d789e2356cd1",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0012",
      "chapter": 45,
      "start_offset": 2120,
      "end_offset": 2130,
      "text_exact": "“And now?”",
      "text_sha256": "e71b5b41fcb20f3e269f956dc0b47ee0387109b39b8e064abf5930775bb9b89c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0013",
      "chapter": 45,
      "start_offset": 2132,
      "end_offset": 2202,
      "text_exact": "“Now the system should be able to break without needing my childhood.”",
      "text_sha256": "17a1c5cecc6807fa10b1058b7f01a852907a2ce407c46cb28a7e6ec6a61e0a72",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0014",
      "chapter": 45,
      "start_offset": 2828,
      "end_offset": 2864,
      "text_exact": "“Do not release it because he lied.”",
      "text_sha256": "244872eb8c057939ad6c320ed5e3169174f11c6c13d04d38de6144220bfd1fea",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0015",
      "chapter": 45,
      "start_offset": 2866,
      "end_offset": 2877,
      "text_exact": "“I am not.”",
      "text_sha256": "248d9d85d7114e95afbd358241436463e8b21515f4a00fbc0a74e860d6aa3e38",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0016",
      "chapter": 45,
      "start_offset": 2879,
      "end_offset": 2923,
      "text_exact": "“That is exactly what your face looks like.”",
      "text_sha256": "9c2e56652662b9014faa3b0b58772bc4724d27760871d3173879197340a2ce87",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0017",
      "chapter": 45,
      "start_offset": 2925,
      "end_offset": 2952,
      "text_exact": "“The evidence is verified.”",
      "text_sha256": "46762dd500fdf9b948b57e994d6631c0d048f5683427e07394261e4f11e99216",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0018",
      "chapter": 45,
      "start_offset": 2954,
      "end_offset": 2982,
      "text_exact": "“The context is incomplete.”",
      "text_sha256": "6b0b66f999f837e8f69a8ace5a8d903d2c46f07edd22cdc4aa1e3ee02932f5b0",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0019",
      "chapter": 45,
      "start_offset": 2984,
      "end_offset": 3011,
      "text_exact": "“So we publish both facts.”",
      "text_sha256": "5118dba62d5001f496f2094b0d715437b9a7e7224f5bbab16290c2535a284dd9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0020",
      "chapter": 45,
      "start_offset": 3013,
      "end_offset": 3118,
      "text_exact": "“Once it is out, every faction on Earth will use the fragment as proof of whatever they already believe.”",
      "text_sha256": "4fc5744b2bbac95b8f809d98b00bf7a26c470ee89e995f14cfe944f8db0046e4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0021",
      "chapter": 45,
      "start_offset": 3152,
      "end_offset": 3272,
      "text_exact": "“And if we suppress verified evidence because people may misuse it, we have rebuilt the Iru-Shai argument in six hours.”",
      "text_sha256": "6dc2abd21ea6ae6a8e9a84f4e8c3517a36ca8f9f04571e969b7677d168967899",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0022",
      "chapter": 45,
      "start_offset": 3298,
      "end_offset": 3357,
      "text_exact": "“Withholding for authentication is not species management.”",
      "text_sha256": "eae72115ec5bd42e8ee5f9391aaccf1457d52dd2e970f37f487689897a317114",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0023",
      "chapter": 45,
      "start_offset": 3359,
      "end_offset": 3395,
      "text_exact": "“Then say we withheld it. Publicly.”",
      "text_sha256": "0a91130e89a4f96a27d69d239e14a0025fb3603393f100e60ddce39cc81c2468",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0024",
      "chapter": 45,
      "start_offset": 4191,
      "end_offset": 4208,
      "text_exact": "“You were right,”",
      "text_sha256": "d37d6d7532f7cae7c78d9496c684ec9ce34d2b513eeab37df983f360b45891dc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0025",
      "chapter": 45,
      "start_offset": 4219,
      "end_offset": 4245,
      "text_exact": "“About which catastrophe?”",
      "text_sha256": "5bcd2f848215e31a5fc3c484cc79e881a5427b89e3ebec634ddfb3485653629b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0026",
      "chapter": 45,
      "start_offset": 4247,
      "end_offset": 4262,
      "text_exact": "“The minister.”",
      "text_sha256": "30961cbfaaaabbc275a8d67947a28a6363b95c67c667ec3a174d0211d6dd71e1",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0027",
      "chapter": 45,
      "start_offset": 4264,
      "end_offset": 4303,
      "text_exact": "“That does not make the release right.”",
      "text_sha256": "f37cfc9b308032a683bd8d4c59239d45de1569066b6aefa12274763561c013cd",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0028",
      "chapter": 45,
      "start_offset": 4355,
      "end_offset": 4406,
      "text_exact": "“You hate when people confuse outcome with method.”",
      "text_sha256": "ee23f42d04199e57c12c575da6f281ee9bac2ab4be24ef1207fa0b7bead577e4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0029",
      "chapter": 45,
      "start_offset": 4408,
      "end_offset": 4437,
      "text_exact": "“I also hate carrying boxes.”",
      "text_sha256": "0c06c1b1cdacf008cb1bdf213167eec358de8376f328e905732e0535e08522aa",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch45-d0030",
      "chapter": 45,
      "start_offset": 4501,
      "end_offset": 4657,
      "text_exact": "“That is why I am carrying it. You can explain the ethics of disclosure after we get the six-month-old artifact out of the parking lot without breaking it.”",
      "text_sha256": "76afde31bbd505731ed0160985095a006ff0cf12220190b0e40d22d307ca04d5",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    }
  ]
}
