  "spans": [
    {
      "dialogue_id": "ch31-d0001",
      "chapter": 31,
      "start_offset": 204,
      "end_offset": 249,
      "text_exact": "“That is LOAM's phrasing, not the archive's.”",
      "text_sha256": "3339acded1759fa4aeceabb5275bc44f81c562226d39d147b8a894f25073cd6b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0002",
      "chapter": 31,
      "start_offset": 251,
      "end_offset": 257,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0003",
      "chapter": 31,
      "start_offset": 259,
      "end_offset": 266,
      "text_exact": "“Good.”",
      "text_sha256": "da1b98ef03728a55d7b450595409dbd3c2ad61106ccc1bd6e2bc0e2a1c59839a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0004",
      "chapter": 31,
      "start_offset": 330,
      "end_offset": 403,
      "text_exact": "“Can we acknowledge that the machine just asked who gets to tell God no?”",
      "text_sha256": "e6e56bdc154db5f59b1dca7e54f7cf8b748aa25813761c7418d1810c13cfbe84",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0005",
      "chapter": 31,
      "start_offset": 405,
      "end_offset": 410,
      "text_exact": "“No,”",
      "text_sha256": "0a405d0f063d8a504bcc2dbc25e87880c12d00e2e4284e04b69c64f5d8f7a73a",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0006",
      "chapter": 31,
      "start_offset": 424,
      "end_offset": 453,
      "text_exact": "“You make wonder exhausting.”",
      "text_sha256": "20d78b8a0591ded8ba3cc288393ef65fdf42ef8228c6dad32d4aabfda33a3e07",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0007",
      "chapter": 31,
      "start_offset": 455,
      "end_offset": 486,
      "text_exact": "“I make nouns earn their keep.”",
      "text_sha256": "d9656a642d03948d72019de8fe60b70dfa34881a635e5f238ed9d790a3c8d129",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0008",
      "chapter": 31,
      "start_offset": 523,
      "end_offset": 539,
      "text_exact": "“What happened?”",
      "text_sha256": "3a29c49456a7f6861930dfc9c8dbe16ed7891bbcb56e95c5a4ad89515caa6cdd",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0009",
      "chapter": 31,
      "start_offset": 582,
      "end_offset": 617,
      "text_exact": "“Answer: whoever has jurisdiction.”",
      "text_sha256": "bfc7180373438b1a62ccd45d0deb6a7f5ff71f174538e640b23299b15723e8ac",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0010",
      "chapter": 31,
      "start_offset": 639,
      "end_offset": 672,
      "text_exact": "“You make wonder file paperwork.”",
      "text_sha256": "ecf463b456e6e9dfe9d6cbdb58396d1e14e6bbff048bed43cf99a8dd14ac532e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0011",
      "chapter": 31,
      "start_offset": 674,
      "end_offset": 710,
      "text_exact": "“It is why wonder gets electricity.”",
      "text_sha256": "d0f9f104f6d59359e585601930728ae6208953b4930a764c4d17971f4295c4b9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0012",
      "chapter": 31,
      "start_offset": 1203,
      "end_offset": 1216,
      "text_exact": "“Too poetic.”",
      "text_sha256": "06c2788ab9f1c09aac6ec96567401a7bfc78a2d591042fb49bf6a758d36c8dc0",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0013",
      "chapter": 31,
      "start_offset": 1233,
      "end_offset": 1271,
      "text_exact": "“Put it on a shirt and let me retire.”",
      "text_sha256": "938b5d4adbb3306840059e747c9e137ac7b6dc488b1b9f2e1370ed7796fddc57",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0014",
      "chapter": 31,
      "start_offset": 1295,
      "end_offset": 1337,
      "text_exact": "“What does the third witness actually do?”",
      "text_sha256": "c867f8ac85b8f14ffe60d1a36d4f1b555a29686b83c0da17e4690e54017151e7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0015",
      "chapter": 31,
      "start_offset": 1878,
      "end_offset": 1903,
      "text_exact": "“It is not another vote.”",
      "text_sha256": "db8c544766f735d55320f0dc063fefe2593aa0db88cb23c59c9a40073f16b069",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0016",
      "chapter": 31,
      "start_offset": 1910,
      "end_offset": 1924,
      "text_exact": "“It is a job.”",
      "text_sha256": "f1956487f9d78e4588d3a15612ce6af9e32ddcef37dd73f90276120d90b66cd9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0017",
      "chapter": 31,
      "start_offset": 1954,
      "end_offset": 1979,
      "text_exact": "“A job assigned by whom?”",
      "text_sha256": "65f807efa7d388e373a9265e2d55350dd789af546320daf6c0ea007812244bdd",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0018",
      "chapter": 31,
      "start_offset": 2146,
      "end_offset": 2225,
      "text_exact": "“So who appoints the person whose job is to tell the appointer they are wrong?”",
      "text_sha256": "e4181d6fcac549d5b35b9d6da0c3d84f358e973c60fd8ee1cb295b847c060232",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0019",
      "chapter": 31,
      "start_offset": 2521,
      "end_offset": 2559,
      "text_exact": "“Stop using independence like purity.”",
      "text_sha256": "15bc4681de2f0c1719e543c6a0d5703d44065a8f46edd1fc296036ab2c90cce2",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0020",
      "chapter": 31,
      "start_offset": 2585,
      "end_offset": 2612,
      "text_exact": "“What do you want instead?”",
      "text_sha256": "24d5de2600bc451923be25b34a00859fd13f73909ba97555727cf405cebd91f8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0021",
      "chapter": 31,
      "start_offset": 2614,
      "end_offset": 2624,
      "text_exact": "“Refusal.”",
      "text_sha256": "8e67146c37a88a833bb34bf923d3cf916d67d6e26e975e0d5f582415c9c388fd",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0022",
      "chapter": 31,
      "start_offset": 2663,
      "end_offset": 2825,
      "text_exact": "“Can the witness refuse the party that created or appointed it? Can it show its evidence? Can it revise after contradiction? Can everyone see what it depends on?”",
      "text_sha256": "46b805c7e4e6b4c075b5d8c2da00c66a79f4b3eb31e9a3a5eeaad886d9c8259c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0023",
      "chapter": 31,
      "start_offset": 3030,
      "end_offset": 3059,
      "text_exact": "“That is much less mystical.”",
      "text_sha256": "6f5ac4b60d94bd7e698b8d182538d0cb06ecf050ab5c5fb190b168808fb9e556",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0024",
      "chapter": 31,
      "start_offset": 3061,
      "end_offset": 3068,
      "text_exact": "“Good,”",
      "text_sha256": "38230771dc0110e9b2c42bc2a2a5ce3febd053c13f3d875fc211f97a38cb713b",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0025",
      "chapter": 31,
      "start_offset": 3136,
      "end_offset": 3178,
      "text_exact": "“And if the third witness is the machine?”",
      "text_sha256": "3cddb138cf038259abd6c0da9a3afedf120d903b99840461d8ccf2d331201cbe",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0026",
      "chapter": 31,
      "start_offset": 3211,
      "end_offset": 3226,
      "text_exact": "“It cannot be.”",
      "text_sha256": "e5c3b0afae0e4945ae8d4845fbc407cd462c5053841c5d6b186b69edb14ade88",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0027",
      "chapter": 31,
      "start_offset": 3330,
      "end_offset": 3346,
      "text_exact": "“I do not know.”",
      "text_sha256": "52579691ef96f84e0f46c73173e93bb6df52d27a4270019614459974bc842667",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0028",
      "chapter": 31,
      "start_offset": 3451,
      "end_offset": 3485,
      "text_exact": "“It has learned to embarrass you.”",
      "text_sha256": "df3498be4d125dd3e31083422e6abb5f65cb843fe378bdd3dc2e574fae29c910",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0029",
      "chapter": 31,
      "start_offset": 3512,
      "end_offset": 3525,
      "text_exact": "“Apparently.”",
      "text_sha256": "0d3974785bd6e677e771f6c0721fed14c3f07b48ce955a960560b5a4e2a18edc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0030",
      "chapter": 31,
      "start_offset": 3623,
      "end_offset": 3644,
      "text_exact": "“Was that agreement?”",
      "text_sha256": "c89451489c8f525212105d5a29e5d12f4128eeef3139a369ae53066d93f3d128",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0031",
      "chapter": 31,
      "start_offset": 3658,
      "end_offset": 3721,
      "text_exact": "“If you put that in the episode, I will destroy your recorder.”",
      "text_sha256": "3ccc7471ee0fdc90d403a485415a6259e595caf398d022ff0743453a67045bcc",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch31-d0032",
      "chapter": 31,
      "start_offset": 3734,
      "end_offset": 3750,
      "text_exact": "“There you are.”",
      "text_sha256": "fc2bafe46088a5fe56ff7c5536089ce59a094ee1152a72eae8f5bf1de8eac7fd",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    }
  ]
}
