      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0050",
      "chapter": 36,
      "start_offset": 4063,
      "end_offset": 4112,
      "text_exact": "“Do you want Shaal-Amur to govern your hospital?”",
