      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0046",
      "chapter": 36,
      "start_offset": 3934,
      "end_offset": 3954,
      "text_exact": "“It is a large one.”",
