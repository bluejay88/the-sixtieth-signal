      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0049",
      "chapter": 36,
      "start_offset": 3987,
      "end_offset": 4020,
      "text_exact": "“You do not sound like you know.”",
