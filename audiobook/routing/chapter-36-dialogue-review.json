      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0047",
      "chapter": 36,
      "start_offset": 3956,
      "end_offset": 3974,
      "text_exact": "“So is paralysis.”",
