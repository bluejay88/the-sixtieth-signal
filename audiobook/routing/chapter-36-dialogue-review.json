      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0045",
      "chapter": 36,
      "start_offset": 3882,
      "end_offset": 3932,
      "text_exact": "“Your show treats surrender like the only danger.”",
