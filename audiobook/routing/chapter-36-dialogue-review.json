{
  "schema_version": 1,
  "chapter": 36,
  "chapter_title": "THE RETURNERS",
  "chapter_sha256": "904795d9506d05e1166d5e1e5f0891c51c33f6357ef3cf2b49cbbf353b17d714",
  "policy": "No unresolved dialogue may fall back to narrator. render_allowed remains false until human approval.",
  "counts": {
    "dialogue_spans": 58,
    "explicit_named": 1,
    "unresolved": 57,
    "approved": 0
  },
  "spans": [
    {
      "dialogue_id": "ch36-d0001",
      "chapter": 36,
      "start_offset": 485,
      "end_offset": 509,
      "text_exact": "“You are the podcaster.”",
      "text_sha256": "0c827314293ae0641e09f28c528583bd1a60958520b6c074c88ca98786fd411e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0002",
      "chapter": 36,
      "start_offset": 511,
      "end_offset": 535,
      "text_exact": "“Depends who is asking.”",
      "text_sha256": "a5ae51c1ee6f64d2f0070b0986f6526c232e82172b42f5ce70ea1ead347014eb",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0003",
      "chapter": 36,
      "start_offset": 537,
      "end_offset": 609,
      "text_exact": "“Someone who has heard you answer every question with another question.”",
      "text_sha256": "78f52302adeb1fcc5f2865bf2ae4809c9d633d314abe188675b38e9f41ae4bf3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0004",
      "chapter": 36,
      "start_offset": 611,
      "end_offset": 634,
      "text_exact": "“Occupational disease.”",
      "text_sha256": "e4c15b5c87acb5abad714ebbb6713f039b16887e6642704c9dc9a5d72a0db773",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0005",
      "chapter": 36,
      "start_offset": 694,
      "end_offset": 749,
      "text_exact": "“If we wanted to convert you, we would use better tea.”",
      "text_sha256": "1b1e42e7c5b00d5b8e7751d716f732aff9b48db65018a314bbbacf5f2e22dd7e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0006",
      "chapter": 36,
      "start_offset": 787,
      "end_offset": 806,
      "text_exact": "“Why are you here?”",
      "text_sha256": "9f4fc7e14f09b7e47da9fbd3c4a07d8f0e79c2b51da1ac80a5052e9188daf3db",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0007",
      "chapter": 36,
      "start_offset": 808,
      "end_offset": 868,
      "text_exact": "“My hospital lost twenty-three children during the cascade.”",
      "text_sha256": "24ff9e9f22c9d14c33b6ef89e56397dce995787f2d48b328469edc4809154553",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0008",
      "chapter": 36,
      "start_offset": 893,
      "end_offset": 906,
      "text_exact": "“I am sorry.”",
      "text_sha256": "9ca6cc3bf4e2c25a2fcbe512729c72acaada756910c83dfc170cd380cc91b2d1",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0009",
      "chapter": 36,
      "start_offset": 908,
      "end_offset": 925,
      "text_exact": "“Do not do that.”",
      "text_sha256": "bebb3f4629e5abf27244d07437066e2b5dd7a38bd982befdceec42ce069032eb",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0010",
      "chapter": 36,
      "start_offset": 927,
      "end_offset": 934,
      "text_exact": "“What?”",
      "text_sha256": "bf9ee250242dc9be6ae8a64cb636db6ea70186d990757358b8947787279f47cc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0011",
      "chapter": 36,
      "start_offset": 936,
      "end_offset": 973,
      "text_exact": "“Turn me into the grief explanation.”",
      "text_sha256": "4300aaae32c10fa7eeca18c9ae3129e4a4b7bc9436773da692220141a18c3465",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0012",
      "chapter": 36,
      "start_offset": 1017,
      "end_offset": 1048,
      "text_exact": "“I was angry before they died.”",
      "text_sha256": "ac5bfa1a45e4c68ac58a11ac83fabe383dc32f30d6e3ae5d63a725ec55df0839",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0013",
      "chapter": 36,
      "start_offset": 1050,
      "end_offset": 1060,
      "text_exact": "“At what?”",
      "text_sha256": "0e40ea6dcab09f51bef37c363021568c74426af2846f928e0075ef4b299e09cd",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0014",
      "chapter": 36,
      "start_offset": 1062,
      "end_offset": 1148,
      "text_exact": "“At systems where nobody can make a decision quickly enough to be responsible for it.”",
      "text_sha256": "0a7101288e06ddfb02149e78849e713c75a47f08b71b4a9e6e24eef654893367",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0015",
      "chapter": 36,
      "start_offset": 1186,
      "end_offset": 1216,
      "text_exact": "“Your solution is Shaal-Amur.”",
      "text_sha256": "a2dc6f062eb48b1d9950cb447a65893a102bf02f85539fa28ab6ff72196e4726",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0016",
      "chapter": 36,
      "start_offset": 1218,
      "end_offset": 1261,
      "text_exact": "“My solution is competence with authority.”",
      "text_sha256": "31b99ec6e1c7d3276c381c9ced7143ba7380e0202305531e293906617137e667",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0017",
      "chapter": 36,
      "start_offset": 1263,
      "end_offset": 1285,
      "text_exact": "“Those are different.”",
      "text_sha256": "98050ec1df5761aaf4071ab0dfb5e6ff479f37d6f9b067ae16966c559fcb4ae4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0018",
      "chapter": 36,
      "start_offset": 1287,
      "end_offset": 1299,
      "text_exact": "“Sometimes.”",
      "text_sha256": "c5dd008dfc449574ddd4511a5a7f1b4a5beec39891133e0981133b17d9b744f7",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0019",
      "chapter": 36,
      "start_offset": 1381,
      "end_offset": 1403,
      "text_exact": "“Do you believe that?”",
      "text_sha256": "e6c56844ea2cf0445c8037ccc42652cfaa77ac3be448066bc2eee7a4cb947abf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0020",
      "chapter": 36,
      "start_offset": 1405,
      "end_offset": 1410,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0021",
      "chapter": 36,
      "start_offset": 1412,
      "end_offset": 1442,
      "text_exact": "“You're at the wrong protest.”",
      "text_sha256": "dc755988eed9719fcc11008540ae215a16ea0e254467a9dc5a6ab51880a12e53",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0022",
      "chapter": 36,
      "start_offset": 1444,
      "end_offset": 1481,
      "text_exact": "“I told them the wording was stupid.”",
      "text_sha256": "53f734ac9b433b664eef9fa21e0f140041cf136c050c33aac1b07def107c1863",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0023",
      "chapter": 36,
      "start_offset": 1483,
      "end_offset": 1494,
      "text_exact": "“Why stay?”",
      "text_sha256": "605d59af1079ccc319707a870b69c60f00f0eff8e5c06bcfdeb6d3325c9977c3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0024",
      "chapter": 36,
      "start_offset": 1496,
      "end_offset": 1577,
      "text_exact": "“Because the people under the stupid sign still have a question worth answering.”",
      "text_sha256": "dd5d6d122e7e97a95b9aefedf19ac898bd8dc05611324454ae76500e045a3874",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0025",
      "chapter": 36,
      "start_offset": 1816,
      "end_offset": 1828,
      "text_exact": "“Temporary,”",
      "text_sha256": "15b4875bf9134b5f51c30d39160563f9c0579be629c83c86690338fb240abb89",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0026",
      "chapter": 36,
      "start_offset": 1841,
      "end_offset": 1847,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0027",
      "chapter": 36,
      "start_offset": 1849,
      "end_offset": 1870,
      "text_exact": "“Who ends temporary?”",
      "text_sha256": "e8ca2f5d2ea402e90eb9f9d03220a244a3ca121ff5c76aa87fa8b8130e0673ae",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0028",
      "chapter": 36,
      "start_offset": 1872,
      "end_offset": 1913,
      "text_exact": "“That is the part nobody here agrees on.”",
      "text_sha256": "a2359f9d5d2de66b30c2d4222e66846af1d3d8cd727903aa4c9b7a546cc67aec",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0029",
      "chapter": 36,
      "start_offset": 2026,
      "end_offset": 2042,
      "text_exact": "“You hate them.”",
      "text_sha256": "c14e2b83037199163300236284d89c0243ce5262c5e366ae9351d06259ba7a08",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0030",
      "chapter": 36,
      "start_offset": 2044,
      "end_offset": 2094,
      "text_exact": "“I operate on six-year-olds. Hate is inefficient.”",
      "text_sha256": "494a786db69a7ab98bc7b6ddd593ffaf6b3d00dcbeb9467b02a152f1246ec6c3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0031",
      "chapter": 36,
      "start_offset": 2096,
      "end_offset": 2120,
      "text_exact": "“That sounds rehearsed.”",
      "text_sha256": "d7a36a435d46c8808b5542d65340943788c1834943131ded5a5bae8813e3cf22",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0032",
      "chapter": 36,
      "start_offset": 2122,
      "end_offset": 2153,
      "text_exact": "“It is. Reporters keep asking.”",
      "text_sha256": "75b97382a0409958740b325d347354f1c4a31a69692b5a590f4f17708e3b186f",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0033",
      "chapter": 36,
      "start_offset": 2363,
      "end_offset": 2453,
      "text_exact": "“You are asking the species that institutionalized resets to become our safety regulator.”",
      "text_sha256": "10df87ebb5c6ac6ccc65f825683cf3d2bf4a0b68ed312e1c4f9ee69870391bf5",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0034",
      "chapter": 36,
      "start_offset": 2455,
      "end_offset": 2471,
      "text_exact": "“They survived.”",
      "text_sha256": "b79ac06c0c2ba152bdec0703d38d9c9976b858a64a0003dee6a33fbd6d8a3f0a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0035",
      "chapter": 36,
      "start_offset": 2473,
      "end_offset": 2494,
      "text_exact": "“So did cockroaches.”",
      "text_sha256": "56ae1f84fd59f460994519efca1f350dca05f35b329eff9bb2cfbc6993970b5a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0036",
      "chapter": 36,
      "start_offset": 2519,
      "end_offset": 2552,
      "text_exact": "“That was better than your line.”",
      "text_sha256": "23c7c7e387d48e0c9b695401c7a5ac680905e66f1b1b7ff77a376ef4aea946dc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0037",
      "chapter": 36,
      "start_offset": 2554,
      "end_offset": 2577,
      "text_exact": "“I know. I am furious.”",
      "text_sha256": "c3ff9da5cddc5273b34642495625e0d0319abfa7fb0cb919058cc08b57dabb8b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0038",
      "chapter": 36,
      "start_offset": 2992,
      "end_offset": 3039,
      "text_exact": "“Democracy is a luxury of survivable mistakes.”",
      "text_sha256": "3499df2777c466b7f8747cdfb206ac2ec6ca12eaf870a794b37c20172cb9b2ea",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0039",
      "chapter": 36,
      "start_offset": 3070,
      "end_offset": 3091,
      "text_exact": "“So is dictatorship.”",
      "text_sha256": "faf75fb23ebdf65cae7c10ab91b7e07476a80641078223b6973d80d259548404",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0040",
      "chapter": 36,
      "start_offset": 3215,
      "end_offset": 3331,
      "text_exact": "“If the Iru-Shai are better at preventing extinction, why shouldn't they have more authority over extinction risks?”",
      "text_sha256": "87d725484a1f072c04f21ce26544ec86429f52a21ae394f05c0e9049afb794fe",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0041",
      "chapter": 36,
      "start_offset": 3348,
      "end_offset": 3459,
      "text_exact": "“More authority over a defined function is not the same as ownership of every decision touching that function.”",
      "text_sha256": "1722130054326680d89ea1fa911254023e3df1937e51be646dcbd56d98543803",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0042",
      "chapter": 36,
      "start_offset": 3461,
      "end_offset": 3489,
      "text_exact": "“That sounds like a lawyer.”",
      "text_sha256": "e235e3255d899376ae662a685507ca7b349ca741a2fc7674b0234d662b936516",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0043",
      "chapter": 36,
      "start_offset": 3491,
      "end_offset": 3503,
      "text_exact": "“It should.”",
      "text_sha256": "db7b7cabe0130fe55a3f3f03cbf70aee01987e697180836d5ad9cf7c24b32f33",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch36-d0044",
      "chapter": 36,
      "start_offset": 3532,
      "end_offset": 3593,
      "text_exact": "“Competence can justify a role. It does not justify a crown.”",
      "text_sha256": "ab7e2ddfef0868b4e6d301a98148df37a12843e18e09a7d76c066ae81e4bb97a",
      "speaker": null,
      "speaker_display": null,
