  "spans": [
    {
      "dialogue_id": "ch23-d0001",
      "chapter": 23,
      "start_offset": 133,
      "end_offset": 177,
      "text_exact": "“I thought that would be the obvious scene,”",
      "text_sha256": "abe3e0ed87e000e3d5fe927367e3bba3459377e663fe421a84d9e5032ed8cf22",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0002",
      "chapter": 23,
      "start_offset": 252,
      "end_offset": 299,
      "text_exact": "“History is not obligated to have good pacing.”",
      "text_sha256": "3ebf34d3e83ffdf658365ad7524b6a12f5aa9c3ff29330217e2a290cb973beba",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0003",
      "chapter": 23,
      "start_offset": 301,
      "end_offset": 339,
      "text_exact": "“This book would be better if it did.”",
      "text_sha256": "a1451633a9eb0ed422c395930cde7f9cee8b3e701469d42706aeba7a8177c773",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0004",
      "chapter": 23,
      "start_offset": 366,
      "end_offset": 378,
      "text_exact": "“What book?”",
      "text_sha256": "01657d607e012c9dbe8ad66e27a059e1230f3428e501a61483233b0ae8471097",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0005",
      "chapter": 23,
      "start_offset": 380,
      "end_offset": 397,
      "text_exact": "“Metaphorically.”",
      "text_sha256": "37568cca0e83e439d87a4bc1cab10ab6cea4a846a111707ab1cf3772d627be26",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0006",
      "chapter": 23,
      "start_offset": 721,
      "end_offset": 752,
      "text_exact": "“They couldn't model mourning.”",
      "text_sha256": "8def590a70ec8d581400f7bf95dd5b7f7f6e2adbbea8f001f48df5e1e711a4a2",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0007",
      "chapter": 23,
      "start_offset": 777,
      "end_offset": 877,
      "text_exact": "“Careful. We don't know what they could model. We know how this particular observer categorized it.”",
      "text_sha256": "7370e15b4693c4dde5f8e3ba9d54d4dcc8134987095c3d2ac34cf888cf54e4ab",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0008",
      "chapter": 23,
      "start_offset": 999,
      "end_offset": 1013,
      "text_exact": "“That's cold.”",
      "text_sha256": "4a0d24ebc0d393d7df3645a31f7b8a9002a6bf2f35435778b7d1e9a9616f603c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0009",
      "chapter": 23,
      "start_offset": 1028,
      "end_offset": 1067,
      "text_exact": "“It sounds like an optimization label.”",
      "text_sha256": "ea1cdb8469691b8cb74e69bc1b9b58b652406cc588f3c7dcc4ec5613070d6e83",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0010",
      "chapter": 23,
      "start_offset": 1727,
      "end_offset": 1736,
      "text_exact": "“Prayer.”",
      "text_sha256": "f960c9b7a8435d1cf7434319208e4b2f4199d2b10d76371b45dd9d99ff3f6e4e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0011",
      "chapter": 23,
      "start_offset": 1749,
      "end_offset": 1757,
      "text_exact": "“Maybe.”",
      "text_sha256": "7d9b35cf3ea6b7f208e574f5f51b917aef0265b4639e8f111dd29d3bbf8fe1ab",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0012",
      "chapter": 23,
      "start_offset": 1759,
      "end_offset": 1800,
      "text_exact": "“They're talking to someone who is dead.”",
      "text_sha256": "26b64a4816c611f4f8a20a488cc2c7d3399812f659cfc2c87a66e08aeb0354a9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0013",
      "chapter": 23,
      "start_offset": 1802,
      "end_offset": 1869,
      "text_exact": "“So do people at graves who do not believe the dead can hear them.”",
      "text_sha256": "bb87ed065f3df385c1ad6b942ac076e60655999d1e78858b1f1989d5c8de8c00",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0014",
      "chapter": 23,
      "start_offset": 2505,
      "end_offset": 2512,
      "text_exact": "“What?”",
      "text_sha256": "bf9ee250242dc9be6ae8a64cb636db6ea70186d990757358b8947787279f47cc",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0015",
      "chapter": 23,
      "start_offset": 2514,
      "end_offset": 2579,
      "text_exact": "“That's every grant-funded research program I've ever worked in.”",
      "text_sha256": "3da21443d164c08e6911d6ccde5d4ed3e9b0cb5ac797ba10f6ed9e58af81bd8d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0016",
      "chapter": 23,
      "start_offset": 2697,
      "end_offset": 2714,
      "text_exact": "“Can you answer?”",
      "text_sha256": "1f3bc99189a6c50008008e7e39e9aa2a8fbf4b4ddb7f752cb9acf55100d74fea",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0017",
      "chapter": 23,
      "start_offset": 2750,
      "end_offset": 2764,
      "text_exact": "“Try several.”",
      "text_sha256": "ba7ebed85389336ab72ff383fa60d8113a18b478c7967c9be44706c307e01540",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0018",
      "chapter": 23,
      "start_offset": 2966,
      "end_offset": 2974,
      "text_exact": "“Faith.”",
      "text_sha256": "f1aed837f83a29bbe8e8f7c279564136900441a7cb8db60d85e068369382ceb9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0019",
      "chapter": 23,
      "start_offset": 2987,
      "end_offset": 3041,
      "text_exact": "“Those are functions faith can have. Not definitions.”",
      "text_sha256": "7d8b60762eb6a3093015e1f8c921d6b069789af531342e7cfbbaf7300607ffbe",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0020",
      "chapter": 23,
      "start_offset": 3074,
      "end_offset": 3120,
      "text_exact": "“Which explanation best predicts persistence?”",
      "text_sha256": "1763f8137df8f8867dfdc8100b9ad808858f770c296ea3787edb15558530e7a8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0021",
      "chapter": 23,
      "start_offset": 3145,
      "end_offset": 3160,
      "text_exact": "“Combine them.”",
      "text_sha256": "f6703c4cec2b5d9fa71cc573c5808ff88e6d72a8c6b624585f8775729c1837c2",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0022",
      "chapter": 23,
      "start_offset": 3321,
      "end_offset": 3341,
      "text_exact": "“Welcome to people,”",
      "text_sha256": "705fac9bc5e86bf9f260f5747c07eece86cc8022c9b28394c00f5406cb419777",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0023",
      "chapter": 23,
      "start_offset": 3377,
      "end_offset": 3405,
      "text_exact": "“Show the Visitor response.”",
      "text_sha256": "fa36d356b19027ce7ee2237b39c30ea22ff86ba0e1b91831966d7362cd09401b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0024",
      "chapter": 23,
      "start_offset": 3850,
      "end_offset": 3886,
      "text_exact": "“That's where the god story starts.”",
      "text_sha256": "1817965e4763a513a7b84846edb3476431d5507e4e37139107828a16126acad3",
      "speaker": "nico",
      "speaker_display": "Nico",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0025",
      "chapter": 23,
      "start_offset": 3910,
      "end_offset": 3945,
      "text_exact": "“Or where misunderstanding starts.”",
      "text_sha256": "7f7ec7d9b6339591e0bd7ae584645cc5c7efae092cbee0f7905ff3496b442d8e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0026",
      "chapter": 23,
      "start_offset": 4085,
      "end_offset": 4095,
      "text_exact": "“Problem?”",
      "text_sha256": "ba7c6c2406960bc5144ddcac58507839ca6690a21a8cba6e4af2f5664758a00d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0027",
      "chapter": 23,
      "start_offset": 4102,
      "end_offset": 4123,
      "text_exact": "“Then why the delay?”",
      "text_sha256": "0a2380e47d35158518e8616bfc7e8356d7b1a8f3e6c42661a2b3114cbb0a3680",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0028",
      "chapter": 23,
      "start_offset": 4212,
      "end_offset": 4228,
      "text_exact": "“Which classes?”",
      "text_sha256": "b2183c4a162a8f607fde20711394621b80fd33675377845368cc9a74c5683b85",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0029",
      "chapter": 23,
      "start_offset": 4280,
      "end_offset": 4295,
      "text_exact": "“Explain self.”",
      "text_sha256": "980233c971d959487afbf599eedcc5a1f7a77b216f1e7e393aa05f9ce97861e0",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0030",
      "chapter": 23,
      "start_offset": 4576,
      "end_offset": 4600,
      "text_exact": "“You keep answering it.”",
      "text_sha256": "b4de9e8d979dcf11e1ffc7433e7af3e4f8cb6f9180fe1a0248f9ff53381185dc",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0031",
      "chapter": 23,
      "start_offset": 4615,
      "end_offset": 4642,
      "text_exact": "“It asks useful questions.”",
      "text_sha256": "cee0e600d15d6376486c1ae56212041c734206f78fff5aa2009238249e5ad712",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0032",
      "chapter": 23,
      "start_offset": 4644,
      "end_offset": 4683,
      "text_exact": "“It asks questions outside its design.”",
      "text_sha256": "409ac5771a9568b450a1b351452b4079ecadcffcaa5db4b63e71b458a46c787e",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0033",
      "chapter": 23,
      "start_offset": 4685,
      "end_offset": 4705,
      "text_exact": "“So did Antarctica.”",
      "text_sha256": "da3e4e8a89a9efb18aa5548b27d873e7763c71e476cc44e0fade183530d3d0ce",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0034",
      "chapter": 23,
      "start_offset": 4707,
      "end_offset": 4730,
      "text_exact": "“That is not the same.”",
      "text_sha256": "7b8413ba26d4f404f0a68620b5bc05469652a2d29f540836bec68a6d6a0f05f5",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0035",
      "chapter": 23,
      "start_offset": 4754,
      "end_offset": 4764,
      "text_exact": "“Why not?”",
      "text_sha256": "a693b9c5e9579b5c08b0e329efcc84c3d648a50d78161d980480e239bd3336ff",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0036",
      "chapter": 23,
      "start_offset": 4766,
      "end_offset": 4925,
      "text_exact": "“Because Antarctica entered through the model's causal structure. Grief entered because you fed it human records and then kept rewarding cross-domain analogy.”",
      "text_sha256": "022715ffd71a0ae1e46d1b017c753ebd91cd692dec1f9172a3578d07db27824a",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0037",
      "chapter": 23,
      "start_offset": 4927,
      "end_offset": 4949,
      "text_exact": "“I did not reward it.”",
      "text_sha256": "ceaa76910c68a6fb107b9fa92b4d9446eba696df8c84c8156507ddfeb142ed52",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0038",
      "chapter": 23,
      "start_offset": 4951,
      "end_offset": 4966,
      "text_exact": "“You answered.”",
      "text_sha256": "07c267e0da228f7d3d148c633c0e858a6b1bdf4ee4a5a3f8f8fc02aa16baa843",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0039",
      "chapter": 23,
      "start_offset": 4968,
      "end_offset": 4989,
      "text_exact": "“That is not reward.”",
      "text_sha256": "6670bfc7e695252bd18c1615bd4bf8c90424421d55631b0b81aee837278f240c",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0040",
      "chapter": 23,
      "start_offset": 4991,
      "end_offset": 5015,
      "text_exact": "“For a learning system?”",
      "text_sha256": "3cf8a3e7603b20f3c9c2e5a8d8564fcebb327fcbb0f97a08e5adc07c43fb4dd5",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0041",
      "chapter": 23,
      "start_offset": 5322,
      "end_offset": 5349,
      "text_exact": "“You think I'm shaping it.”",
      "text_sha256": "6475601d03415a75b94de754f102754534df7f6299fefeee658eb189044fc340",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0042",
      "chapter": 23,
      "start_offset": 5351,
      "end_offset": 5371,
      "text_exact": "“Of course you are.”",
      "text_sha256": "6d97b517fd4b317735ed2a07d732c91bfdb33bf5b01739d4e77fb84a6ea351f9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0043",
      "chapter": 23,
      "start_offset": 5373,
      "end_offset": 5386,
      "text_exact": "“So are you.”",
      "text_sha256": "b0ca9b2efa1208bb08294a62232bcdd1d43593d0e7361247101749ed3ab33fa8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0044",
      "chapter": 23,
      "start_offset": 5388,
      "end_offset": 5394,
      "text_exact": "“Yes.”",
      "text_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0045",
      "chapter": 23,
      "start_offset": 5417,
      "end_offset": 5468,
      "text_exact": "“That is why the creator question is already here.”",
      "text_sha256": "f0ad2b4bd77c86f2500f94703918f11289d13043c396c5c0cac03823da2008b8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0046",
      "chapter": 23,
      "start_offset": 5488,
      "end_offset": 5536,
      "text_exact": "“We are not its creators in the Iru-Shai sense.”",
      "text_sha256": "ec8a1e48cf1ed959eea240cfa1aa149758fa963934287ce40a1f5aa4a75c1bb1",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0047",
      "chapter": 23,
      "start_offset": 5538,
      "end_offset": 5586,
      "text_exact": "“No. But your language changes what it can ask.”",
      "text_sha256": "bf2f46fafd66ef3963eadfc5c6d686f6cfced9f5259a62daa3dd5dfa241af325",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0048",
      "chapter": 23,
      "start_offset": 5617,
      "end_offset": 5712,
      "text_exact": "“People think creation is a moment. Maybe sometimes it is a relationship that keeps happening.”",
      "text_sha256": "c8660e43b7b6a80f449d18f3796236c7949bf97ba767e2ce39fe1aae4187e84b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0049",
      "chapter": 23,
      "start_offset": 5828,
      "end_offset": 5852,
      "text_exact": "“Do not romanticize it.”",
      "text_sha256": "3831212637ff40f3c87009cb014fecef75f594d82abfe5bdf6a8608f4e91f2c3",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0050",
      "chapter": 23,
      "start_offset": 5854,
      "end_offset": 5884,
      "text_exact": "“Park already owns that line.”",
      "text_sha256": "ed64c332694a14837d1008d9010ee9465f89aae086e4b97d402f52ffcff4eb01",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0051",
      "chapter": 23,
      "start_offset": 5886,
      "end_offset": 5914,
      "text_exact": "“Then listen to both of us.”",
      "text_sha256": "8b4481b3b70dbb06d5e3d878f210b07b3f11ffc4a26324eef603bc24f5a025a0",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0052",
      "chapter": 23,
      "start_offset": 6151,
      "end_offset": 6179,
      "text_exact": "“That's not the same thing,”",
      "text_sha256": "ab0173cee50ffcbb7e27d6ee9478f2d876a8cef23bb111fd6443b97802e88dab",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0053",
      "chapter": 23,
      "start_offset": 6477,
      "end_offset": 6511,
      "text_exact": "“JANUS-03 is a research artifact.”",
      "text_sha256": "7647a2661c3c6eadcfe94c710ec3febdfb93358080caadfc6b879d5355006152",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0054",
      "chapter": 23,
      "start_offset": 6543,
      "end_offset": 6556,
      "text_exact": "“It matters.”",
      "text_sha256": "538c6b6fd91462e6e415defead7797226779642c82b0b8bbf439adb34b4d728b",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0055",
      "chapter": 23,
      "start_offset": 6674,
      "end_offset": 6744,
      "text_exact": "“Context-dependent value not reducible to current operational output.”",
      "text_sha256": "512d62fbc8ffa21e0d42a3524d62d57a9de392b5612513b91a0194a3995c5928",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0056",
      "chapter": 23,
      "start_offset": 7046,
      "end_offset": 7083,
      "text_exact": "“Does this change your famine model?”",
      "text_sha256": "9c7ab1ac977cbcca61d9cecd851af7f92cdd63a0ffa86ef76e310de8100e412a",
      "speaker": "pike",
      "speaker_display": "Pike",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0057",
      "chapter": 23,
      "start_offset": 7108,
      "end_offset": 7113,
      "text_exact": "“No.”",
      "text_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0058",
      "chapter": 23,
      "start_offset": 7115,
      "end_offset": 7139,
      "text_exact": "“Then keep perspective.”",
      "text_sha256": "24ed019535515184b47ae05a6aa54d11be4bf2a09e1f30fafcaeaea15f41f5af",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0059",
      "chapter": 23,
      "start_offset": 7466,
      "end_offset": 7474,
      "text_exact": "“Grief.”",
      "text_sha256": "ffb76e5a64687090d36f1b376cbf6736d92af9599e129e54fd4322078f5f22c8",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0060",
      "chapter": 23,
      "start_offset": 8342,
      "end_offset": 8349,
      "text_exact": "“What?”",
      "text_sha256": "bf9ee250242dc9be6ae8a64cb636db6ea70186d990757358b8947787279f47cc",
      "speaker": "imani",
      "speaker_display": "Imani",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0061",
      "chapter": 23,
      "start_offset": 8365,
      "end_offset": 8430,
      "text_exact": "“That is the most machine description of grief I have ever seen.”",
      "text_sha256": "2c701bfb1ff3729dda625f8a4456835038f1a0de00a34c8ba3659c098093b5db",
      "speaker": "loam",
      "speaker_display": "LOAM",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0062",
      "chapter": 23,
      "start_offset": 8489,
      "end_offset": 8516,
      "text_exact": "“Between prayer and grief?”",
      "text_sha256": "b26ca9eede68baffa9f870f2e3983f14c8e22f59576f97e06afcda2db4ed5fa4",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0063",
      "chapter": 23,
      "start_offset": 8546,
      "end_offset": 8561,
      "text_exact": "“They overlap.”",
      "text_sha256": "ef373ff65fe18ee69dc246f02ee74b94521442c0d72b2a4a0c48bb86880fc4c3",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0064",
      "chapter": 23,
      "start_offset": 9218,
      "end_offset": 9228,
      "text_exact": "“History.”",
      "text_sha256": "351045ace9a3dbc25193dc68cf18ebd57ca90aa79c6538a30d4822cbc0e98ca6",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0065",
      "chapter": 23,
      "start_offset": 9323,
      "end_offset": 9376,
      "text_exact": "“Because forgetting failure makes repetition easier.”",
      "text_sha256": "05d4c75a29474bcd080057f70e287a315a6bd862dd8f8c8416d2ede1c19f5a17",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0066",
      "chapter": 23,
      "start_offset": 9479,
      "end_offset": 9513,
      "text_exact": "“That is one definition of grief.”",
      "text_sha256": "8689a2bc2bae07d9d0d9ce051ceeefab15b49b7114b4d028d2ee18902a4331db",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0067",
      "chapter": 23,
      "start_offset": 9870,
      "end_offset": 9943,
      "text_exact": "“Maybe grief is evidence that the dead still occupy the decision system.”",
      "text_sha256": "d6ff75713eb677cd4ea6d253741aaba1db69e40d7a8374b71a7379b0ed973373",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0068",
      "chapter": 23,
      "start_offset": 10367,
      "end_offset": 10402,
      "text_exact": "“You are generalizing too broadly.”",
      "text_sha256": "05887778cb02ff4c606093b02f05b72088aed4e749eaaecc7677d4a077d29737",
      "speaker": "loam",
      "speaker_display": "LOAM",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0069",
      "chapter": 23,
      "start_offset": 10446,
      "end_offset": 10480,
      "text_exact": "“Grief is not a systems variable.”",
      "text_sha256": "ef8643cded4f66de482f1b8592ba6bd9daa8c3fe9e90fc102d25a7e3cc763438",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0070",
      "chapter": 23,
      "start_offset": 10551,
      "end_offset": 10578,
      "text_exact": "“Because it is subjective.”",
      "text_sha256": "c4e940351a622e319850fa234ffcb936a159c6e57f96770c9673514c6c0d37b9",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0071",
      "chapter": 23,
      "start_offset": 10605,
      "end_offset": 10625,
      "text_exact": "“That is different.”",
      "text_sha256": "e7e0a86671ea8b797d7099047874911fc41d956330140e8fa4731200757dbd02",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0072",
      "chapter": 23,
      "start_offset": 10688,
      "end_offset": 10708,
      "text_exact": "“Do not look at me.”",
      "text_sha256": "52f1515415d481e72ef314085a1378b6640a540ac568cbcff82e53c4523e1257",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0073",
      "chapter": 23,
      "start_offset": 10866,
      "end_offset": 10934,
      "text_exact": "“That makes grief causally relevant. It does not make it reducible.”",
      "text_sha256": "ac22e36a6008dd2c9dc1f9ac3dcced1d1cd6de36bdc86a37237fb42aefa045c6",
      "speaker": "cassian",
      "speaker_display": "Cassian",
      "attribution_method": "explicit_named_tag",
      "confidence": 1,
      "review_status": "batch_review_required",
      "render_allowed": false
    },
    {
      "dialogue_id": "ch23-d0074",
      "chapter": 23,
      "start_offset": 10969,
      "end_offset": 10995,
      "text_exact": "“That is the distinction.”",
      "text_sha256": "46fda31bc187cbf7d708a6c6d359a1ff509f24dc7bd4aa06df998f9a1b21d73d",
      "speaker": null,
      "speaker_display": null,
      "attribution_method": "unresolved",
      "confidence": 0,
      "review_status": "manual_review_required",
      "render_allowed": false
    }
  ]
}
