{
  "schema_version": 1,
  "chapter": 23,
  "chapter_title": "THE SPECIES THAT PRAYED FOR DATA",
  "chapter_sha256": "b3bda3a3cfe0feac9380866299a081e491006684b9304209c4aea9686b815ed4",
  "policy": "No unresolved dialogue may fall back to narrator. render_allowed remains false until human approval.",
